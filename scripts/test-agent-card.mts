import assert from 'node:assert/strict';
import fs from 'node:fs';
import vm from 'node:vm';
import {createRequire} from 'node:module';
import ts from 'typescript';
import * as model from '../src/components/toolbox/tools/agentCardModel.ts';
import {activeTools,getRelatedTools,getTryNextTools} from '../src/data/tools.ts';
const base=()=>model.agentCardPreset('Minimal Public Agent'),review=model.reviewAgentCard;
let count=0;
const test=(name:string,run:()=>void)=>{try{run();count++;}catch(e){throw new Error(name,{cause:e});}};
const fails=(card:unknown,path?:string)=>{const r=review(card);assert.ok(r.blocked);if(path)assert.ok(r.findings.some(f=>f.severity==='FAIL'&&f.path.startsWith(path)));return r;};
const warns=(card:unknown,pattern:RegExp)=>{const r=review(card);assert.ok(r.findings.some(f=>f.severity==='WARN'&&pattern.test(f.issue)));return r;};
test('Pinned current schema and wire version',()=>{assert.equal(model.agentCardMetadata.release,'1.0.1');assert.equal(model.agentCardMetadata.protocolVersion,'1.0');assert.ok(model.agentCardMetadata.sources[0].url.includes('/v1.0.1/'));});
test('Minimal unsigned public card',()=>{const r=review(base());assert.ok(!r.blocked);assert.equal(r.signing,'Unsigned — allowed');assert.equal(r.requiredSecurity,'Public access possible');assert.ok(!Object.hasOwn(JSON.parse(r.json),'signatures'));});
test('All current presets are valid and deterministic',()=>{for(const name of model.agentCardPresets.filter(n=>n!=='Legacy Agent Card')){const c=model.agentCardPreset(name);assert.ok(!review(c).blocked,name);assert.equal(review(c).json,review(c).json);assert.ok(c.supportedInterfaces.length);}});
for(const key of ['name','description','version','capabilities','defaultInputModes','defaultOutputModes','skills','supportedInterfaces'])test(`Required ${key}`,()=>{const c=base();delete c[key];fails(c,`$.${key}`);});
test('No interfaces',()=>fails({...base(),supportedInterfaces:[]},'$.supportedInterfaces'));
test('Interface order controls preference',()=>{const c=model.agentCardPreset('Multi-Interface Agent');c.supportedInterfaces=model.moveItem(c.supportedInterfaces,2,-1);c.supportedInterfaces=model.moveItem(c.supportedInterfaces,1,-1);assert.equal(review(c).preferred,'HTTP+JSON · 1.0');assert.deepEqual(JSON.parse(review(c).json).supportedInterfaces,c.supportedInterfaces);});
test('Duplicate interface blocked',()=>{const c=base();c.supportedInterfaces.push({...c.supportedInterfaces[0]});fails(c);});
for(const binding of model.agentCardMetadata.bindings)test(`Core binding ${binding}`,()=>{const c=base();c.supportedInterfaces[0].protocolBinding=binding;c.supportedInterfaces[0].url=binding==='GRPC'?'grpc.example.com:443':'https://example.com/a2a';assert.ok(!review(c).blocked);});
test('Custom URI binding accepted',()=>{const c=base();c.supportedInterfaces[0].protocolBinding='urn:example:binding';assert.ok(!review(c).blocked);});
test('Invalid gRPC port blocked',()=>{const c=base();c.supportedInterfaces[0]={url:'grpc.example.com:99999',protocolBinding:'GRPC',protocolVersion:'1.0'};fails(c);});
test('Binding spelling and insecure/relative HTTP URL',()=>{for(const binding of ['jsonrpc','REST']){const c=base();c.supportedInterfaces[0].protocolBinding=binding;fails(c);}for(const url of ['/a2a','http://example.com/a2a']){const c=base();c.supportedInterfaces[0].url=url;fails(c);}});
test('Missing per-interface protocol version',()=>{const c=base();c.supportedInterfaces[0].protocolVersion='';fails(c);});
test('Patch protocol version is advisory, not impossible',()=>{const c=base();c.supportedInterfaces[0].protocolVersion='1.0.1';assert.ok(!warns(c,/Major.Minor/).blocked);});
test('Opaque tenant stays unchanged',()=>{const c=base();c.supportedInterfaces[0].tenant='partner-north';assert.equal(JSON.parse(review(c).json).supportedInterfaces[0].tenant,'partner-north');});
test('Capabilities booleans',()=>{for(const key of ['streaming','pushNotifications','extendedAgentCard']){const c=base();c.capabilities[key]=true;assert.ok(!review(c).blocked);c.capabilities[key]='yes';fails(c);}});
test('Extensions and required compatibility warning',()=>{const c=base();c.capabilities.extensions=[{uri:'urn:example:extension',required:true,params:{format:'compact'}}];assert.ok(!warns(c,/Required extension/).blocked);c.capabilities.extensions[0].params=[];fails(c);});
test('Invalid extension URI and types',()=>{for(const ext of [{uri:'relative'},{required:'yes'},{description:42}]){const c=base();c.capabilities.extensions=[ext];fails(c);}});
test('Custom MIME modes',()=>{const c=base();c.defaultInputModes=['application/vnd.example+json'];c.defaultOutputModes=['image/png','audio/mpeg'];assert.ok(!review(c).blocked);});
test('Empty and malformed MIME modes',()=>{fails({...base(),defaultInputModes:[]});fails({...base(),defaultOutputModes:['json']});});
test('Provider must be complete',()=>{fails({...base(),provider:{organization:'Example'}});assert.ok(!review({...base(),provider:{organization:'Example',url:'https://example.com'}}).blocked);});
test('Optional icon is metadata, not a remote request',()=>{const c=base();c.iconUrl='https://example.com/icon.png';assert.ok(!review(c).blocked);assert.equal(JSON.parse(review(c).json).iconUrl,c.iconUrl);});
test('Skill IDs unique without invented casing rule',()=>{const c=base();c.skills[0].id='Mixed-Case.Skill';assert.ok(!review(c).blocked);c.skills.push({...c.skills[0]});fails(c);});
test('Skill required fields and tags',()=>{for(const key of ['id','name','description','tags']){const c=base();delete c.skills[0][key];fails(c);}const c=base();c.skills[0].tags=[];fails(c);});
test('Skill modes and examples override defaults',()=>{const c=base();c.skills[0].inputModes=['application/json'];c.skills[0].outputModes=['text/plain'];c.skills[0].examples=['Compare public specifications.'];assert.ok(!review(c).blocked);assert.deepEqual(JSON.parse(review(c).json).skills[0].inputModes,['application/json']);});
test('Vague and overlapping skills are heuristic warnings',()=>{const c=base();c.skills[0].description='Does everything';c.skills.push({...c.skills[0],id:'other'});assert.ok(!warns(c,/scope is vague/).blocked);warns(c,/overlapping/);});
for(const kind of model.agentCardMetadata.schemes)test(`Wrapped ${kind}`,()=>{const c=base();c.securitySchemes={auth:model.newSecurityScheme(kind)};c.securityRequirements=[{schemes:{auth:{list:[]}}}];assert.ok(!review(c).blocked,JSON.stringify(review(c).findings));});
test('OpenAPI type and multiple variants blocked',()=>{fails({...base(),securitySchemes:{auth:{type:'http',scheme:'bearer'}}});fails({...base(),securitySchemes:{auth:{...model.newSecurityScheme('httpAuthSecurityScheme'),...model.newSecurityScheme('mtlsSecurityScheme')}}});});
test('Unknown security reference',()=>fails({...base(),securityRequirements:[{schemes:{missing:{list:[]}}}]}));
test('Modern StringList required, bare arrays rejected',()=>{const c=base();c.securitySchemes={auth:model.newSecurityScheme('httpAuthSecurityScheme')};for(const requirements of [[{auth:[]}],[{schemes:{auth:[]}}]])fails({...c,securityRequirements:requirements});});
test('OR alternatives and AND groups retained',()=>{const c=base();c.securitySchemes={a:model.newSecurityScheme('httpAuthSecurityScheme'),b:model.newSecurityScheme('mtlsSecurityScheme')};c.securityRequirements=[{schemes:{a:{list:[]},b:{list:[]}}},{schemes:{b:{list:[]}}}];assert.ok(!review(c).blocked);assert.deepEqual(JSON.parse(review(c).json).securityRequirements,c.securityRequirements);});
test('Non-OAuth scopes blocked',()=>{const c=base();c.securitySchemes={auth:model.newSecurityScheme('httpAuthSecurityScheme')};c.securityRequirements=[{schemes:{auth:{list:['read']}}}];fails(c);});
test('Skill security references validated',()=>{const c=base();c.skills[0].securityRequirements=[{schemes:{missing:{list:[]}}}];fails(c);});
for(const flowKind of model.agentCardMetadata.flows)test(`OAuth ${flowKind} exact structure`,()=>{const c=base();c.securitySchemes={oauth:{oauth2SecurityScheme:{flows:{[flowKind]:model.newOAuthFlow(flowKind)}}}};const r=review(c);assert.ok(!r.blocked);if(['implicit','password'].includes(flowKind))warns(c,/Deprecated/);});
test('OAuthFlows is a oneof',()=>fails({...base(),securitySchemes:{oauth:{oauth2SecurityScheme:{flows:{authorizationCode:model.newOAuthFlow('authorizationCode'),clientCredentials:model.newOAuthFlow('clientCredentials')}}}}}));
test('Required OAuth endpoints and scope types',()=>{const c=base();c.securitySchemes={oauth:{oauth2SecurityScheme:{flows:{deviceCode:{tokenUrl:'https://example.com/token',scopes:{read:'Read'}}}}}};fails(c);c.securitySchemes.oauth.oauth2SecurityScheme.flows={clientCredentials:{tokenUrl:'https://example.com/token',scopes:['read']}};fails(c);});
test('Undeclared OAuth scope warning',()=>{const c=model.agentCardPreset('Enterprise Support Agent');c.securityRequirements![0].schemes.supportOAuth.list=['not-declared'];assert.ok(!warns(c,/not declared/).blocked);});
test('Missing API key location and name',()=>fails({...base(),securitySchemes:{key:{apiKeySecurityScheme:{location:'body'}}}}));
test('Query API key exposure warning',()=>warns({...base(),securitySchemes:{key:{apiKeySecurityScheme:{location:'query',name:'key'}}}},/Query credentials/));
test('Unauthenticated sensitive work warns',()=>assert.ok(review(base(),true).findings.some(f=>f.severity==='WARN'&&f.issue.includes('Sensitive'))));
test('Extended card requires auth guidance',()=>warns({...base(),capabilities:{extendedAgentCard:true}},/Extended card/));
test('Anonymous alternative prevents all-skills auth claim',()=>{const c=model.agentCardPreset('Enterprise Support Agent');c.securityRequirements!.push({schemes:{}});c.skills[0].securityRequirements=undefined;assert.equal(review(c).requiredSecurity,'Public access possible');});
test('Signing plan stays outside card and makes no fake signature',()=>{const c=base(),plan={algorithm:'ES256',keyId:'Versioned public key IDs',publicKeys:'Publish a trusted HTTPS JWKS',rotation:true};assert.match(model.signingPlanText(plan),/no signature generated/);assert.ok(!review(c).json.includes('signatures'));assert.match(model.signingPlanText(plan),/RFC 8785/);});
test('Existing signatures remain unverified',()=>{const c=base();c.signatures=[{protected:'eyJhbGciOiJFUzI1NiIsImtpZCI6InRlc3QifQ',signature:'dGVzdA'}];assert.ok(!warns(c,/unverified/).blocked);assert.deepEqual(JSON.parse(review(c).json).signatures,c.signatures);});
test('Malformed signatures blocked',()=>fails({...base(),signatures:[{signature:'not base64!'}]}));
test('Protected JWS header is JSON with alg and kid',()=>{for(const header of [{alg:'none',kid:'public-key'},{alg:'ES256'},{kid:'key'}])fails({...base(),signatures:[{protected:Buffer.from(JSON.stringify(header)).toString('base64url'),signature:'dGVzdA'}]});});
test('Discovery current path, HTTPS apex or subdomain origin',()=>{assert.equal(model.discoveryUrl('agent.example.com').url,'https://agent.example.com/.well-known/agent-card.json');assert.equal(model.discoveryUrl('https://example.com/').url,'https://example.com/.well-known/agent-card.json');for(const domain of ['http://example.com','https://example.com/path','https://example.com/?x=y','https://example.com/#private'])assert.ok(model.discoveryUrl(domain).error);});
test('Legacy format identified without destructive migration',()=>{const r=review(model.legacyAgentCard);assert.ok(r.legacy&&r.blocked);assert.deepEqual(JSON.parse(r.json),model.legacyAgentCard);});
test('Older discovery path reference warned in a current card',()=>{warns({...base(),documentationUrl:'https://example.com/.well-known/agent.json'},/Older discovery/);});
test('Unknown root and nested fields preserved',()=>{const c=base();c.futureField={nested:['keep']};c.skills[0].vendorData={value:'keep'};c.supportedInterfaces[0].futureFlag=true;const r=review(c);assert.ok(!r.blocked);assert.deepEqual(JSON.parse(r.json),c);assert.ok(r.findings.filter(f=>f.issue==='Unrecognized field preserved').length===3);});
test('Valid and invalid JSON import',()=>{const c=base();assert.deepEqual(model.parseAgentCard(JSON.stringify(c)).card,c);assert.ok(model.parseAgentCard('{broken}').error);fails(model.parseAgentCard('[]').card);});
test('Bounded JSON and unsafe keys',()=>{assert.ok(model.parseAgentCard(' '.repeat(120001)).error);assert.ok(model.parseAgentCard('{"__proto__":{"unsafe":true}}').error);assert.ok(model.parseAgentCard(JSON.stringify({x:Array(33).fill('x')})).error);assert.ok(model.parseAgentCard(JSON.stringify({x:'x'.repeat(8001)})).error);});
test('Credential detection redacts and blocks without echoing evidence',()=>{
  const samples=['Bearer '+'a'.repeat(30),'ghp_'+'b'.repeat(30),'sk-'+'c'.repeat(30),'-----BEGIN PRIVATE KEY-----\nprivate\n-----END PRIVATE KEY-----','https://person:password@example.com/a2a','https://example.com/?access_token='+'d'.repeat(25),'eyJ'+'a'.repeat(15)+'.'+'b'.repeat(15)+'.'+'c'.repeat(15)];
  for(const secret of samples){const c=base();c.description=secret;const r=fails(c);assert.ok(!r.json.includes(secret));assert.ok(!JSON.stringify(r.findings).includes(secret));}
  const c=base();c.extra={client_secret:'not-a-real-secret'};assert.ok(!fails(c).json.includes('not-a-real-secret'));
});
test('Credential-like property name redacted',()=>{const c=base(),secret='ghp_'+'b'.repeat(30);c[secret]='hidden';const r=fails(c);assert.ok(!r.json.includes(secret));assert.ok(!JSON.stringify(r.findings).includes(secret));});
test('Explicit token and secret values blocked',()=>{for(const key of ['token','secret','apiKey','password']){const r=fails({...base(),vendor:{[key]:'synthetic-sensitive-value'}});assert.ok(!r.json.includes('synthetic-sensitive-value'));}});
test('Normal metadata does not trigger secret detection',()=>{for(const value of ['Bearer','JWT','X-API-Key','support.read','urn:example:binding','Public password reset documentation'])assert.ok(!model.sensitiveText(value));});
test('Deterministic pretty JSON with no undefined or comment fields',()=>{const r=review(base());assert.equal(r.json,JSON.stringify(JSON.parse(r.json),null,2));assert.ok(!r.json.includes('undefined'));for(const key of ['url','protocolVersion','preferredTransport','additionalInterfaces'])assert.ok(!Object.hasOwn(JSON.parse(r.json),key));});
test('The #86 tool remains in canonical discovery',()=>{const tool=activeTools.find(t=>t.slug==='a2a-agent-card-builder')!;assert.ok(tool&&tool.family==='create'&&tool.privacySensitive);for(const related of [...getRelatedTools(tool),...getTryNextTools(tool)])assert.ok(activeTools.some(t=>t.id===related.id));assert.ok(activeTools.length>=86);assert.ok(activeTools.filter(t=>t.family==='create').length>=17);});

