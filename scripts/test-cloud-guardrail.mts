import assert from 'node:assert/strict';import {buildCloudGuardrails as run,cloudDefault as d,costCategories,cloudEnvironments} from '../src/components/toolbox/tools/cloudGuardrailModel.ts';
const base={...d,owner:'Platform'};assert.throws(()=>run(d));const r=run({...base,baseline:900});assert.equal(r.derived.warning,800);assert.equal(r.derived.anomalyReviewAmount,1125);assert.deepEqual(r.ladder.map(x=>x.threshold),[800,1000,1200,1500]);assert.equal(run(base).derived.anomalyReviewAmount,null);
assert.ok(run({...base,commitment:'consider',traffic:'bursty'}).commitment.includes('Avoid'));assert.ok(run({...base,commitment:'consider'}).commitment.includes('measured'));assert.ok(r.environments.find(x=>x.name==='Production')!.controls[0].includes('never shut down'));assert.equal(run({...base,categories:[...costCategories],environments:[...cloudEnvironments]}).categories.length,10);
for(const invalid of [{target:0},{warningPercent:100},{critical:500},{ceiling:1100},{baseline:-1},{productionHours:25},{categories:[]},{environments:['Unknown']},{anomalyPercent:NaN},{owner:'x'.repeat(121)}])assert.throws(()=>run({...base,...invalid}));
const unsafe=run({...base,owner:'<script> example: [data]'});assert.equal(JSON.parse(JSON.stringify(unsafe)).owner,unsafe.owner);console.log('Cloud guardrail checks passed: thresholds, baseline, commitments, availability, category controls and bounded safe JSON.');
