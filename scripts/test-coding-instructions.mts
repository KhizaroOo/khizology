import assert from 'node:assert/strict';
import fs from 'node:fs';
import {buildProjectInstructions as build,instructionDefaults as defaults,instructionPreset as preset,instructionPresetNames,instructionFormats} from '../src/components/toolbox/tools/codingInstructionsModel.ts';
import {activeTools,getRelatedTools,getTryNextTools} from '../src/data/tools.ts';
for(const name of instructionPresetNames){const c=preset(name),snapshot=JSON.stringify(c),r=build(c);assert.deepEqual(r,build(c));assert.equal(snapshot,JSON.stringify(c));assert.equal(r.files.length,3);for(const f of r.files){assert.equal(f.filename,instructionFormats[f.format].filename);assert.equal(f.tokens,Math.ceil(f.content.length/4));assert.ok(!f.content.includes('## \n'));for(const s of r.sections)assert.ok(f.content.includes(s.title));}const bodies=r.files.map(f=>f.content.split('\n\n## ').slice(1).sort());assert.deepEqual(bodies[0],bodies[1]);assert.deepEqual(bodies[0],bodies[2]);}
const browser=build(preset('Browser-Only Web Tool'));assert.ok(browser.sections.some(s=>s.id==='seo'));assert.ok(!browser.sections.some(s=>s.id==='data'));assert.ok(browser.files[0].content.includes('client-side'));
const api=defaults();api.choices.projectType='API';api.choices.language='C#';api.choices.backend='ASP.NET Core';api.choices.manager='NuGet';api.commands.build='dotnet build';api.rules.seo=['Sitemap'];const ar=build(api);assert.ok(ar.sections.some(s=>s.id==='data'));assert.ok(!ar.sections.some(s=>['seo','ux'].includes(s.id)));assert.ok(ar.files[0].content.includes('dotnet build'));
const cli=defaults();cli.choices.projectType='CLI';cli.choices.language='Python';cli.choices.manager='pip';assert.ok(!build(cli).sections.some(s=>['seo','ux','data'].includes(s.id)));
assert.ok(build(preset('Monorepo')).files[0].content.includes('package ownership'));
assert.ok(build(preset('Rapid Prototype')).files[0].content.includes('does not remove safety'));
assert.ok(build(preset('High-Autonomy Agent')).files[0].content.includes('proceed independently'));
assert.ok(build(preset('Token-Efficient Coding')).files[0].content.includes('Focused file reads'));
const empty=build(defaults());assert.ok(!empty.sections.some(s=>s.id==='commands'));assert.ok(!empty.files[0].content.includes('npm run')&&!empty.files[0].content.includes('npm test'));assert.ok(empty.files[0].content.includes('Not configured'));
const conflict=defaults();conflict.paths.generated='dist';conflict.paths.truth='dist/data.ts';conflict.custom='Commit after every task\nInstall dependencies automatically';assert.ok(build(conflict).warnings.some(s=>s.includes('protected generated')));assert.ok(build(conflict).warnings.some(s=>s.includes('commit policy')));assert.ok(build(conflict).warnings.some(s=>s.includes('dependency policy')));
const custom=defaults();custom.custom='  PRIVATE_SENTINEL <script>never execute</script>\nline\nline\n';const r=build(custom);for(const f of r.files)assert.ok(f.content.includes(custom.custom));assert.ok(r.warnings.some(w=>w.includes('repeated')));
assert.throws(()=>build({...defaults(),custom:'x'.repeat(8001)}));assert.throws(()=>build({...defaults(),formats:[]}));assert.throws(()=>build({...defaults(),name:'bad\nname'}));
const selected=defaults();selected.rules.preserve=['API contracts'];selected.rules.performance=[];selected.rules.efficiency=[];selected.rules.docs=[];assert.ok(build(selected).sections.find(s=>s.id==='change')!.lines.some(l=>l==='Preserve selected contracts: API contracts.'));assert.ok(!build(selected).sections.some(s=>s.id==='performance'));
for(const file of ['codingInstructionsModel.ts','CodingAgentInstructionsBuilder.tsx']){const s=fs.readFileSync('src/components/toolbox/tools/'+file,'utf8');assert.ok(!/\bfetch\s*\(|localStorage|sessionStorage|sendBeacon|console\.|\beval\s*\(|new Function|URLSearchParams|dangerouslySetInnerHTML/.test(s));}
const t=activeTools.find(t=>t.id==='coding-agent-instructions-builder')!;assert.ok(t&&t.family==='create'&&getRelatedTools(t).length&&getTryNextTools(t).length);for(const id of [...t.relatedToolIds!,...t.nextToolIds!])assert.ok(activeTools.some(t=>t.id===id));assert.equal(new Set(activeTools.map(t=>t.slug)).size,activeTools.length);
console.log(`Instructions PASS: seven presets × three consistent formats, exact filenames, conditional web/backend/UI, no invented commands, conflicts, custom text, length and privacy. ${activeTools.length} active; ${activeTools.filter(t=>t.family==='create').length} Create.`);
