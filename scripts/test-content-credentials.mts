import assert from 'node:assert/strict';
import fs from 'node:fs';
import vm from 'node:vm';
import {createRequire} from 'node:module';
import ts from 'typescript';
import * as m from '../src/components/toolbox/tools/contentCredentialsModel.ts';
import {activeTools,getRelatedTools,getTryNextTools} from '../src/data/tools.ts';
let n=0;const test=(name:string,fn:()=>void)=>{try{fn();n++;}catch(e){throw new Error(name,{cause:e});}};
const base=()=>m.credentialPreset(),run=m.diagnoseCredentials;
const has=(p:m.CredentialPlan,re:RegExp)=>assert.ok(run(p).findings.some(f=>re.test(f.why+' '+f.action)),String(re));
test('simple capture complete plan, not observed validation',()=>{const r=run(base());assert.equal(r.status,'PLAN COMPLETE — TEST NEXT');assert.ok(r.observation.includes('Not tested'));assert.ok(r.scorecard.every(s=>s.status==='PASS'));assert.equal(r.pipeline.length,7);});
test('exact first stripping stage',()=>{const p=base();p.stages[1].transform='strip';p.stages[1].name='CMS thumbnail';const r=run(p);assert.equal(r.firstBreak,'CMS thumbnail');assert.equal(r.status,'NOT READY');assert.equal(r.pipeline[3].status,'WARN');});
test('AI without disclosure',()=>{const p=m.credentialPreset('AI Image → Human Edit → Social');p.disclosure='no';has(p,/lacks a clear disclosure/);});
test('source type improves AI planning',()=>{const p=m.credentialPreset('AI Image → Human Edit → Social');p.sourceType='';const before=run(p).findings.length;p.sourceType='trainedAlgorithmicMedia';assert.ok(run(p).findings.length<before);});
test('localized AI',()=>{const p=base();p.aiUse='modified';p.roi='region';p.sourceType='compositeWithTrainedAlgorithmicMedia';has(p,/Only part/);p.localized='yes';assert.ok(!run(p).findings.some(f=>f.why.includes('Only part')));});
test('whole asset AI',()=>{const p=base();p.origin='generated';p.aiUse='generated';p.sourceType='trainedAlgorithmicMedia';p.model='yes';assert.equal(run(p).aiLabel,'AI-generated');assert.ok(!run(p).findings.some(f=>f.why.includes('do not align')));});
test('non-generative enhancement distinct',()=>{const p=base();p.aiUse='modified';p.sourceType='algorithmicallyEnhanced';assert.ok(!run(p).findings.some(f=>f.why.includes('do not align')));});
test('sensitive prompt',()=>{const p=base();p.prompt='full';p.promptSensitive='yes';has(p,/confidential input/);p.prompt='omit';assert.ok(!run(p).findings.some(f=>f.why.includes('full prompt')));});
test('ingredient unknown is not automatic invalidity',()=>{const p=base();p.ingredients=[{name:'Prompt input',relationship:'inputTo',provenance:'no',preserved:'unknown'}];has(p,/not proof of deception/);assert.ok(!run(p).findings.some(f=>f.status==='FAIL'));});
test('known source lost',()=>{const p=base();p.ingredients=[{name:'Original',relationship:'parentOf',provenance:'yes',preserved:'no'}];has(p,/Known ingredient/);});
test('multiple ingredients',()=>{const p=m.credentialPreset('Composed Marketing Asset'),r=run(p);assert.equal(r.plan.ingredients.length,3);assert.ok(r.report.includes('Source photograph → componentOf'));assert.ok(r.report.includes('Reference image → inputTo'));});
test('edit without new provenance',()=>{const p=base();p.stages[0].newManifest='no';assert.equal(run(p).firstBreak,p.stages[0].name);has(p,/old signature/);});
test('complete history',()=>assert.ok(!run(base()).findings.some(f=>f.dimension==='Action history')));
test('partial history honest guidance',()=>{const p=base();p.allActions='partial';has(p,/allActionsIncluded=false/);});
test('unknown transformation contradicts complete history',()=>{const p=base();p.stages[1].transform='unknown';has(p,/Full action history is claimed/);assert.equal(run(p).pipeline[2].status,'UNKNOWN');});
for(const transform of ['resize','transcode','convert'] as const)test(transform+' rendition',()=>{const p=base();p.stages[1].transform=transform;p.stages[1].newManifest='unknown';has(p,/Changed content needs/);});
test('screenshot break, recovery not guaranteed',()=>{const p=base();p.stages[1].transform='screenshot';assert.equal(run(p).firstBreak,p.stages[1].name);has(p,/screenshot or re-capture/);has(p,/not guaranteed/);});
test('CMS original preserved',()=>assert.equal(run(base()).pipeline[3].status,'PASS'));
test('thumbnail destroyed',()=>{const p=m.credentialPreset('Social Platform Resize Risk');assert.equal(run(p).firstBreak,'Social thumbnail');assert.equal(run(p).status,'NOT READY');});
test('unknown CDN',()=>{const p=base();p.stages[2].preserves='unknown';assert.equal(run(p).pipeline[3].status,'UNKNOWN');assert.equal(run(p).firstBreak,undefined);});
test('signature planned distinct from executed',()=>{assert.ok(run(base()).report.includes('No media uploaded, signing performed or cryptographic validation executed'));});
test('no trust policy',()=>{const p=base();p.trust='unknown';has(p,/No trust ecosystem/);});
for(const observed of ['untrusted','missing','failed'] as const)test('reported '+observed,()=>{const p=base();p.observed=observed;const r=run(p);assert.ok(r.observation.includes(observed==='missing'?'Absence is not proof':observed==='failed'?'does not automatically':'not the truth'));assert.ok(r.findings.some(f=>f.stage==='Reported observation'));});
test('reported valid does not prove truth',()=>{const p=base();p.observed='valid';assert.match(run(p).observation,/does not prove factual truth/);});
test('pseudonym and anonymous need no legal name',()=>{for(const identity of ['pseudonym','anonymous'] as const){const p=base();p.identity=identity;assert.ok(!run(p).findings.some(f=>f.dimension==='Privacy'||f.stage==='Identity'));}});
test('location privacy',()=>{const p=base();p.privacy=['Exact location'];has(p,/Exact location/);});
for(const value of ['api_key=private-example-value', 'Bearer '+'x'.repeat(24), '-----BEGIN PRIVATE KEY-----','sk-'+'z'.repeat(28),'eyJ'+'a'.repeat(10)+'.abc.def'])test('secret masking',()=>{const p=base();p.stages[1].name=value;const r=run(p);assert.equal(r.secret,true);assert.ok(!JSON.stringify(r).includes(value));assert.equal(r.status,'NOT READY');assert.ok(r.report.includes('[Sensitive label removed]'));assert.equal(p.stages[1].name,value);});
test('masking idempotent',()=>assert.equal(m.safeCredentialLabel(m.safeCredentialLabel('token=sensitive-example')), '[Sensitive label removed]'));
test('embedded manifest',()=>assert.ok(!run(base()).findings.some(f=>f.stage==='Remote references')));
for(const location of ['remote','external','mixed'] as const)test(location+' availability/privacy caveat',()=>{const p=base();p.location=location;has(p,/Remote\/external availability/);p.availability='yes';assert.ok(!run(p).findings.some(f=>f.stage==='Remote references'));});
test('soft binding not hard binding',()=>{const p=base();p.softBinding=true;has(p,/not hard-binding/);});
test('no indicator',()=>{const p=base();p.indicator='no';has(p,/provenance indicator/);});
test('raw details without summary',()=>{const p=base();p.summary='no';has(p,/L2 summary/);});
test('validation stages individually reviewed',()=>{for(const k of m.c2pa.validation){const p=base();p.validation[k]=false;has(p,new RegExp(k+' validation'));}});
test('publisher intake',()=>{const p=base();p.incoming='no';has(p,/Incoming provenance/);});
test('missing retrieval/publisher',()=>{const p=base();p.stages=p.stages.filter(s=>s.kind!=='publish'&&s.kind!=='retrieve');has(p,/No publishing stage/);has(p,/No consumer retrieval/);});
test('high-assurance needs rotation/time/revocation',()=>{const p=base();p.highAssurance=true;p.timestamp='unknown';p.revocation='no';p.rotation='no';assert.equal(run(p).findings.filter(f=>f.stage==='Assurance').length,3);});
test('recipe input relationships',()=>{const p=base();p.inputs=['Reference image'];has(p,/without inputTo/);});
test('scope mismatch',()=>{const p=base();p.aiUse='modified';p.media='Audio';p.roi='region';has(p,/scope needs review/);});
test('bounded data',()=>{const p=base();p.stages=Array(13).fill(p.stages[0]);assert.throws(()=>run(p));p.stages=[m.credentialStage('x'.repeat(161))];assert.throws(()=>run(p));p.stages=[];p.ingredients=Array(13).fill({name:'x'});assert.throws(()=>run(p));});
test('matrix and checklist match real pipeline',()=>{const p=base();p.stages[0].name='Reviewed local editor';const r=run(p);assert.equal(r.matrix.length,p.stages.length);assert.equal(r.matrix[0].stage,p.stages[0].name);assert.ok(r.checklist.some(x=>x.includes(p.stages[0].name)));assert.ok(r.report.includes('| Reviewed local editor |'));});
test('deterministic non-mutating',()=>{const p=base(),original=JSON.stringify(p);assert.deepEqual(run(p),run(p));assert.equal(JSON.stringify(p),original);});
for(const preset of m.credentialPresets)test('preset '+preset,()=>{const r=run(m.credentialPreset(preset));assert.ok(r.matrix.length);assert.ok(r.findings.length<=m.c2pa.limits.findings);assert.deepEqual(r,run(m.credentialPreset(preset)));});
test('reorder',()=>{const p=base();const moved=m.moveCredentialStage(p.stages,0,1);assert.equal(moved[1].name,p.stages[0].name);assert.notDeepEqual(moved,p.stages);});
test('current vocabulary',()=>{assert.equal(m.c2pa.version,'2.4');assert.ok(!m.c2pa.actions.includes('c2pa.watermarked'));assert.ok(!m.c2pa.oversight.includes('human_authored'));assert.ok(m.c2pa.notes.some(s=>s.includes('claim_generator_info')));});
