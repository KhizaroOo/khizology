import assert from 'node:assert/strict';
import fs from 'node:fs';
import { performance } from 'node:perf_hooks';
import { contextDefaults, contextPresets, contextStrategies, simulateContext, type ContextConfig, type ContextStrategy } from '../src/components/toolbox/tools/contextEngineeringModel.ts';
import { activeTools, getRelatedTools, getTryNextTools } from '../src/data/tools.ts';
const close = (a: number, b: number) => assert.ok(Math.abs(a - b) < 1e-6, `${a} != ${b}`);
const blank: ContextConfig = { ...contextDefaults, window: 1_024, reserve: 24, systemTokens: 0, userTokens: 0, metadataTokens: 0, historyTokens: 0, memoryTokens: 0, chunks: 0, tools: 0, resultTokens: 0 };
const history = { ...blank, historyTokens: 1_000, historyRelevance: 80, historyDuplicate: 25, historyStale: 20 };
const baseline = simulateContext(history, 'none');
close(baseline.before.total, 1_000); close(baseline.available, 1_000); close(baseline.before.relevant, 800); close(baseline.before.uniqueRelevant, 600); close(baseline.before.duplicate, 250); close(baseline.before.stale, 200); close(baseline.before.density, .8);
assert.deepEqual(baseline.before, baseline.after);
const dedup = simulateContext(history, 'dedup');
close(dedup.saved, 250); close(dedup.after.duplicate, 0); close(dedup.after.uniqueRelevant, 600); close(dedup.preserved!, 1);
const fresh = simulateContext(history, 'recency');
close(fresh.saved, 200); close(fresh.after.stale, 0); close(fresh.preserved!, .8);
assert.deepEqual(simulateContext({ ...history, freshHistory: false }, 'recency').before, simulateContext({ ...history, freshHistory: false }, 'recency').after);
const retrieval = { ...blank, chunks: 10, chunkTokens: 100, retrievalRelevance: 50, retrievalDuplicate: 0, retrievalStale: 0, retrievalConflict: 0, topK: 5 };
const top = simulateContext(retrieval, 'topK');
close(top.saved, 500); close(top.after.relevant, 375); close(top.preserved!, .75); close(top.after.density, .75);
close(simulateContext({ ...retrieval, topK: 0 }, 'topK').after.total, 0);
close(simulateContext({ ...retrieval, topK: 200 }, 'topK').saved, 0);
const aggressive = simulateContext({ ...history, threshold: 90 }, 'threshold');
assert.ok(aggressive.uniqueRelevantRemoved > 0 && aggressive.relevantRemoved > 0);
const compression = simulateContext({ ...history, historyRetained: 50, compressionLoss: 10 }, 'compression');
close(compression.saved, 500); assert.ok(compression.preserved! < 1);
const memory = simulateContext({ ...blank, memoryTokens: 1_000, memoryRelevance: 30, memoryStale: 50 }, 'memory');
assert.ok(memory.saved > 0 && memory.after.stale < memory.before.stale);
const tools = simulateContext({ ...blank, tools: 10, toolTokens: 100, toolRelevance: 25, unusedTools: 50 }, 'tools');
close(tools.saved, 750); close(tools.after.toolOverhead, 0); close(tools.preserved!, 1); close(tools.before.unusedToolTokens, 500); close(tools.after.unusedToolTokens, 0);
const conflict = simulateContext({ ...retrieval, retrievalConflict: 100, threshold: 100 }, 'threshold');
assert.ok(conflict.conflictUnresolved && conflict.before.conflicts > 0); assert.notEqual(conflict.health, 'HEALTHY');
const overflow = simulateContext({ ...history, historyTokens: 2_000 }, 'none');
assert.equal(overflow.health, 'OVERLOADED'); close(overflow.after.overflow, 1_000); assert.ok(overflow.best && overflow.best.saved > 0);
const combined = simulateContext({ ...history, historyRetained: 50, compressionLoss: 10, threshold: 0 }, 'combined');
close(combined.saved, 625); close(combined.after.total, 375); close(combined.trace.reduce((n, t) => n + t.saved, 0), combined.saved);
const zero = simulateContext(blank, 'combined'); assert.equal(zero.preserved, null); assert.equal(zero.health, 'REVIEW');
const snapshot = JSON.stringify(contextPresets);
const start = performance.now();
for (const preset of contextPresets) for (const strategy of Object.keys(contextStrategies) as ContextStrategy[]) {
  const r = simulateContext(preset.config, strategy);
  assert.deepEqual(r, simulateContext(preset.config, strategy));
  assert.ok(r.saved >= 0 && r.after.total <= r.before.total + 1e-6);
  assert.ok(r.after.uniqueRelevant <= r.before.uniqueRelevant + 1e-6);
  assert.ok(r.preserved === null || r.preserved >= 0 && r.preserved <= 1);
  for (const source of r.before.rows.filter(row => row.protected)) close(r.after.rows.find(row => row.id === source.id)!.tokens, source.tokens);
  const visit = (v: unknown) => { if (typeof v === 'number') assert.ok(Number.isFinite(v)); else if (v && typeof v === 'object') Object.values(v).forEach(visit); };
  visit(r);
}
assert.equal(JSON.stringify(contextPresets), snapshot, 'Presets must not mutate');
assert.equal(simulateContext(contextPresets[0].config, 'none').health, 'HEALTHY');
assert.ok(simulateContext(contextPresets[1].config, 'none').before.density < .5);
assert.ok(simulateContext(contextPresets[3].config, 'tools').saved > 50_000);
for (const invalid of [{window: 0}, {reserve: 128_000}, {tools: 201}, {chunks: 201}, {threshold: NaN}, {historyTokens: Infinity}, {topK: -1}, {tools: 2.5}, {toolRelevance: 80, unusedTools: 30}]) assert.throws(() => simulateContext({ ...contextDefaults, ...invalid }, 'combined'));
assert.throws(() => simulateContext(contextDefaults, 'missing' as ContextStrategy));
const staleOnly = simulateContext({ ...blank, historyTokens: 1_000, historyRelevance: 100, historyDuplicate: 0, historyStale: 90 }, 'none');
assert.ok(staleOnly.biggestProblem.includes('Stale'));
assert.ok(performance.now() - start < 1_500);
for (const file of ['contextEngineeringModel.ts', 'ContextEngineeringSimulator.tsx']) if (fs.existsSync(`src/components/toolbox/tools/${file}`)) {
  const source = fs.readFileSync(`src/components/toolbox/tools/${file}`, 'utf8');
  assert.ok(!/\bfetch\s*\(|localStorage|sessionStorage|sendBeacon|console\.|\beval\s*\(|new Function|URLSearchParams|setInterval|dangerouslySetInnerHTML/.test(source), file);
}
console.log('Context engineering PASS: seven presets × nine strategies, exact accounting, overlapping diagnostics, protected tiers, retrieval, compression, memory, tool pruning, unresolved conflicts, overflow, bounds and privacy.');
const tool = activeTools.find(t => t.id === 'context-engineering-simulator')!;
assert.ok(tool && tool.family === 'simulate' && tool.privacySensitive);
assert.ok(getRelatedTools(tool).length > 0 && getTryNextTools(tool).length > 0);
for (const target of [...tool.relatedToolIds!, ...tool.nextToolIds!]) assert.ok(activeTools.some(t => t.id === target));
console.log(`Canonical counts: ${activeTools.length} active tools; ${activeTools.filter(t => t.family === 'simulate').length} Simulate tools.`);
