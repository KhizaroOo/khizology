import assert from 'node:assert/strict';import fs from 'node:fs';
import {buildCrawlerPolicy as build,policyPreset,crawlerRegistry,analyzeRobots,policyPresets,POLICY_LIMITS} from '../src/components/toolbox/tools/crawlerPolicyModel.ts';
import {activeTools,getRelatedTools,getTryNextTools} from '../src/data/tools.ts';
const base=()=>policyPreset(policyPresets[0]);let c=base(),r=build(c);assert.equal(r.training,4);assert.equal(r.impact,'LOW IMPACT');for(const token of ['Googlebot','OAI-SearchBot','Applebot'])assert.equal(c.policies[token],'Allow');for(const row of crawlerRegistry.filter(c=>c.training))assert.equal(c.policies[row.token],'Disallow');
assert.equal(build(policyPreset('Maximum Discovery')).training,0);
for(const token of ['GPTBot','Google-Extended','Applebot-Extended','ClaudeBot']){c=policyPreset('Maximum Discovery');c.policies[token]='Disallow';r=build(c);assert.equal(r.training,1);assert.equal(r.impact,'LOW IMPACT');assert.equal(r.search.length,0);assert.match(r.output,new RegExp(`User-agent: ${token}\\nDisallow: /`));}
for(const token of ['Googlebot','OAI-SearchBot','Applebot']){c=policyPreset('Maximum Discovery');c.policies[token]='Disallow';r=build(c);assert.equal(r.impact,'HIGH IMPACT');assert.equal(r.search[0].token,token);}
assert.match(build(base()).warnings.join(' '),/user-triggered/);assert.equal(crawlerRegistry.find(c=>c.token==='ChatGPT-User')!.control,'user');
c=base();c.scope='/docs/';c.paths=[{path:'/docs/public/',action:'Allow'}];r=build(c);assert.match(r.output,/User-agent: GPTBot\nDisallow: \/docs\/\nAllow: \/docs\/public\//);assert.match(r.warnings.join(' '),/partial/);assert.equal(r.impact,'REVIEW');
for(const path of ['https://x.com','bad','/a\nAllow: /','/a#b','/a?b','/*','/x$','/bad%zz','/a b','/'.repeat(251),'//evil']){assert.throws(()=>build({...base(),scope:path}));}
assert.throws(()=>build({...base(),paths:[{path:'/',action:'Allow'}]}));assert.throws(()=>build({...base(),paths:Array.from({length:11},(_,i)=>({path:`/${i}`,action:'Allow' as const}))}));
for(const sitemap of ['javascript:alert(1)','https://user:pass@example.com/s.xml','https://a.com/s.xml#x','https://a.com/\nSitemap: /'])assert.throws(()=>build({...base(),sitemap}));
c=base();c.sitemap='https://example.com/sitemap.xml';r=build(c);assert.ok(r.output.endsWith('Sitemap: https://example.com/sitemap.xml\n'));
const existing='User-agent: *\nDisallow: /\nSitemap: https://example.com/map.xml\n\nUser-agent: Googlebot\nDisallow: /legacy/\n\nUser-agent: GPTBot\nAllow: /\n\nUser-agent: GPTBot\nDisallow: /\nCrawl-delay: 5\n';
r=build({...base(),existing});assert.equal(r.impact,'HIGH IMPACT');assert.equal(r.analysis.original,existing);assert.equal(r.analysis.sitemaps[0],'https://example.com/map.xml');assert.ok(r.analysis.notices.some(n=>n.includes('Repeated')));assert.ok(r.analysis.notices.some(n=>n.includes('matching groups')));assert.ok(r.analysis.notices.some(n=>n.includes('unsupported')));assert.ok(!r.output.includes('User-agent: *'));assert.equal(r.label,'AI/provider policy block');
assert.ok(analyzeRobots('User-agent: GPTBot\nAllow: /\nDisallow: /').notices.some(n=>n.includes('equal specificity')));assert.equal(analyzeRobots('').groups.length,0);assert.throws(()=>analyzeRobots('a'.repeat(POLICY_LIMITS.existing+1)));assert.throws(()=>analyzeRobots('\n'.repeat(2001)));
const grouped=analyzeRobots('User-agent: GPTBot\nUser-agent: ClaudeBot\nDisallow: /\nUser-agent: Googlebot\nAllow: /');assert.equal(grouped.groups.length,2);assert.equal(grouped.groups[0].agents.length,2);
for(const preset of policyPresets){c=policyPreset(preset);assert.deepEqual(build(c),build(c));}assert.equal(build(policyPreset('Private / Minimal Crawling')).impact,'HIGH IMPACT');
assert.equal(new Set(crawlerRegistry.map(c=>c.token)).size,8);for(const c of crawlerRegistry){assert.equal(c.lastVerified,'2026-10-23');assert.match(c.source,/^https:\/\/(developers\.openai\.com|developers\.google\.com|support\.apple\.com|support\.claude\.com)\//);}
for(const f of ['crawlerPolicyModel.ts','AiCrawlerPolicyBuilder.tsx'])assert.ok(!/\bfetch\s*\(|localStorage|sessionStorage|sendBeacon|console\.|\beval\s*\(|new Function|URLSearchParams|dangerouslySetInnerHTML/.test(fs.readFileSync('src/components/toolbox/tools/'+f,'utf8')));
const tool=activeTools.find(t=>t.id==='ai-crawler-policy-builder')!;assert.ok(tool&&getRelatedTools(tool).length&&getTryNextTools(tool).length);for(const id of [...tool.relatedToolIds!,...tool.nextToolIds!])assert.ok(activeTools.some(t=>t.id===id),id);assert.equal(new Set(activeTools.map(t=>t.slug)).size,activeTools.length);
console.log(`PASS: policy presets, provider separation, impacts, paths, sitemap, basic groups/conflicts, limits, deterministic output, privacy and discovery. ${activeTools.length} active / ${activeTools.filter(t=>t.family==='create').length} Create.`);
