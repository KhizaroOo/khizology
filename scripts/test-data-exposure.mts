import assert from 'node:assert/strict';
import {analyzeDataExposure} from '../src/components/toolbox/tools/dataExposureModel.ts';
const token='eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJkZW1vIn0.dGVzdHNpZ25hdHVyZQ';
const result=analyzeDataExposure({'URL / query':`https://example.test/?token=${token}&email=reader%40example.test&page=1`});
assert.equal(result.posture,'FAIL');assert.ok(result.findings.some(f=>f.category==='Personal / potentially sensitive'));assert.ok(result.findings.some(f=>f.category==='Public'));
assert.ok(!JSON.stringify(result).includes(token));assert.ok(!JSON.stringify(result).includes('reader@example.test'));
assert.equal(analyzeDataExposure({'Frontend configuration':'{"apiKey":"demo"}'}).posture,'WARN');
assert.ok(analyzeDataExposure({'URL hash':`#jwt=${token}`}).findings[0].surface.includes('not normally sent'));
assert.equal(analyzeDataExposure({'localStorage dump':JSON.stringify({encoded:btoa('reader@example.test')})}).posture,'WARN');
assert.equal(analyzeDataExposure({'sessionStorage dump':JSON.stringify({encoded:btoa(JSON.stringify({accessToken:token}))})}).posture,'FAIL');
assert.ok(analyzeDataExposure({'Cookies':'sessionId=demo; theme=dark'}).findings.some(f=>f.category==='Authentication material'));
assert.equal(analyzeDataExposure({'localStorage dump':'{"token":"opaque-demo"}'}).posture,'WARN');
assert.ok(analyzeDataExposure({'URL / query':'https://example.test/#accessToken=opaque-demo'}).findings.some(f=>f.category==='Authentication material'));
assert.ok(analyzeDataExposure({'localStorage dump':'{"privatePayload":{"balance":10}}'}).findings.some(f=>f.category==='Personal / potentially sensitive'));
assert.ok(!JSON.stringify(analyzeDataExposure({'Browser state JSON':JSON.stringify({'reader@example.test and another@example.test':'x'})})).includes('@example.test'));
assert.throws(()=>analyzeDataExposure({}));assert.throws(()=>analyzeDataExposure({'Browser state JSON':'{bad'}));assert.throws(()=>analyzeDataExposure({'URL / query':'javascript:alert(1)'}));
assert.throws(()=>analyzeDataExposure({'Copied JSON payload':JSON.stringify(Array(2501).fill('x'))}));
assert.ok(analyzeDataExposure({'localStorage dump':JSON.stringify({text:'x'.repeat(21000)})}).findings.some(f=>f.issue==='Large pasted storage sample'));
console.log('Exposure tests passed: location-aware categories, masking, encoding, cookie uncertainty and bounded inputs.');
