import assert from 'node:assert/strict';import {planAssurance as run,assuranceDefault as d} from '../src/components/toolbox/tools/llmAssuranceModel.ts';
const high=run({...d,actions:true,financial:true,human:false,latency:true,structured:true});for(const layer of ['Human review','Fail-closed behavior','Business rules','Schema / exact-format validation','Manual escalation'])assert.ok(high.minimum.includes(layer));assert.ok(high.stop.includes('unavailable'));assert.ok(high.latency.includes('rather than skipping'));
const low=run({...d,users:false,human:false});assert.ok(!low.minimum.includes('Human review'));assert.equal(low.layers.length,14);assert.ok(low.remaining.includes('without guaranteeing'));assert.ok(run({...d,compliance:true}).minimum.includes('Privacy-safe audit logging'));
assert.ok(run({...d,deterministic:true}).layers.find(l=>l.name==='Deterministic validation')!.reason.includes('replacing the model'));
for(const task of ['classification','extraction','generation','recommendation'] as const)assert.equal(run({...d,task}).layers.length,14);assert.throws(()=>run({...d,task:'invalid' as any}));console.log('Assurance checks passed: low/high consequence, missing reviewer, latency, privacy and deterministic alternative.');
