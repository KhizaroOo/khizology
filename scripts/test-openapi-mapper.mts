let n=0;const test=(f:()=>void)=>{f();n++;};for(const name of mapperPresets)test(()=>{const r=mapOpenApi(mapperPreset(name));assert.ok(r.operations.length);assert.deepEqual(r,mapOpenApi(mapperPreset(name)));assert.ok(!r.blocked,name);});for(const openapi of ['3.0.4','3.1.2'])test(()=>assert.ok(mapOpenApi({...mapperPreset(),openapi}).operations.length));for(const openapi of ['2.0','3.2.1','invalid'])test(()=>assert.throws(()=>mapOpenApi({...mapperPreset(),openapi})));
