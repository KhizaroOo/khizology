import assert from 'node:assert/strict';import {ucpPreset,ucpPresets,ucpFormat,reviewUcp,analyzeUcp,negotiateUcp,ucpAuthorityMatches} from '../src/components/toolbox/tools/ucpProfileModel.ts';
let n=0;const test=(f:()=>void)=>{f();n++;};
for(const name of ucpPresets)test(()=>{const p=ucpPreset(name),r=reviewUcp(p);assert.equal(!!r.blocked,name==='Invalid legacy profile',name);assert.deepEqual(r,reviewUcp(p));assert.equal(r.files[0].text,JSON.stringify(p,null,2)+'\n');});
for(const key of ['version','services','payment_handlers'])test(()=>{const p=ucpPreset();delete p.ucp[key];assert.ok(reviewUcp(p).blocked);});
for(const version of ['2030-01-01','2026-01-11','2026-02-30'])test(()=>{const p=ucpPreset();p.ucp.version=version;assert.ok(reviewUcp(p).blocked);assert.equal(JSON.parse(reviewUcp(p).files[0].text).ucp.version,version);});
for(const transport of ucpFormat.transports)test(()=>{const p=ucpPreset();const row=p.ucp.services['dev.ucp.shopping'][0];row.transport=transport;if(transport==='embedded')delete row.endpoint;assert.ok(!reviewUcp(p).blocked);});
test(()=>{const p=ucpPreset();delete p.ucp.services['dev.ucp.shopping'][0].endpoint;assert.ok(reviewUcp(p).blocked);});
test(()=>{const p=ucpPreset();p.ucp.services['dev.ucp.shopping'][0].endpoint='http://example.com';assert.ok(reviewUcp(p).blocked);});
test(()=>{const p=ucpPreset('Full shopping merchant');p.ucp.capabilities['dev.ucp.shopping.checkout'][0].schema='https://evil.example/checkout.json';assert.ok(reviewUcp(p).blocked);});
test(()=>{const p=ucpPreset();p.ucp.supported_versions={'2026-04-08':'https://merchant.example.com/ucp/2026-04-08'};assert.ok(!reviewUcp(p).blocked);p.ucp.supported_versions[ucpFormat.version]='https://example.com';assert.ok(reviewUcp(p).blocked);});
test(()=>{const p=ucpPreset();p.signing_keys=[];assert.ok(reviewUcp(p).blocked);});
test(()=>{const p=ucpPreset();p.keys=[{kid:'test',kty:'EC',crv:'P-256',x:'public-x',y:'public-y',d:'private-material'}];const r=reviewUcp(p);assert.ok(r.blocked);assert.equal(r.files.length,0);assert.ok(!JSON.stringify(r).includes('private-material'));});
test(()=>{const p=ucpPreset();p.keys=[{kid:'test',kty:'future-public-type'}];assert.ok(!reviewUcp(p).blocked);});
test(()=>{const b=ucpPreset('Full shopping merchant'),p=ucpPreset('Full shopping merchant');delete p.ucp.capabilities['dev.ucp.shopping.checkout'];delete p.ucp.capabilities['dev.ucp.shopping.cart'];const r=reviewUcp(b,p),v=JSON.parse(r.files.find(v=>v.name==='ucp-negotiation.json')!.text);assert.ok(!v.active['dev.ucp.shopping.fulfillment']);assert.ok(!v.active['dev.ucp.shopping.discount']);assert.ok(v.active['dev.ucp.shopping.order']);});
test(()=>{const b=ucpPreset('Full shopping merchant'),p=ucpPreset('Full shopping merchant');delete p.ucp.capabilities['dev.ucp.shopping.checkout'];const v=negotiateUcp(b,p);assert.ok(v.active['dev.ucp.shopping.discount']);assert.ok(!v.active['dev.ucp.shopping.fulfillment']);});
test(()=>{const b=ucpPreset(),p=ucpPreset();p.ucp.version='2026-04-08';assert.equal(Object.keys(negotiateUcp(b,p).active).length,0);});
test(()=>{const b=ucpPreset(),p=ucpPreset();p.ucp.capabilities['dev.ucp.shopping.checkout'][0].version='2026-04-08';assert.equal(Object.keys(negotiateUcp(b,p).active).length,0);});
test(()=>assert.throws(()=>analyzeUcp('{bad')));test(()=>assert.throws(()=>analyzeUcp('x'.repeat(250001))));
test(()=>{const p=ucpPreset();p.ucp.payment_handlers={'com.example.handler':[{version:ucpFormat.version,id:'handler',config:{api_key:'not-a-real-secret'}}]};const r=reviewUcp(p);assert.ok(r.blocked);assert.equal(r.files.length,0);});
for(const [name,host,expected] of [['dev.ucp.shopping.checkout','shopping.ucp.dev',true],['com.example.pay','pay.example.com',true],['com.examplecorp.pay','example.com',false],['com.example.pay','cdn.example.com',false],['uk.co.example.shopping.checkout','example.co.uk',true],['com.example.pay','127.0.0.1',false],['com.example.pay','localhost',false]] as const)test(()=>assert.equal(ucpAuthorityMatches(name,host),expected));
console.log(`PASS: ${n} UCP profile, transport, version, key, negotiation, export and privacy groups.`);
