import assert from 'node:assert/strict';
import fs from 'node:fs';
import {paymentDefaults,paymentPresets,paymentPreset,simulatePayment as run,x402Metadata} from '../src/components/toolbox/tools/x402Model.ts';
import {activeTools} from '../src/data/tools.ts';
const base=()=>({...structuredClone(paymentDefaults),volume:1000,acceptance:100,verification:100,settlement:100,fulfilment:100,retry:0,price:1,railFixed:0,facFixed:0,facPercent:0,railPercent:0,other:0});
const close=(a:number,b:number)=>assert.ok(Math.abs(a-b)<1e-8,`${a} != ${b}`);
let n=0;const test=(f:()=>void)=>{f();n++;};
test(()=>close(run(base()).revenue,1000));
for(const key of ['acceptance','verification','settlement','fulfilment']as const)test(()=>{const r=run({...base(),[key]:50});close(r.fulfilled,500);close(r.revenue,key==='fulfilment'?1000:500);});
test(()=>close(run({...base(),retry:10,maxRetries:2}).attempts,1110));test(()=>close(run(base()).extra,0));
test(()=>close(run({...base(),facFixed:.1}).facilitator,100));test(()=>close(run({...base(),facPercent:10}).facilitator,100));test(()=>close(run({...base(),railFixed:.1}).rail,100));test(()=>close(run(base()).overhead,0));
test(()=>close(run(base()).contribution!,999));test(()=>assert.equal(run({...base(),resourceCostKnown:false}).contribution,null));test(()=>close(run(base()).breakEven!,.001));
test(()=>close(run({...base(),scheme:'upto',usage:62}).revenue,620));test(()=>{const r=run({...base(),scheme:'batch-settlement',batch:500,railFixed:.1});close(r.logical,1000);close(r.integerSettlements,2);close(r.exposure,500);close(r.rail,.2);});
test(()=>{const r=run({...base(),scheme:'batch-settlement',settlement:50});close(r.fulfilled,1000);close(r.revenue,500);close(r.unsettled,500);});
test(()=>{const r=run({...base(),session:true,sessionPrice:2,sessionCalls:100,sessionUsage:50});close(r.logical,20);close(r.revenue,40);close(r.fulfilled,1000);close(r.unusedPrepaid,20);});
test(()=>close(run({...base(),budget:250}).budgetFraction!, .25));test(()=>close(run({...base(),callsPerTask:12}).costPerTask,12));
test(()=>{const r=run({...base(),pricing:'dynamic'});close(r.revenue,8.4);});test(()=>close(run({...base(),pricing:'tiered',tierVolume:500,tierPrice:.5}).revenue,750));
test(()=>close(run({...base(),period:'day'}).requests,30000));test(()=>assert.equal(run({...base(),volume:0}).effectiveCost,null));
for(const preset of paymentPresets)test(()=>{const c=paymentPreset(preset),r=run(c);assert.deepEqual(r,run(c));for(const v of Object.values(r))if(typeof v==='number')assert.ok(Number.isFinite(v));});
for(const patch of [{volume:NaN},{acceptance:101},{verification:-1},{maxRetries:11},{batch:0},{sessionUsage:0},{volume:100000001},{pricing:'dynamic',classes:[{name:'x',share:50,price:1,cost:0,cap:1}]}])test(()=>assert.throws(()=>run({...base(),...patch} as any)));
test(()=>{const start=performance.now();for(let i=0;i<1000;i++)run({...base(),volume:100000000});assert.ok(performance.now()-start<3000);});
test(()=>{for(const file of ['x402Model.ts','X402AgentPaymentSimulator.tsx'])assert.ok(!/fetch\s*\(|localStorage|sessionStorage|indexedDB|sendBeacon|console\.|ethereum|solana\.|URLSearchParams|signTransaction/.test(fs.readFileSync('src/components/toolbox/tools/'+file,'utf8')));assert.equal(x402Metadata.version,2);assert.deepEqual(x402Metadata.headers,['PAYMENT-REQUIRED','PAYMENT-SIGNATURE','PAYMENT-RESPONSE']);});
test(()=>{assert.ok(activeTools.length>=87);assert.ok(activeTools.filter(t=>t.family==='simulate').length>=25);});
console.log(`PASS: ${n} x402 arithmetic, bounded aggregate performance, schemes, sessions, retries, fees, failure separation, privacy and registry groups.`);
