---
import { notoooIdentity, type NotoooBook } from '../../data/notooo';
import { SITE } from '../../data/site';
import { img } from '../../utils/url';

interface Props { book: NotoooBook; headingLevel?: 1 | 2; }

const { book, headingLevel = 2 } = Astro.props;
const number = String(book.number).padStart(3, '0');
const Title = headingLevel === 1 ? 'h1' : 'h2';
const sections = [book.bigIdea, ...book.sections];
---

<article class="sheet" data-notooo-sheet aria-label={`${book.title} one-page knowledge document`} style={`--notooo-color:${notoooIdentity.color};`}>
  <header class="sheet-header">
    <div class="brand" aria-label={`${SITE.name} logo`}>
      <img src={img('/images/Monsters/khizooo.png')} alt="Khizooology monster logo" width="30" height="30" />
      <span>{SITE.name.slice(0, 4)}<i>{SITE.name.slice(4)}</i></span>
    </div>
    <p class="metadata">NOTOOO {number} · {book.category.toUpperCase()}</p>
  </header>

  <div class="title-area">
    <Title>{book.title}</Title>
    <p class="author">{book.author}{book.publicationYear && ` · ${book.publicationYear}`}</p>
    <p class="subtitle">{book.subtitle}</p>
  </div>

  <div class="document-sections">
    {sections.map((section, index) => (
      <section class="document-section" data-number={String(index + 1).padStart(2, '0')}>
        <span class="section-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <h3>{section.title}</h3>
        <div class="section-content">
          <p class="one-liner">{section.oneLiner}</p>
          {section.points.length > 0 && <ul class="points">{section.points.map((point) => <li>{point}</li>)}</ul>}
        </div>
      </section>
    ))}
    <section class="document-section take" data-number={String(sections.length + 1).padStart(2, '0')}>
      <span class="section-number" aria-hidden="true">{String(sections.length + 1).padStart(2, '0')}</span>
      <h3>{book.khizoooTake.title}</h3>
      <div class="section-content">
        <p class="one-liner">{book.khizoooTake.oneLiner}</p>
        {book.khizoooTake.points.length > 0 && <ul class="points">{book.khizoooTake.points.map((point) => <li>{point}</li>)}</ul>}
      </div>
    </section>
    <section class="document-section remember" data-number={String(sections.length + 2).padStart(2, '0')}>
      <span class="section-number" aria-hidden="true">{String(sections.length + 2).padStart(2, '0')}</span>
      <h3>{book.remember.title}</h3>
      <div class="section-content"><p class="one-liner">{book.remember.oneLiner}</p></div>
    </section>
  </div>

  <footer class="sheet-footer"><span>NOTOOO · KHIZOOOLOGY</span><span>One Book. One Page.</span><span>khizooology.com</span></footer>
</article>

<style>
  .sheet { --ink: #171717; box-sizing: border-box; width: min(100%, 1200px); margin: auto; padding: 0 clamp(1.5rem, 5vw, 4.2rem) clamp(1.8rem, 5vw, 4rem); background: #fff; color: var(--ink); font: clamp(.94rem, 1.35vw, 1.06rem)/1.52 Mulish, sans-serif; }
  .sheet-header { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1rem; padding: 1.25rem 0 1.6rem; border-bottom: 1px solid var(--ink); }
  .brand { display: inline-flex; align-items: center; gap: .48rem; color: var(--ink); font: 800 1.02rem/1 Poppins, sans-serif; letter-spacing: -.03em; }
  .brand img { width: 30px; height: 30px; padding: 3px; object-fit: contain; border-radius: 50%; background: #f82d48; }
  .brand i { color: #f82d48; font-style: normal; }
  .metadata { margin: 0; color: var(--ink); text-align: right; font: 800 .69rem Poppins, sans-serif; letter-spacing: .13em; text-transform: uppercase; }
  .title-area { padding: 2.6rem 0 1.8rem; border-bottom: 1px solid #dedede; }
  .sheet h1, .sheet h2 { margin: 0; color: var(--ink); font: 900 clamp(2.8rem, 6.5vw, 5.2rem)/.94 Poppins, sans-serif; letter-spacing: -.055em; }
  .author { margin: .42rem 0 0; color: #606060; font-weight: 700; }
  .subtitle { max-width: 51rem; margin: 1rem 0 0; font-size: clamp(1.08rem, 1.8vw, 1.25rem); line-height: 1.48; }
  .document-section { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: 1rem; padding: 1.1rem 0; border-top: 1px solid #e5e5e5; }
  .document-section:first-child { border-top: 0; }
  .section-number { grid-row: span 2; color: var(--notooo-color); font: 800 1.18rem/1 Poppins, sans-serif; }
  .document-section h3 { grid-column: 2; margin: 0; color: var(--ink); font: 800 .76rem/1.3 Poppins, sans-serif; letter-spacing: .11em; text-transform: uppercase; }
  .section-content { grid-column: 2; }
  .section-content p { margin: 0; }
  .one-liner { font-weight: 700; line-height: 1.45; }
  .points { display: grid; gap: .24rem; margin: .48rem 0 0; padding-left: 1.15rem; }
  .points li::marker { color: var(--notooo-color); }
  .take { margin-top: .25rem; border-top: 2px solid var(--ink); }
  .remember { border-top-color: var(--ink); }
  .sheet-footer { display: flex; justify-content: space-between; gap: .75rem; margin-top: .3rem; padding-top: 1rem; border-top: 1px solid var(--ink); color: #575757; font: 800 .64rem Poppins, sans-serif; letter-spacing: .075em; }
  @media (max-width: 720px) { .sheet { width: 100%; padding: 0 1.25rem 1.5rem; font-size: 1rem; line-height: 1.55; } .sheet-header { gap: .75rem; padding: 1rem 0 1.25rem; } .metadata { font-size: .62rem; } .title-area { padding: 1.8rem 0 1.35rem; } .sheet h1, .sheet h2 { font-size: clamp(2.35rem, 13vw, 3.7rem); } .document-section { grid-template-columns: 1.75rem minmax(0, 1fr); gap: .65rem; padding: 1rem 0; } .section-number { font-size: 1rem; } .document-section h3 { font-size: .75rem; } .sheet-footer { align-items: flex-start; flex-direction: column; gap: .25rem; } }
</style>
