---
import type { Tool } from '../../data/tools';
import { getFamilyById } from '../../data/families';
import TagChip from './TagChip.astro';
import ToolLevelBadge from './ToolLevelBadge.astro';

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const family = getFamilyById(tool.family);
---

<div class="tool-header" style={`--fc: ${family?.color ?? '#F7933C'}`}>
  <div class="th-icon-wrap">
    <span class="th-icon">{tool.icon}</span>
  </div>
  <div class="th-text">
    <div class="th-badges">
      <span class="th-family-badge">{family?.icon} {family?.name}</span>
      <ToolLevelBadge level={tool.featureLevel} />
      {tool.status !== 'active' && (
        <span class="th-status-badge">{tool.status === 'planned' ? 'Planned' : 'Experimental'}</span>
      )}
    </div>
    <h1 class="th-title">{tool.name}</h1>
    <p class="th-desc">{tool.shortDescription}</p>
    <div class="th-tags">
      {tool.tags.map((t) => (
        <TagChip label={t} />
      ))}
    </div>
  </div>
</div>

<style>
  .tool-header {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .th-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--fc) 15%, transparent);
    border: 2px solid color-mix(in srgb, var(--fc) 30%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.875rem;
    flex-shrink: 0;
  }
  .th-text { flex: 1; min-width: 260px; }
  .th-badges { display: flex; gap: 0.375rem; flex-wrap: wrap; margin-bottom: 0.625rem; }
  .th-family-badge {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fc) 14%, transparent);
    color: var(--fc);
    border: 1px solid color-mix(in srgb, var(--fc) 32%, transparent);
    font-family: 'Poppins', sans-serif;
  }
  .th-status-badge {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--k-bg-elevated);
    color: var(--k-text-muted);
    border: 1px solid var(--k-border);
    font-family: 'Poppins', sans-serif;
  }
  .th-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 900;
    color: var(--k-text);
    line-height: 1.1;
    margin: 0.375rem 0 0.75rem;
  }
  .th-desc {
    font-size: 1rem;
    color: var(--k-text-muted);
    line-height: 1.7;
    max-width: 640px;
    margin: 0 0 0.875rem;
  }
  .th-tags { display: flex; flex-wrap: wrap; gap: 0.375rem; }
</style>
