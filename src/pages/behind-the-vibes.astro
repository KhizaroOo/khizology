---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { activeMonsters } from '../data/monsters';
import { img, url } from '../utils/url';
import { pageSchema } from '../utils/schema';

const pageTitle = 'Behind Khizooology — Why Art Meets Code';
const pageDescription = 'Meet Khizar Imtiaz, the creator behind khizooo and Khizooology: a personal creative R&D laboratory where art, code, tools and knowledge worlds grow together.';
const seoContext = { site: Astro.site!, base: import.meta.env.BASE_URL };
const jsonLd = pageSchema({
  type: 'AboutPage', path: '/behind-the-vibes', name: pageTitle, description: pageDescription, aboutCreator: true,
  breadcrumbs: [{ name: 'Home', path: '/' }, { name: 'Behind the Vibes', path: '/behind-the-vibes' }],
}, seoContext);

const creativeLoop = ['Think', 'Create ideas', 'Score', 'Prototype', 'Build', 'Verify', 'Publish', 'Share', 'Measure', 'Improve', 'Build smarter'];
const valueSignals = [
  { title: 'Useful', body: 'It should give someone a real next move.' },
  { title: 'Truthful', body: 'It should be honest about what it knows and what it does not.' },
  { title: 'Understandable', body: 'Complexity should become easier to see, not harder to enter.' },
  { title: 'Distinctive', body: 'It should carry an idea only this universe would make this way.' },
];
const faqs = [
  { question: 'What is Khizooology?', answer: 'Khizooology is my personal creative R&D laboratory. It is where original art, practical browser tools, interactive knowledge worlds, and small experiments can grow together.' },
  { question: 'Is this a portfolio?', answer: 'Not exactly. My portfolio explains the work I have done professionally. This page explains why I made this universe and how I like to create inside it.' },
  { question: 'Why monsters?', answer: 'They are different creative modes of the same brain: feeling through art, doing through tools, and understanding through interactive knowledge. They make each doorway into the universe easier to remember and explore.' },
  { question: 'What comes next?', answer: 'The universe is still being made. New work appears when it has a real reason to exist, not because an empty slot needs filling.' },
];
---

<BaseLayout title={pageTitle} description={pageDescription} accentColor="var(--k-accent)" jsonLd={jsonLd}>
  <div class="k-container btv-breadcrumb"><Breadcrumb crumbs={[{ label: 'Behind the Vibes' }]} accentColor="var(--k-accent)" /></div>

  <section class="btv-hero">
    <div class="k-container btv-hero-grid">
      <div class="btv-hero-copy">
        <span class="k-section-label" style="color:var(--k-accent)">Behind the Vibes</span>
        <h1>Art meets <span>Code.</span></h1>
        <p class="btv-hero-lead">Khizooology is where my engineering brain and artist brain stop arguing and start building things together.</p>
        <p>It is my personal creative R&amp;D laboratory: a place to explore an idea, test it, make it useful, and share what survives the process.</p>
      </div>
      <aside class="btv-creator-card" aria-label="The creator behind Khizooology">
        <div class="btv-creator-portrait"><img src={img('/images/site/lp-profile-img.png')} alt="Khizar Imtiaz" width="270" height="270" /></div>
        <div>
          <p class="btv-eyebrow">One creator</p>
          <h2>Khizar Imtiaz</h2>
          <p class="btv-identity"><strong>khizooo</strong> is my creator identity. <strong>Khizooology</strong> is the universe where the work lives.</p>
          <blockquote>“By luck, I am a programmer.<br />By nature, I am an artist.”</blockquote>
        </div>
      </aside>
    </div>
  </section>

  <section class="k-section btv-idea-section">
    <div class="k-container btv-reading-grid">
      <div class="btv-reading-copy">
        <span class="k-section-label" style="color:var(--k-accent)">The idea</span>
        <h2>Two ways of seeing, one way of making.</h2>
        <p>I work in software, but I naturally think visually. Separating those sides never made much sense to me. Art helps me notice, feel, and explore. Engineering helps me give an idea structure, interaction, and a way to be useful.</p>
        <p>Khizooology is where both sides get to work together. A drawing can hold an emotion. A tool can make an invisible system visible. A knowledge world can let someone experience a difficult idea instead of only reading about it.</p>
      </div>
      <div class="btv-art-code" aria-label="Art and code together create experiences people can use, understand, and feel">
        <div class="btv-discipline btv-art"><p class="btv-eyebrow">Art</p><h3>Feel and observe</h3><p>Curiosity, emotion, visual thinking, and experimentation.</p></div>
        <div class="btv-plus" aria-hidden="true">+</div>
        <div class="btv-discipline btv-code"><p class="btv-eyebrow">Code</p><h3>Structure and test</h3><p>Logic, systems, interaction, and usefulness.</p></div>
        <p class="btv-together">Together, ideas become experiences people can <strong>use</strong>, <strong>understand</strong>, and <strong>feel</strong>.</p>
      </div>
    </div>
  </section>

  <section class="k-section btv-monsters-section">
    <div class="k-container">
      <div class="btv-section-intro">
        <span class="k-section-label" style="color:var(--k-accent)">One creator, many monsters</span>
        <h2>The monsters are creative modes, not decoration.</h2>
        <p>Each one is a door into a different kind of value. Together, they are different parts of the same creative brain.</p>
      </div>
      <div class="btv-monster-grid">
        {activeMonsters.map((monster) => (
          <a href={url(monster.route)} class="btv-monster-card" style={`--monster-color:${monster.color}; --monster-light:${monster.colorLight}`}>
            <div class="btv-monster-image-wrap"><img src={img(monster.image)} alt="" width="88" height="88" loading="lazy" /></div>
            <div class="btv-monster-copy">
              <p class="btv-monster-role">{monster.role}</p><h3>{monster.name}</h3><p>{monster.description}</p><span>{monster.tagline} <b aria-hidden="true">→</b></span>
            </div>
          </a>
        ))}
      </div>
      <div class="btv-mystery-note"><span aria-hidden="true">✦</span><p><strong>The universe is not finished.</strong> Some doors are still locked, and their identities stay mysterious until there is something real behind them.</p><a href={url('/future-monsters')}>Meet the mystery monsters <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="k-section btv-loop-section">
    <div class="k-container btv-loop-grid">
      <div class="btv-loop-intro"><span class="k-section-label" style="color:var(--k-accent)">The creative R&amp;D loop</span><h2>Make it. Learn from it. Make the next thing smarter.</h2><p>Khizooology is a place to think in public, without pretending every experiment is already a finished answer.</p></div>
      <ol class="btv-loop" aria-label="Khizooology creative R and D process">{creativeLoop.map((step, index) => (<li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>))}</ol>
    </div>
  </section>

  <section class="k-section btv-values-section">
    <div class="k-container btv-values-grid">
      <div><span class="k-section-label" style="color:var(--k-accent)">What is worth building?</span><h2>Not more. Something worth existing.</h2><p>Before an idea earns a place here, I try to ask whether it helps, whether it is honest, whether people can understand it, and whether it feels unmistakably like it belongs in this universe.</p></div>
      <div class="btv-values-list">{valueSignals.map((signal) => (<article><h3>{signal.title}</h3><p>{signal.body}</p></article>))}</div>
    </div>
  </section>

  <section class="k-section btv-faq-section">
    <div class="k-container btv-faq-grid">
      <div><span class="k-section-label" style="color:var(--k-accent)">A few honest answers</span><h2>Questions behind the name.</h2><p>For the professional story and work history, visit my portfolio. This is the thinking behind the work.</p><a class="btv-text-link" href={url('/my-portfolio')}>Meet Khizar and view the portfolio <span aria-hidden="true">→</span></a></div>
      <div class="btv-faq-list">{faqs.map((item) => (<details class="btv-faq-item"><summary>{item.question}</summary><p>{item.answer}</p></details>))}</div>
    </div>
  </section>

  <section class="k-section btv-explore-section">
    <div class="k-container">
      <div class="btv-explore-heading"><span class="k-section-label" style="color:var(--k-accent)">Explore the universe</span><h2>Choose the kind of thing you need right now.</h2></div>
      <div class="btv-explore-grid">
        {activeMonsters.map((monster) => (<a href={url(monster.route)} class="btv-explore-card" style={`--monster-color:${monster.color}`}><span>{monster.role}</span><h3>{monster.name}</h3><p>{monster.module}</p><b aria-hidden="true">→</b></a>))}
        <a href={url('/my-portfolio')} class="btv-explore-card btv-portfolio-card"><span>MEET</span><h3>Khizar</h3><p>Portfolio and professional story</p><b aria-hidden="true">→</b></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .btv-breadcrumb { padding-top: 1.5rem; }
  .btv-hero { padding: 2.5rem 0 4.5rem; background: var(--k-bg); }
  .btv-hero-grid, .btv-reading-grid, .btv-loop-grid, .btv-values-grid, .btv-faq-grid { display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .btv-hero-grid { grid-template-columns: minmax(0, 1.15fr) minmax(300px, .85fr); }
  .btv-hero h1, .btv-reading-copy h2, .btv-section-intro h2, .btv-loop-intro h2, .btv-values-grid h2, .btv-faq-grid h2, .btv-explore-heading h2 { font-family: 'Poppins', sans-serif; color: var(--k-text); font-weight: 900; line-height: 1.08; margin: .5rem 0 1rem; }
  .btv-hero h1 { font-size: clamp(3rem, 7vw, 5.5rem); letter-spacing: -.055em; max-width: 680px; }
  .btv-hero h1 span { color: var(--k-accent); }
  .btv-hero-lead { font-size: clamp(1.2rem, 2.2vw, 1.55rem); color: var(--k-text); font-weight: 700; line-height: 1.45; max-width: 650px; margin: 0 0 1rem; }
  .btv-hero-copy > p:not(.btv-hero-lead), .btv-reading-copy p, .btv-section-intro > p, .btv-loop-intro p, .btv-values-grid > div > p, .btv-faq-grid > div > p { max-width: 680px; color: var(--k-text-muted); line-height: 1.75; margin: 0; }
  .btv-creator-card { position: relative; overflow: hidden; display: grid; grid-template-columns: 124px 1fr; gap: 1.25rem; align-items: center; background: var(--k-bg-card); border: 1px solid var(--k-border); border-radius: 1.5rem; padding: 1.5rem; box-shadow: 0 16px 38px color-mix(in srgb, var(--k-text) 8%, transparent); }
  .btv-creator-card::after { content: ''; position: absolute; inset: auto -3rem -4rem auto; width: 170px; height: 170px; border-radius: 50%; background: var(--k-accent); opacity: .08; pointer-events: none; }
  .btv-creator-portrait { align-self: stretch; display: flex; align-items: end; justify-content: center; background: color-mix(in srgb, var(--k-accent) 10%, var(--k-bg)); border-radius: 1rem; overflow: hidden; }
  .btv-creator-portrait img { width: 100%; height: auto; object-fit: cover; }
  .btv-eyebrow, .btv-monster-role { font-family: 'Poppins', sans-serif; color: var(--k-accent); font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; margin: 0 0 .35rem; }
  .btv-creator-card h2 { color: var(--k-text); font-family: 'Poppins', sans-serif; font-size: 1.25rem; margin: 0 0 .5rem; }
  .btv-identity { color: var(--k-text-muted); font-size: .85rem; line-height: 1.6; margin: 0 0 1rem; }
  .btv-identity strong { color: var(--k-text); }
  blockquote { border-left: 3px solid var(--k-accent); color: var(--k-text); font-family: 'Poppins', sans-serif; font-size: .88rem; font-weight: 700; line-height: 1.55; margin: 0; padding-left: .75rem; }

  .btv-idea-section, .btv-values-section { background: var(--k-bg-card); border-block: 1px solid var(--k-border); }
  .btv-reading-grid { grid-template-columns: minmax(0, 1fr) minmax(300px, .85fr); }
  .btv-reading-copy h2, .btv-section-intro h2, .btv-loop-intro h2, .btv-values-grid h2, .btv-faq-grid h2, .btv-explore-heading h2 { font-size: clamp(1.8rem, 3.4vw, 2.75rem); }
  .btv-reading-copy p + p { margin-top: 1rem; }
  .btv-art-code { display: grid; grid-template-columns: 1fr auto 1fr; gap: .75rem; align-items: center; padding: 1.25rem; border: 1px solid var(--k-border); border-radius: 1.25rem; background: var(--k-bg); }
  .btv-discipline { min-height: 190px; padding: 1.25rem; border-radius: 1rem; }
  .btv-art { background: color-mix(in srgb, #F5CF5C 20%, var(--k-bg-card)); }
  .btv-code { background: color-mix(in srgb, #F7933C 18%, var(--k-bg-card)); }
  .btv-discipline h3 { color: var(--k-text); font-family: 'Poppins', sans-serif; font-size: 1.1rem; margin: 0 0 .5rem; }
  .btv-discipline p:last-child, .btv-together { color: var(--k-text-muted); font-size: .85rem; line-height: 1.6; margin: 0; }
  .btv-plus { color: var(--k-accent); font-family: 'Poppins', sans-serif; font-size: 2rem; font-weight: 900; }
  .btv-together { grid-column: 1 / -1; padding: .5rem .25rem .15rem; }
  .btv-together strong { color: var(--k-text); }

  .btv-monsters-section { background: var(--k-bg); }
  .btv-section-intro { max-width: 720px; margin-bottom: 2rem; }
  .btv-monster-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .btv-monster-card { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 1rem; min-width: 0; padding: 1.25rem; overflow: hidden; text-decoration: none; background: var(--k-bg-card); border: 1px solid var(--k-border); border-radius: 1.25rem; transition: transform .18s ease, border-color .18s ease; }
  .btv-monster-card::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 5px; background: var(--monster-color); }
  .btv-monster-card:hover { border-color: var(--monster-color); transform: translateY(-3px); }
  .btv-monster-card:focus-visible, .btv-explore-card:focus-visible, .btv-text-link:focus-visible, .btv-mystery-note a:focus-visible { outline: 3px solid var(--k-accent); outline-offset: 3px; }
  .btv-monster-image-wrap { width: 88px; height: 88px; display: grid; place-items: center; flex: 0 0 auto; border-radius: .9rem; background: var(--monster-light); }
  .btv-monster-image-wrap img { width: 74px; height: 74px; object-fit: contain; }
  .btv-monster-copy { min-width: 0; }
  .btv-monster-role { color: var(--monster-color); }
  .btv-monster-copy h3 { color: var(--k-text); font-family: 'Poppins', sans-serif; font-size: 1.1rem; margin: 0 0 .35rem; }
  .btv-monster-copy p { color: var(--k-text-muted); font-size: .82rem; line-height: 1.55; margin: 0 0 .75rem; }
  .btv-monster-copy span { color: var(--monster-color); font-family: 'Poppins', sans-serif; font-size: .72rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
  .btv-monster-copy b { margin-left: .15rem; }
  .btv-mystery-note { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1rem; margin-top: 1.5rem; padding: 1rem 1.25rem; background: var(--k-bg-card); border: 1px dashed var(--k-border); border-radius: 1rem; }
  .btv-mystery-note > span { color: var(--k-accent); font-size: 1.2rem; }
  .btv-mystery-note p { flex: 1 1 420px; color: var(--k-text-muted); font-size: .84rem; line-height: 1.55; margin: 0; }
  .btv-mystery-note strong { color: var(--k-text); }
  .btv-mystery-note a, .btv-text-link { color: var(--k-accent); font-family: 'Poppins', sans-serif; font-size: .8rem; font-weight: 800; text-decoration: none; }
  .btv-mystery-note a:hover, .btv-text-link:hover { text-decoration: underline; }

  .btv-loop-section { background: var(--k-bg-card); border-block: 1px solid var(--k-border); }
  .btv-loop-grid { grid-template-columns: minmax(0, .75fr) minmax(380px, 1.25fr); }
  .btv-loop { display: flex; flex-wrap: wrap; gap: .55rem; padding: 0; margin: 0; list-style: none; }
  .btv-loop li { display: inline-flex; align-items: center; gap: .45rem; color: var(--k-text); background: var(--k-bg); border: 1px solid var(--k-border); border-radius: 999px; font-family: 'Poppins', sans-serif; font-size: .78rem; font-weight: 700; padding: .55rem .8rem .55rem .55rem; }
  .btv-loop li span { display: grid; place-items: center; width: 1.35rem; height: 1.35rem; color: var(--k-accent); background: color-mix(in srgb, var(--k-accent) 12%, transparent); border-radius: 50%; font-size: .58rem; }

  .btv-values-grid { grid-template-columns: minmax(0, .8fr) minmax(350px, 1.2fr); }
  .btv-values-list { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .btv-values-list article { padding: 1rem; border: 1px solid var(--k-border); border-radius: .9rem; background: var(--k-bg); }
  .btv-values-list h3 { color: var(--k-accent); font-family: 'Poppins', sans-serif; font-size: .82rem; letter-spacing: .07em; margin: 0 0 .4rem; text-transform: uppercase; }
  .btv-values-list p { color: var(--k-text-muted); font-size: .78rem; line-height: 1.55; margin: 0; }

  .btv-faq-section { background: var(--k-bg); }
  .btv-faq-grid { grid-template-columns: minmax(0, .8fr) minmax(360px, 1.2fr); align-items: start; }
  .btv-text-link { display: inline-block; margin-top: 1rem; }
  .btv-faq-list { border-top: 1px solid var(--k-border); }
  .btv-faq-item { border-bottom: 1px solid var(--k-border); }
  .btv-faq-item summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 0; color: var(--k-text); cursor: pointer; font-family: 'Poppins', sans-serif; font-size: .93rem; font-weight: 800; list-style: none; }
  .btv-faq-item summary::-webkit-details-marker { display: none; }
  .btv-faq-item summary::after { color: var(--k-accent); content: '+'; font-size: 1.3rem; font-weight: 500; }
  .btv-faq-item[open] summary::after { content: '−'; }
  .btv-faq-item > p { color: var(--k-text-muted); font-size: .88rem; line-height: 1.65; margin: 0; padding: 0 0 1rem; }

  .btv-explore-section { background: var(--k-bg-card); border-top: 1px solid var(--k-border); }
  .btv-explore-heading { margin-bottom: 1.5rem; }
  .btv-explore-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .85rem; }
  .btv-explore-card { position: relative; min-height: 150px; padding: 1.1rem; overflow: hidden; text-decoration: none; background: var(--k-bg); border: 1px solid var(--k-border); border-top: 4px solid var(--monster-color, var(--k-accent)); border-radius: 1rem; transition: transform .18s ease, border-color .18s ease; }
  .btv-explore-card:hover { border-color: var(--monster-color, var(--k-accent)); transform: translateY(-3px); }
  .btv-explore-card > span { color: var(--monster-color, var(--k-accent)); font-family: 'Poppins', sans-serif; font-size: .67rem; font-weight: 800; letter-spacing: .1em; }
  .btv-explore-card h3 { color: var(--k-text); font-family: 'Poppins', sans-serif; font-size: 1.05rem; margin: .5rem 0 .2rem; }
  .btv-explore-card p { color: var(--k-text-muted); font-size: .76rem; line-height: 1.45; margin: 0; }
  .btv-explore-card > b { position: absolute; right: 1rem; bottom: .9rem; color: var(--monster-color, var(--k-accent)); font-size: 1.1rem; }
  .btv-portfolio-card { --monster-color: var(--k-accent); }

  @media (max-width: 960px) { .btv-hero-grid, .btv-reading-grid, .btv-loop-grid, .btv-values-grid, .btv-faq-grid { grid-template-columns: 1fr; } .btv-monster-grid { grid-template-columns: 1fr; } .btv-explore-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .btv-creator-card { max-width: 620px; } }
  @media (max-width: 560px) { .btv-breadcrumb { padding-top: 1rem; } .btv-hero { padding: 1.25rem 0 3rem; } .btv-creator-card { grid-template-columns: 94px 1fr; padding: 1rem; gap: .9rem; } .btv-monster-card { grid-template-columns: 72px 1fr; padding: 1rem; } .btv-monster-image-wrap { width: 72px; height: 72px; } .btv-monster-image-wrap img { width: 60px; height: 60px; } .btv-art-code { grid-template-columns: 1fr; } .btv-plus { justify-self: center; transform: rotate(90deg); } .btv-discipline { min-height: auto; } .btv-values-list, .btv-explore-grid { grid-template-columns: 1fr; } .btv-loop li { font-size: .72rem; } }
  @media (prefers-reduced-motion: reduce) { .btv-monster-card, .btv-explore-card { transition: none; } }
</style>
