---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { img } from '../utils/url';
import { CONTACT } from '../data/site';
import { pageSchema } from '../utils/schema';

const pageTitle = 'Contact Khizar Imtiaz (khizooo) — Drop a Vibe | Khizooology';
const pageDescription = 'Contact Khizar Imtiaz (khizooo) to share feedback, propose a collaboration, report a bug, suggest a Toolooo idea, or say hello.';
const seoContext = { site: Astro.site!, base: import.meta.env.BASE_URL };
const jsonLd = pageSchema({
  type: 'ContactPage',
  path: '/drop-a-vibe',
  name: pageTitle,
  description: pageDescription,
  aboutCreator: true,
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Drop a Vibe', path: '/drop-a-vibe' },
  ],
}, seoContext);

---

<BaseLayout title={pageTitle} description={pageDescription} accentColor="var(--k-accent)" jsonLd={jsonLd}>
  <div class="k-container" style="padding-top: 2rem;">
    <Breadcrumb crumbs={[{ label: 'Drop a Vibe' }]} accentColor="var(--k-accent)" />
  </div>
  <section class="k-section dav-section">
    <div class="k-container dav-inner">
      <div>
        <span class="k-section-label" style="color: var(--k-accent-text)">Drop a Vibe</span>
        <h1 class="dav-title">Let’s talk.</h1>
        <p class="dav-lead">Have a project, collaboration, question, or feedback?<br />Choose how you’d like to get in touch.</p>
        <nav class="dav-connect" aria-label="Contact channels">
          <a href={CONTACT.whatsapp} class="k-button k-button--primary" target="_blank" rel="noopener noreferrer">Message me on WhatsApp</a>
          <a href={CONTACT.linkedin} class="k-button k-button--secondary" target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a>
          <a href={'mailto:' + CONTACT.email} class="k-button k-button--secondary" aria-describedby="contact-email-help">Email me</a>
        </nav>
        <p id="contact-email-help" class="dav-help">Email opens your email app.</p>
      </div>
      <aside class="dav-monster-card" aria-label="A small vibe">
        <img src={img('/images/Monsters/toolooo.png')} alt="toolooo" width="80" height="80" />
        <p>Every conversation starts with a small vibe.</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .dav-section { background: var(--k-bg); }
  .dav-inner { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(1.5rem, 4vw, 4rem); align-items: start; }
  .dav-title { font: 900 clamp(2rem, 4vw, 3rem)/1.1 'Poppins', sans-serif; color: var(--k-text); margin: .5rem 0 1rem; }
  .dav-lead { max-width: 48ch; font-size: 1rem; color: var(--k-text-muted); line-height: 1.7; margin: 0 0 1.75rem; }
  .dav-connect { display: flex; flex-wrap: wrap; gap: var(--k-action-gap); padding-bottom: var(--k-button-depth); }
  .dav-connect a { min-height: 44px; white-space: normal; text-align: center; }
  .dav-help { font-size: .85rem; color: var(--k-text-muted); margin: .75rem 0 0; }
  .dav-monster-card { display: flex; align-items: center; gap: 1rem; padding: 1.25rem; background: var(--k-bg-card); border: 1px solid var(--k-border); border-left: 4px solid var(--k-accent); border-radius: 0 1rem 1rem 0; }
  .dav-monster-card img { flex-shrink: 0; }
  .dav-monster-card p { font-size: .85rem; font-style: italic; color: var(--k-text-muted); margin: 0; line-height: 1.5; }
  @media (max-width: 900px) { .dav-inner { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 540px) { .dav-connect { flex-direction: column; align-items: stretch; } }
</style>
