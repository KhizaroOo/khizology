---
import BaseLayout from '../components/layout/BaseLayout.astro';
import MonsterCard from '../components/ui/MonsterCard.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { monsters } from '../data/monsters';
import { featuredArtworks } from '../data/artworks';
import { families } from '../data/families';
import { getToolCountByFamily, tools as toolboxTools } from '../data/tools';
import { url, img } from '../utils/url';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'khizology',
  url: 'https://khizarooo.github.io/khizology/',
  description: 'A monster-powered creative universe by khizooo — artworks and web tools.',
  author: {
    '@type': 'Person',
    name: 'Khizar Imtiaz',
    url: 'https://khizarooo.github.io/khizology/my-portfolio',
    sameAs: [
      'https://github.com/KhizaroOo',
      'https://www.linkedin.com/in/khizar-imtiaz',
      'https://www.instagram.com/khizooo_art',
    ],
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://khizarooo.github.io/khizology/toolbox',
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title="khizology — A Monster-Powered Creative Universe"
  description="khizology is a creative knowledge universe by khizooo. Explore Artworks and Toolbox calculators — all powered by monsters."
  jsonLd={jsonLd}
>

  <!-- HERO -->
  <section class="hero-section">
    <div class="k-container hero-inner">
      <div class="hero-content">
        <span class="hero-eyebrow">
          <span class="eyebrow-dot"></span>
          A Creative Knowledge Universe
        </span>
        <h1 class="hero-title">
          Where <span class="k-gradient-text">Art</span> meets
          <span class="k-gradient-text">Code</span>
        </h1>
        <p class="hero-subtitle">
          By luck, a programmer. By nature, an artist.<br />
          Welcome to <strong>khizology.</strong><br /><br />
          A monster-powered universe of Artworks and free Tools.
        </p>
        <div class="hero-ctas">
          <a href="#monsters" class="btn-primary">Explore Monsters</a>
          <a href={url('/toolbox')} class="btn-secondary">Try Toolbox</a>
          <a href={url('/artworks')} class="btn-ghost">View Artworks</a>
        </div>
        <div class="hero-stats">
          <div class="stat"><strong>168+</strong><span>Artworks</span></div>
          <div class="stat-divider"></div>
          <div class="stat"><strong>0</strong><span>Free Tools</span></div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-universe-grid">
          <!-- Logo center -->
          <div class="hug-logo">
            <img src={img('/images/Monsters/khizooo.png')} alt="khizology" width="64" height="64" />
            <span>khizology</span>
          </div>
          <!-- All monsters -->
          {monsters.map(m => (
            <div
              class={`hug-card${m.status === 'coming-soon' ? ' hug-soon' : ''}`}
              style={`--mc: ${m.color}`}
            >
              <img src={img(m.image)} alt={m.name} width="40" height="40" />
              <span>{m.status === 'coming-soon' ? '???ooo' : m.name}</span>
              <small>{m.status === 'coming-soon' ? 'Unknown' : m.module}</small>
            </div>
          ))}
        </div>
        <div class="hero-glow hero-glow-1"></div>
        <div class="hero-glow hero-glow-2"></div>
      </div>
    </div>
    <div class="scroll-indicator" aria-hidden="true">
      <span>Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- MONSTER UNIVERSE -->
  <section class="k-section monsters-section" id="monsters">
    <div class="k-container">
      <SectionHeader
        label="The Universe"
        title="Meet the Monsters"
        description="Each monster is a creative module. A world of its own. 2 are live. More are being unleashed."
        accentColor="var(--k-accent)"
        align="center"
      />
      <div class="monsters-grid">
        {monsters.map(m => <MonsterCard monster={m} />)}
      </div>
    </div>
  </section>

  <!-- FEATURED ARTWORKS -->
  <section class="k-section artworks-section">
    <div class="k-container">
      <SectionHeader
        label="artooo — Artworks"
        title="Visual Playground"
        description="A collection of 168+ original artworks — sketches, illustrations, emotions, and stories told through lines."
        accentColor="#F5CF5C"
        cta={{ label: 'View all Artworks', href: url('/artworks') }}
      />
      <div class="artworks-masonry">
        {featuredArtworks.slice(0, 8).map((art) => (
          <a href={url('/artworks')} class="artwork-thumb" aria-label={art.title}>
            <img
              src={img('/images/artworks/' + art.filename)}
              alt={art.title}
              loading="lazy"
              width="300"
              height="300"
            />
            <div class="artwork-hover">
              <span>{art.title}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TOOLBOX -->
  <section class="k-section toolbox-section">
    <div class="k-container">
      <SectionHeader
        label="toolooo — Toolbox"
        title="Turn Invisible Problems Into Visible Ones"
        description={`${toolboxTools.length} small browser tools that help you check, simulate, decide, plan, and create. No signup, no backend, no bullshit.`}
        accentColor="#F7933C"
        cta={{ label: 'Open Toolbox', href: url('/toolbox') }}
      />
      <div class="toolbox-two-cats">
        {families.map((f) => (
          <a href={url(`/toolbox/family/${f.id}`)} class="tb-cat-card" style={`--fc: ${f.color}`}>
            <div class="tb-cat-icon">{f.icon}</div>
            <div class="tb-cat-body">
              <h3>{f.name}</h3>
              <p>{getToolCountByFamily(f.id)} tool{getToolCountByFamily(f.id) === 1 ? '' : 's'} · "{f.question}"</p>
            </div>
            <span class="tb-cat-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BEHIND THE VIBES TEASER -->
  <section class="k-section btv-section">
    <div class="k-container">
      <div class="btv-inner">
        <div class="btv-content">
          <span class="k-section-label" style="color: var(--k-accent)">Behind the Vibes</span>
          <h2>By luck, a programmer.<br />By nature, an artist.</h2>
          <p>
            khizology isn't just a website — it's a living record of ideas, experiments,
            and creative exploration. Behind every monster is a story. Behind every artwork
            is an emotion. Behind every tool is a problem waiting to be solved.
          </p>
          <div class="btv-ctas">
            <a href={url('/behind-the-vibes')} class="btn-primary">Read the Story →</a>
            <a href={url('/my-portfolio')} class="btn-ghost">View Portfolio</a>
          </div>
        </div>
        <div class="btv-visual">
          <img src={img('/images/site/creative-01.png')} alt="khizooo creative" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- FOLLOW / REVISIT CTA -->
  <section class="k-section follow-section">
    <div class="k-container">
      <div class="follow-inner">
        <div class="follow-monsters">
          {monsters.map(m => (
            <img src={img(m.image)} alt={m.name} width="40" height="40" class="follow-monster-img" />
          ))}
        </div>
        <h2>Stay in the universe.</h2>
        <p>New artworks and tools drop regularly. Don't miss it.</p>
        <div class="follow-ctas">
          <a href={url('/drop-a-vibe')} class="btn-primary-inv">Drop a Vibe</a>
          <a href={url('/you-ask-i-answer')} class="btn-outline-inv">You Ask, I Answer</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 0 4rem;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Poppins', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--k-text-muted);
    margin-bottom: 1rem;
  }
  .eyebrow-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--k-accent);
    flex-shrink: 0;
    animation: blink 2s infinite;
  }
  @keyframes blink {
    0%,100% { opacity: 1; } 50% { opacity: 0.4; }
  }
  .hero-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--k-text);
    margin: 0 0 1.25rem;
  }
  .hero-subtitle {
    font-size: 1.05rem;
    color: var(--k-text-muted);
    line-height: 1.7;
    margin: 0 0 2rem;
    max-width: 480px;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .stat { display: flex; flex-direction: column; gap: 0.1rem; }
  .stat strong {
    font-family: 'Poppins', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--k-text);
  }
  .stat span {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--k-text-muted);
  }
  .stat-divider { width: 1px; height: 2rem; background: var(--k-border); }

  /* Hero visual — universe grid */
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 420px;
  }
  .hero-universe-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
    width: 100%;
    max-width: 420px;
  }
  /* Logo spans full top row center */
  .hug-logo {
    grid-column: 2 / 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    background: var(--k-bg-card);
    border: 2px solid var(--k-accent);
    border-radius: 1rem;
    padding: 0.75rem 0.5rem;
    box-shadow: 0 6px 20px var(--k-shadow);
  }
  .hug-logo img { border-radius: 50%; background: var(--k-accent); padding: 4px; }
  .hug-logo span {
    font-family: 'Poppins', sans-serif; font-size: 0.65rem; font-weight: 800;
    color: var(--k-text);
  }
  /* Monster cards */
  .hug-card {
    display: flex; flex-direction: column; align-items: center; gap: 0.2rem;
    background: var(--k-bg-card);
    border: 2px solid var(--mc, var(--k-border));
    border-radius: 0.875rem;
    padding: 0.5rem 0.3rem;
    font-family: 'Poppins', sans-serif;
    box-shadow: 0 4px 12px var(--k-shadow);
    transition: transform 0.2s;
  }
  .hug-card:hover { transform: translateY(-3px); }
  .hug-card span {
    font-size: 0.55rem; font-weight: 700; color: var(--k-text);
    text-align: center; line-height: 1.2;
  }
  .hug-card small {
    font-size: 0.5rem; color: var(--k-text-muted);
    text-align: center; line-height: 1.2;
  }
  .hug-card img { width: 36px; height: 36px; object-fit: contain; }
  /* Coming-soon cards: dimmed + dashed border */
  .hug-soon {
    opacity: 0.55;
    border-style: dashed;
  }
  .hug-soon img { filter: grayscale(0.4); }
  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
  }
  .hero-glow-1 { width:200px;height:200px;background:#F5CF5C;opacity:0.1;top:20%;left:10%; }
  .hero-glow-2 { width:150px;height:150px;background:#5CCFAF;opacity:0.08;bottom:10%;right:10%; }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--k-text-muted);
  }
  .scroll-line {
    width: 1px; height: 2.5rem;
    background: linear-gradient(to bottom, var(--k-text-muted), transparent);
    animation: scrollPulse 2s infinite;
  }
  @keyframes scrollPulse { 0%,100%{opacity:0.3} 50%{opacity:1} }

  /* BUTTONS */
  .btn-primary {
    display: inline-flex; align-items: center;
    padding: 0.65rem 1.5rem;
    background: var(--k-dark); color: var(--k-bg);
    border-radius: 0.625rem;
    font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 0.875rem;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
    white-space: nowrap;
    border: none;
  }
  .btn-primary:hover { opacity: 0.85; transform: translateY(-2px); }

  .btn-secondary {
    display: inline-flex; align-items: center;
    padding: 0.65rem 1.5rem;
    background: transparent; color: var(--k-text);
    border: 2px solid var(--k-dark);
    border-radius: 0.625rem;
    font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 0.875rem;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, transform 0.2s;
    white-space: nowrap;
  }
  .btn-secondary:hover { background: var(--k-dark); color: var(--k-bg); transform: translateY(-2px); }

  .btn-ghost {
    display: inline-flex; align-items: center;
    padding: 0.65rem 1.5rem;
    background: transparent; color: var(--k-text-muted);
    border: 1px solid var(--k-border);
    border-radius: 0.625rem;
    font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.875rem;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
    white-space: nowrap;
  }
  .btn-ghost:hover { border-color: var(--k-text); color: var(--k-text); }

  /* MONSTERS GRID */
  .monsters-section { background: var(--k-bg-card); }
  .monsters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  /* ARTWORKS */
  .artworks-masonry {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }
  .artwork-thumb {
    position: relative;
    border-radius: 0.75rem;
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--k-border);
    display: block;
  }
  .artwork-thumb img { width:100%; height:100%; object-fit:cover; transition: transform 0.4s; }
  .artwork-thumb:hover img { transform: scale(1.07); }
  .artwork-hover {
    position: absolute; inset: 0;
    background: rgba(42,52,57,0.75);
    display: flex; align-items: flex-end; padding: 0.75rem;
    opacity: 0; transition: opacity 0.2s;
  }
  .artwork-hover span { color:#fff; font-size:0.75rem; font-weight:600; }
  .artwork-thumb:hover .artwork-hover { opacity: 1; }

  /* TOOLBOX - 5 families */
  .toolbox-section { background: var(--k-bg-card); }
  .toolbox-two-cats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .tb-cat-card {
    display: flex; align-items: center; gap: 1.25rem;
    padding: 1.5rem 1.75rem;
    background: var(--k-bg-card); border: 1px solid var(--k-border); border-radius: 1rem;
    text-decoration: none; color: inherit;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .tb-cat-card:hover {
    border-color: var(--fc, #F7933C); transform: translateY(-3px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--fc, #F7933C) 15%, transparent);
  }
  .tb-cat-icon {
    width: 3rem; height: 3rem; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--fc, #F7933C) 12%, transparent); border-radius: 0.75rem;
    font-size: 1.375rem;
  }
  .tb-cat-body { flex: 1; }
  .tb-cat-body h3 { font-family: 'Poppins', sans-serif; font-size: 1rem; font-weight: 700; color: var(--k-text); margin: 0 0 0.25rem; }
  .tb-cat-body p { font-size: 0.8rem; color: var(--k-text-muted); margin: 0; }
  .tb-cat-arrow { color: var(--k-text-muted); font-size: 1.2rem; transition: transform 0.2s; }
  .tb-cat-card:hover .tb-cat-arrow { transform: translateX(4px); color: var(--fc, #F7933C); }

  /* BEHIND THE VIBES */
  .btv-section { background: var(--k-bg); }
  .btv-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .btv-content h2 {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; line-height: 1.2;
    color: var(--k-text); margin: 0 0 1rem;
  }
  .btv-content p { font-size: 0.95rem; color: var(--k-text-muted); line-height: 1.7; margin: 0 0 1.5rem; }
  .btv-ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .btv-visual { border-radius: 1.5rem; overflow: hidden; aspect-ratio: 4/3; }
  .btv-visual img { width:100%; height:100%; object-fit:cover; border: 2px solid var(--k-border); border-radius: 1.5rem; }

  /* FOLLOW SECTION — theme-aware */
  .follow-section {
    background: linear-gradient(135deg, var(--k-bg-card) 0%, var(--k-bg) 100%);
    border-top: 1px solid var(--k-border);
  }
  .follow-inner { text-align: center; max-width: 640px; margin-inline: auto; }
  .follow-monsters {
    display: flex; align-items: center; justify-content: center;
    flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.75rem;
  }
  .follow-monster-img {
    width: 40px; height: 40px; object-fit: contain;
    border-radius: 0.625rem; background: var(--k-bg-card);
    border: 1px solid var(--k-border); padding: 3px;
    transition: transform 0.2s;
  }
  .follow-monster-img:hover { transform: translateY(-3px); }
  .follow-inner h2 {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800;
    color: var(--k-text); margin: 0 0 0.75rem;
  }
  .follow-inner p { color: var(--k-text-muted); margin: 0 0 2rem; font-size: 1rem; }
  .follow-ctas { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .btn-primary-inv {
    display: inline-flex; align-items: center; padding: 0.65rem 1.5rem;
    background: var(--k-accent); color: #fff;
    border-radius: 0.625rem; font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 0.875rem;
    text-decoration: none; transition: opacity 0.2s, transform 0.2s;
  }
  .btn-primary-inv:hover { opacity: 0.85; transform: translateY(-2px); }
  .btn-outline-inv {
    display: inline-flex; align-items: center; padding: 0.65rem 1.5rem;
    background: transparent; color: var(--k-text-muted);
    border: 1px solid var(--k-border);
    border-radius: 0.625rem; font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.875rem;
    text-decoration: none; transition: border-color 0.2s, color 0.2s;
  }
  .btn-outline-inv:hover { border-color: var(--k-accent); color: var(--k-accent); }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-visual { display: none; }
    .artworks-masonry { grid-template-columns: repeat(2, 1fr); }
    .btv-inner { grid-template-columns: 1fr; }
    .btv-visual { order: -1; }
    .toolbox-two-cats { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .artworks-masonry { grid-template-columns: repeat(2, 1fr); }
    .hero-ctas { flex-direction: column; }
    .monsters-grid { grid-template-columns: 1fr; }
  }
</style>
