---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import AgentIdentityLab from '../../components/infooo/identity-lab/AgentIdentityLab';
import { infoooWorlds, infoooIdentity } from '../../data/infooo';
import { absoluteUrl, breadcrumbSchema } from '../../utils/seo';
import { url } from '../../utils/url';
const world = infoooWorlds.find(w => w.id === 'world-013')!;
const context = { site: Astro.site!, base: import.meta.env.BASE_URL };
const canonical = absoluteUrl(`/infooo/${world.slug}`, context);
const related = infoooWorlds.filter(w => world.relatedWorlds?.includes(w.id) && w.status === 'published' && w.visibility === 'public');
---
<BaseLayout title="Agent Identity Lab — Identity & Authority | Khizooology" description={world.description} canonical={canonical} accentColor={infoooIdentity.color} accentColorLight={infoooIdentity.colorLight} ogImage={world.hero!.asset} ogImageAlt={world.preview!.alt} socialTitle={world.title} socialDescription={world.description} jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebApplication', name: world.title, description: world.description, url: canonical, applicationCategory: 'EducationalApplication', operatingSystem: 'Any', isAccessibleForFree: true }, breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Infooo', path: '/infooo' }, { name: world.title, path: `/infooo/${world.slug}` }], context)]}>
  <div class="k-container il-breadcrumb"><Breadcrumb crumbs={[{ label: 'Infooo', href: url('/infooo') }, { label: world.title }]} accentColor={infoooIdentity.color}/></div>
  <AgentIdentityLab client:load world={world}>
    <section class="il-static">
      <h2>Identity is not a credential. Authentication is not authorization.</h2>
      <p>Run Research, Deploy and Report agents through a shared service credential. Trigger an unwanted production release, trace its ambiguous audit subject and revoke the credential: all three agents stop. Repeat the same workload with dedicated identities to identify Deploy Agent and revoke only that actor while the others continue.</p>
      <p>Inspect ownership, purpose, scoped authority, short-lived credentials, on-behalf-of audit context and bounded delegation. Try six incidents covering shared attribution, coarse revocation, over-broad scope, expiry, orphaned agents and delegation escalation. Review lifecycle drift, inspect nine trust-chain layers and apply the lessons in four challenges.</p>
      <p>This is an educational identity model, not an IAM product, security certification or universal standard. All agents, users, credentials, resources, grants, audit entries and times are fictional and deterministic. No login, token generation, identity provider, cloud API, private input, backend or persistent storage is connected.</p>
      <p>Existing workload identities and service principals already solve many machine-identity problems. Simple internal agents may need no new identity technology. The goal is attributable, appropriately scoped and governable authority. Agent-specific metadata can build on existing IAM foundations. Purpose text alone cannot enforce policy, and identity alone cannot guarantee safe behavior.</p>
      <nav aria-label="Related knowledge worlds">{related.map(w => <a href={url(`/infooo/${w.slug}`)}>{w.title} →</a>)}<a href={url('/infooo')}>Explore all Infooo worlds →</a></nav>
    </section>
  </AgentIdentityLab>
</BaseLayout>
<style>
  .il-breadcrumb{padding-block:.5rem .25rem}.il-static{padding-block:.5rem 1rem}.il-static h2{font:800 1.1rem Poppins,sans-serif}.il-static p{max-width:85ch;line-height:1.8;color:var(--k-text-muted);font-size:.85rem}.il-static nav{display:flex;flex-wrap:wrap;gap:1rem}.il-static a{color:var(--k-text);text-underline-offset:4px}
</style>
