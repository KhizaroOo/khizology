---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { agentSystemsLab as collection, agentSystemsJourney as journey, infoooIdentity } from '../../data/infooo';
import { SITE } from '../../data/site';
import { url, img } from '../../utils/url';
import { absoluteUrl, personReference } from '../../utils/seo';
import { pageSchema } from '../../utils/schema';
const context = { site: Astro.site!, base: import.meta.env.BASE_URL };
const path = `/infooo/${collection.slug}`;
const start = journey[0].world;
const total = journey.length;
const worldPath = (slug: string) => `/infooo/${slug}`;
const schema = pageSchema({ type: 'CollectionPage', path, name: collection.title, description: collection.description, primaryImage: collection.socialImage, breadcrumbs: [{ name: 'Home', path: '/' }, { name: 'Infooo', path: '/infooo' }, { name: collection.title, path }], extra: { creator: personReference(context), mainEntity: { '@type': 'ItemList', name: `${collection.title} learning journey`, numberOfItems: total, itemListElement: journey.map(entry => ({ '@type': 'ListItem', position: entry.position, name: entry.world.title, url: absoluteUrl(worldPath(entry.world.slug), context) })) } } }, context);
const chain = collection.compoundPath.map(id => journey.find(entry => entry.world.id === id)!);
---
<BaseLayout title="Agent Systems Lab — AI Agent Security & Reliability | Khizooology" description={collection.description} canonical={absoluteUrl(path, context)} accentColor={infoooIdentity.color} accentColorLight={infoooIdentity.colorLight} ogImage={collection.socialImage} ogImageAlt={collection.preview.alt} socialTitle="Agent Systems Lab — Interactive AI Agent Architecture" socialDescription={collection.description} jsonLd={schema}>
  <div class="asl k-container" style={`--k-button-accent:${infoooIdentity.color}`}>
    <Breadcrumb crumbs={[{ label: 'Infooo', href: url('/infooo') }, { label: collection.title }]} accentColor={infoooIdentity.color}/>
    <section class="asl-hero" aria-labelledby="asl-title">
      <div><p class="asl-eyebrow">INFOOO · CURATED COLLECTION</p><h1 id="asl-title">{collection.title}</h1><p class="asl-headline">{collection.headline}</p><p class="asl-lead">{collection.supporting}</p><p class="asl-description">Explore security, reliability, context, identity and incident response through interactive experiments.</p><div class="asl-actions"><a class="k-button k-button--primary" href={url(worldPath(start.slug))} data-infooo-collection={collection.slug} data-collection-action="start">Start the Lab <span aria-hidden="true">→</span></a><a class="k-button k-button--secondary" href="#journey">Explore all {total}</a></div><p class="asl-credit">Built by <a href={url('/my-portfolio')}>{SITE.author}</a> / {SITE.name}. For architects, AI engineers, security engineers and platform teams.</p></div>
      <figure><img src={img(collection.preview.asset)} alt={collection.preview.alt} width="760" height="470" fetchpriority="high"/><figcaption>One system, examined from seven angles. Illustrative architecture.</figcaption></figure>
    </section>
    <section class="asl-section" id="journey" aria-labelledby="journey-title"><header><p class="asl-eyebrow">PREVENT → UNDERSTAND → RECOVER</p><h2 id="journey-title">Your seven-step journey</h2><p>Start with tool boundaries, then follow the system through failure, authority and recovery. Step numbers show the learning order, not completion.</p></header>
      <ol class="asl-journey">{journey.map(entry => <li><article><span class="asl-step">{entry.position} / {total} · {entry.label}</span><h3>{entry.world.title}</h3><p>{entry.question}</p><p class="asl-takeaway">{entry.takeaway}</p><a href={url(worldPath(entry.world.slug))} data-infooo-collection={collection.slug} data-collection-action="world">Explore <span class="asl-sr-only">{entry.world.title}</span><span aria-hidden="true">→</span></a></article></li>)}</ol>
    </section>
    <section class="asl-section" aria-labelledby="problem-title"><header><p class="asl-eyebrow">START WHERE IT MATTERS</p><h2 id="problem-title">What are you trying to understand?</h2></header><ul class="asl-problems">{journey.map(entry => <li><a href={url(worldPath(entry.world.slug))} data-infooo-collection={collection.slug} data-collection-action="world"><span>{entry.problem}<small>{entry.world.title}</small></span><span aria-hidden="true">→</span></a></li>)}</ul></section>
    <section class="asl-section asl-system" aria-labelledby="system-title"><h2 id="system-title">A model is only one part of an agent system.</h2><p>Tools, context, identity, policy, state and external systems shape what an agent can do—and what happens when something goes wrong.</p><p class="asl-equation">Model + tools + context + identity + policy + state + external systems <strong>= agent system</strong></p><h3>Failures can compound.</h3><p>One illustrative path—not an inevitable sequence:</p><ol class="asl-chain">{chain.map((entry, index) => <li><a href={url(worldPath(entry.world.slug))} data-infooo-collection={collection.slug} data-collection-action="world"><span>{['Untrusted input', 'Tool action', 'Broad authority', 'Retry / side effect', 'Incident'][index]}</span><small>World {String(entry.world.worldNumber).padStart(3, '0')} · {entry.world.title}</small></a></li>)}</ol></section>
    <section class="asl-section asl-truth"><h2>Deep knowledge. Clear boundaries.</h2><p>Each lab distinguishes <b>Fact</b>, <b>Model</b> and <b>Simulation</b>, with its own maintained sources and limitations. These fictional browser-only experiments demonstrate architectural relationships; they are not security certifications or predictions of a specific model. No accounts, real agents or private inputs are needed.</p></section>
    <section class="asl-consult" aria-labelledby="consult-title"><div><p class="asl-eyebrow">BUILDING PRODUCTION AI AGENTS?</p><h2 id="consult-title">Bring the system into focus.</h2><p>Security, reliability, identity, authorization, context, tooling and incident response are connected architecture questions.</p><p><strong>{SITE.author}</strong><br/>AI-agent security, reliability & system design</p></div><div class="asl-actions"><a class="k-button k-button--primary k-button--brand" href={url(collection.contactPath)} data-infooo-collection={collection.slug} data-collection-action="consulting">Work with Khizar</a><a href={url('/my-portfolio')}>Explore professional work →</a></div></section>
    <p class="asl-back"><a href={url('/infooo')}>← Explore all Infooo worlds</a></p>
  </div>
</BaseLayout>
<style>
.asl{padding-block:1rem 2.5rem;color:var(--k-text)}.asl-hero{display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(1.5rem,3vw,3rem);align-items:center;padding-block:1.5rem 2rem}.asl-eyebrow{font-size:.65rem;letter-spacing:.08em;font-weight:800;color:var(--k-text-muted);margin:0 0 .6rem}h1{font:900 clamp(2rem,3.5vw,3.5rem)/1.1 Poppins,sans-serif;letter-spacing:-.045em;margin:0 0 1rem}.asl-headline{font:800 clamp(1.2rem,2vw,1.75rem)/1.45 Poppins,sans-serif;max-width:31ch;margin:0 0 1rem}.asl-lead{font-weight:700;font-size:1rem;margin:0 0 .5rem}.asl-description,.asl-credit,.asl-section>p,.asl-section header>p,.asl-consult p{color:var(--k-text-muted);font-size:.88rem;line-height:1.8;max-width:85ch}.asl-credit{font-size:.75rem;max-width:65ch}.asl-actions{display:flex;flex-wrap:wrap;gap:.8rem;align-items:center;margin:1.2rem 0}.asl a{color:var(--k-text);text-underline-offset:4px}.asl a:focus-visible{outline:3px solid var(--k-text);outline-offset:5px}.asl figure{margin:0;min-width:0}.asl figure img{display:block;width:100%;height:auto;border:1px solid var(--k-border);border-radius:20px}.asl figcaption{font-size:.68rem;line-height:1.6;color:var(--k-text-muted);margin-top:.5rem}.asl-section{padding-block:1.5rem;border-top:1px solid var(--k-border);scroll-margin-top:100px}h2{font:800 clamp(1.2rem,2vw,1.65rem)/1.4 Poppins,sans-serif;margin:0 0 .6rem}h3{font:800 1rem/1.45 Poppins,sans-serif;margin:0}.asl-journey{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.5rem;margin:1.2rem 0 0}.asl-journey li{min-width:0;position:relative}.asl-journey li:not(:last-child)::after{content:'→';position:absolute;left:calc(100% + .3rem);top:1.8rem;color:var(--k-text-muted);font-size:1.2rem}.asl-journey li:nth-child(4)::after{display:none}.asl-journey article{height:100%;display:flex;flex-direction:column;gap:.7rem;padding:1rem;border:1px solid var(--k-border);border-top:3px solid var(--m-infooo);border-radius:14px;background:var(--k-bg-card)}.asl-step{font-size:.6rem;font-weight:800;letter-spacing:.035em;line-height:1.7;color:var(--k-text-muted)}.asl-journey p{font-size:.8rem;line-height:1.7;margin:0}.asl-takeaway{color:var(--k-text-muted);border-top:1px solid var(--k-border);padding-top:.7rem}.asl-journey a{display:inline-flex;gap:.4rem;align-items:center;min-height:44px;font-size:.8rem;font-weight:800;margin-top:auto;width:fit-content}.asl-problems{list-style:none;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:.6rem 1.5rem;margin:1rem 0}.asl-problems a{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.8rem;border:1px solid var(--k-border);border-radius:12px;text-decoration:none;min-height:60px;font-size:.85rem}.asl-problems a:hover{border-color:var(--m-infooo);background:color-mix(in srgb,var(--m-infooo) 5%,var(--k-bg-card))}.asl-problems small{display:block;color:var(--k-text-muted);font-size:.72rem;margin-top:.3rem}.asl-equation{padding:1rem;border-radius:12px;background:var(--k-bg-card);border:1px solid var(--k-border);word-spacing:.1rem}.asl-equation strong{display:block;color:var(--k-text);margin-top:.3rem}.asl-system h3{margin-top:1.2rem}.asl-chain{list-style:none;display:flex;flex-wrap:wrap;gap:1.5rem;padding:0}.asl-chain li{flex:1 1 170px;position:relative}.asl-chain li:not(:last-child)::after{content:'→';position:absolute;left:calc(100% + .25rem);top:.8rem;color:var(--k-text-muted)}.asl-chain a{display:grid;gap:.5rem;min-height:85px;padding:.8rem;border-left:3px solid var(--m-infooo);background:var(--k-bg-card);border-radius:0 10px 10px 0;text-decoration:none}.asl-chain span{font-weight:700;font-size:.8rem}.asl-chain small{font-size:.65rem;color:var(--k-text-muted);line-height:1.7}.asl-truth p{max-width:95ch}.asl-consult{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.5rem;border:1px solid var(--k-border);border-radius:18px;background:var(--k-bg-card)}.asl-consult p{max-width:65ch}.asl-consult .asl-actions{flex-direction:column;align-items:start;flex-shrink:0}.asl-consult .asl-actions>a:not(.k-button){min-height:44px;display:flex;align-items:center;font-size:.8rem}.asl-back{font-size:.8rem;margin:1.5rem 0}.asl-back a{min-height:44px;display:inline-flex;align-items:center}.asl-sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(min-width:1750px){.asl-journey{grid-template-columns:repeat(7,minmax(0,1fr))}.asl-journey li:nth-child(4)::after{display:block}}@media(max-width:1100px){.asl-hero{grid-template-columns:1fr 1fr}.asl-journey{grid-template-columns:repeat(2,minmax(0,1fr))}.asl-journey li:nth-child(even)::after{display:none}.asl-chain{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.asl-chain li:nth-child(3)::after{display:none}.asl-consult{align-items:start;flex-direction:column;gap:.5rem}.asl-consult .asl-actions{flex-shrink:1;flex-direction:row;align-items:center}}@media(max-width:650px){.asl-hero{grid-template-columns:1fr;gap:1rem;padding-block:1.2rem}.asl-hero figure{max-width:450px}.asl-journey{grid-template-columns:1fr;gap:1.5rem}.asl-journey li:not(:last-child)::after,.asl-journey li:nth-child(even)::after,.asl-journey li:nth-child(4)::after{display:block;content:'↓';left:calc(50% - .4rem);top:calc(100% + .05rem);line-height:1.4rem}.asl-problems{grid-template-columns:1fr}.asl-chain{grid-template-columns:1fr}.asl-chain li:not(:last-child)::after,.asl-chain li:nth-child(3)::after{display:block;content:'↓';left:calc(50% - .4rem);top:100%;line-height:1.5rem}.asl-consult{padding:1rem}.asl-actions .k-button{max-width:100%}.asl-section{padding-block:1.3rem}.asl-hero h1{font-size:2rem}}@media(prefers-reduced-motion:reduce){.asl *{scroll-behavior:auto!important;transition:none!important}}
</style>
