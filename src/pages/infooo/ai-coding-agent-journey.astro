---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import AICodingAgentJourney from '../../components/infooo/coding/AICodingAgentJourney';
import { infoooWorlds, infoooIdentity } from '../../data/infooo';
import { absoluteUrl, breadcrumbSchema } from '../../utils/seo';
import { url } from '../../utils/url';
const world = infoooWorlds.find(item => item.id === 'world-004')!;
const context = { site: Astro.site!, base: import.meta.env.BASE_URL };
const canonical = absoluteUrl(`/infooo/${world.slug}`, context);
const related = infoooWorlds.filter(item => world.relatedWorlds?.includes(item.id) && item.status === 'published' && item.visibility === 'public');
---
<BaseLayout title={`${world.title} — How Coding Agents Work | Khizooology`} description={world.description} canonical={canonical} accentColor={infoooIdentity.color} accentColorLight={infoooIdentity.colorLight} ogImage={world.hero!.asset} ogImageAlt={world.preview!.alt} socialTitle={world.title} socialDescription={world.description} jsonLd={[
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: world.title, applicationCategory: 'EducationalApplication', operatingSystem: 'Any', url: canonical, description: world.description, isAccessibleForFree: true },
  { '@context': 'https://schema.org', ...breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Infooo', path: '/infooo' }, { name: world.title, path: `/infooo/${world.slug}` }], context) },
]}>
  <div class="k-container coding-breadcrumb"><Breadcrumb crumbs={[{ label: 'Infooo', href: url('/infooo') }, { label: world.title }]} accentColor={infoooIdentity.color} /></div>
  <AICodingAgentJourney client:load world={world} />
  <section class="coding-context k-container" aria-label="About this simulation"><p>This is a curated browser-only simulation: no AI calls, uploads, repository access or real commands. Concise process summaries, not private reasoning transcripts.</p><nav aria-label="Related knowledge worlds">{related.map(item => <a href={url(`/infooo/${item.slug}`)}>{item.title} — follow the code into production →</a>)}<a href={url('/infooo')}>Explore all Infooo worlds →</a></nav></section>
</BaseLayout>
<style>.coding-breadcrumb{padding-top:1.5rem;max-width:var(--k-container-wide)}.coding-context{max-width:var(--k-container-wide);padding-bottom:3rem}.coding-context h2{font:800 1.4rem Poppins,sans-serif}.coding-context p{max-width:850px;line-height:1.75;color:var(--k-text-muted)}.coding-context nav{display:flex;flex-wrap:wrap;gap:1.5rem;margin-top:1.5rem}.coding-context a{color:var(--k-text);text-decoration:underline;text-underline-offset:4px}</style>
