---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { absoluteUrl } from '../../utils/seo';
const seoContext = { site: Astro.site!, base: import.meta.env.BASE_URL };
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { url } from '../../utils/url';
import ShareResultFoundation from '../../components/toolbox/ShareResultFoundation';
import { humanAtlasEntities, humanAtlasRelationships, humanAtlasLearningSources, followTheBloodGuide } from '../../data/humanAtlasLearning';
import { infoooWorlds } from '../../data/infooo';
const humanAtlasWorld = infoooWorlds.find(world => world.id === 'world-001')!;
const readingSteps = followTheBloodGuide.steps.map((id, index) => ({
  entity: humanAtlasEntities.find(entity => entity.id === id)!,
  connection: humanAtlasRelationships.find(relation => relation.from === id && relation.to === (followTheBloodGuide.steps[index + 1] ?? 'heart')),
}));
---
<BaseLayout title="Human Atlas — Interactive 3D Anatomy Explorer | Infooo · Khizooology" description="Explore an adult male reference anatomy in 3D. Search structures, reveal systems, isolate parts, and learn how they connect." accentColor="#5CCFAF" accentColorLight="#A7F3D0" jsonLd={[{'@context':'https://schema.org','@type':'WebPage',name:'Human Atlas',url:absoluteUrl('/infooo/human-atlas', seoContext)},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:absoluteUrl('/', seoContext)},{'@type':'ListItem',position:2,name:'Infooo',item:absoluteUrl('/infooo', seoContext)},{'@type':'ListItem',position:3,name:'Human Atlas',item:absoluteUrl('/infooo/human-atlas', seoContext)}]}]}>
<div class="atlas-page" data-infooo-world={humanAtlasWorld.slug}><div class="atlas-top k-container"><Breadcrumb crumbs={[{label:'Infooo',href:url('/infooo')},{label:humanAtlasWorld.title}]} accentColor="#5CCFAF" /><div><p>INFOOO · WORLD {String(humanAtlasWorld.worldNumber).padStart(3, '0')}</p><h1>{humanAtlasWorld.title}</h1><span>Find an organ, see where it sits, and follow how the heart and lungs connect.</span><p class="atlas-orientation">Choose <strong>Find a structure</strong> or <strong>Guide me: Follow the Blood</strong> in the viewer. Keyboard search works without precise 3D clicking. <a href="#atlas-reading-guide">Prefer a text route?</a></p></div></div><section class="atlas-stage"><iframe data-human-atlas-viewer title="Human Atlas interactive 3D anatomy explorer" src={url('/infooo/human-atlas-viewer/index.html')} loading="eager" allow="fullscreen" /></section><section class="atlas-copy k-container"><div><h2>Explore a body as connected systems.</h2><p>Search named structures, show or hide systems, isolate a selection, and move from an assembled body to an exploded view. The model is an adult male reference anatomy from BodyParts3D.</p><p>Human Atlas is a simplified educational reference, not medical diagnosis or treatment. Blood flow is explained by the guide, not simulated or measured.</p><details id="atlas-reading-guide"><summary>Follow the Blood without the 3D view</summary><p>Read the same seven stops without operating the 3D viewer. This is a simplified overview, not every vessel.</p><ol>{readingSteps.map(({ entity, connection }) => <li><h3>{entity.title}</h3><p>{entity.knowledge?.shortExplanation} {connection?.explanation}</p></li>)}</ol><a href={humanAtlasLearningSources[0].url} target="_blank" rel="noreferrer">{humanAtlasLearningSources[0].label}</a></details><details><summary>Sources & attribution</summary><p>BodyParts3D, © The Database Center for Life Science licensed under CC Attribution 4.0 International. This adult male reference does not represent all ages, sexes, bodies, or anatomical variation. Geometry was simplified and packed for browser performance by the upstream project.</p><p>Viewer adapted from <a href="https://github.com/ashemag/human-atlas" target="_blank" rel="noreferrer">Human Atlas by ashemag</a> (MIT). Khizooology adds Infooo framing, local asset hosting, and the surrounding page.</p><a href="https://dbarchive.biosciencedbc.jp/en/bodyparts3d/lic.html" target="_blank" rel="noreferrer">BodyParts3D source license</a><a href={url('/infooo/human-atlas-viewer/ATTRIBUTION.txt')}>Full dataset attribution</a><a href={url('/infooo/human-atlas-viewer/LICENSE.txt')}>Viewer MIT notice</a></details></div><div><ShareResultFoundation client:load monster="infooo" contentType="infooo_world" slug="human-atlas" title="Human Atlas" /></div></section></div>
</BaseLayout>
<script>
  import { trackAtlasViewerMessage } from '../../utils/analytics';
  const viewer = document.querySelector<HTMLIFrameElement>('[data-human-atlas-viewer]');
  if (viewer) window.addEventListener('message', event => trackAtlasViewerMessage(event, viewer.contentWindow));
</script>
<style>.atlas-page{background:var(--k-bg)}.atlas-top{padding:1.25rem 1.5rem .8rem}.atlas-top p{margin:.5rem 0 0;color:var(--m-infooo-text);font:800 .72rem Poppins,sans-serif;letter-spacing:.1em}.atlas-top h1{margin:.15rem 0;font:900 clamp(2rem,4vw,3.2rem)/1 Poppins,sans-serif}.atlas-top span{color:var(--k-text-muted)}.atlas-top .atlas-orientation{max-width:65ch;color:var(--k-text-muted);font:400 .85rem/1.6 Mulish,sans-serif;letter-spacing:normal}.atlas-orientation a{color:var(--m-infooo-text);text-decoration:underline}.atlas-copy summary{cursor:pointer;min-height:44px;align-content:center;font-weight:750}.atlas-copy ol{list-style:decimal;padding-inline-start:1.5rem}.atlas-copy li{margin-block:.75rem}.atlas-copy li h3{font-weight:750;font-size:1rem;margin-bottom:.2rem}.atlas-copy li p{margin-top:0}.atlas-stage{height:min(76vh,860px);min-height:560px;border-block:1px solid var(--k-border);background:var(--k-bg-elevated)}iframe{width:100%;height:100%;border:0;display:block}.atlas-copy{display:grid;grid-template-columns:1fr auto;gap:2rem;padding-block:2rem}.atlas-copy h2{font:800 1.4rem Poppins,sans-serif}.atlas-copy p{max-width:760px;color:var(--k-text-muted)}.atlas-copy a{display:block;margin-top:.8rem;color:var(--m-infooo-text);font-weight:800}@media(max-width:700px){.atlas-stage{height:78vh;min-height:520px}.atlas-copy{grid-template-columns:1fr}.atlas-top{padding-inline:1rem}}</style>
