---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { url } from '../../utils/url';
import ShareResultFoundation from '../../components/toolbox/ShareResultFoundation';
import { infoooWorlds } from '../../data/infooo';
import { voiceForMonsterId } from '../../data/monsterVoices';
const humanAtlasWorld = infoooWorlds.find(world => world.id === 'world-001')!;
const infoooVoice = voiceForMonsterId('infooo');
---
<BaseLayout title="Human Atlas — Interactive 3D Anatomy Explorer | Infooo · Khizooology" description="Explore an adult male reference anatomy in 3D. Search structures, reveal systems, isolate parts, and learn how they connect." accentColor="#5CCFAF" accentColorLight="#A7F3D0" jsonLd={[{'@context':'https://schema.org','@type':'WebPage',name:'Human Atlas',url:'https://khizooology.com/infooo/human-atlas'},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://khizooology.com/'},{'@type':'ListItem',position:2,name:'Infooo',item:'https://khizooology.com/infooo'},{'@type':'ListItem',position:3,name:'Human Atlas',item:'https://khizooology.com/infooo/human-atlas'}]}]}>
<div class="atlas-page" data-infooo-world={humanAtlasWorld.slug}><div class="atlas-top k-container"><Breadcrumb crumbs={[{label:'Infooo',href:url('/infooo')},{label:humanAtlasWorld.title}]} accentColor="#5CCFAF" /><div><p>INFOOO · WORLD {String(humanAtlasWorld.worldNumber).padStart(3, '0')}</p><h1>{humanAtlasWorld.title}</h1><span>{infoooVoice.microcopy.discovery}</span></div></div><section class="atlas-stage"><iframe title="Human Atlas interactive 3D anatomy explorer" src={url('/infooo/human-atlas-viewer/index.html')} loading="eager" allow="fullscreen" /></section><section class="atlas-copy k-container"><div><h2>Explore a body as connected systems.</h2><p>Search named structures, show or hide systems, isolate a selection, and move from an assembled body to an exploded view. The model is an adult male reference anatomy from BodyParts3D.</p><p>Human Atlas is for learning and exploration, not medical diagnosis or treatment.</p><details><summary>Sources & attribution</summary><p>BodyParts3D, © The Database Center for Life Science licensed under CC Attribution 4.0 International. This adult male reference does not represent all ages, sexes, bodies, or anatomical variation. Geometry was simplified and packed for browser performance by the upstream project.</p><p>Viewer adapted from <a href="https://github.com/ashemag/human-atlas" target="_blank" rel="noreferrer">Human Atlas by ashemag</a> (MIT). Khizooology adds Infooo framing, local asset hosting, and the surrounding page.</p><a href="https://dbarchive.biosciencedbc.jp/en/bodyparts3d/lic.html" target="_blank" rel="noreferrer">BodyParts3D source license</a><a href={url('/infooo/human-atlas-viewer/ATTRIBUTION.txt')}>Full dataset attribution</a><a href={url('/infooo/human-atlas-viewer/LICENSE.txt')}>Viewer MIT notice</a></details></div><div><ShareResultFoundation client:load monster="infooo" contentType="infooo_world" slug="human-atlas" title="Human Atlas" /></div></section></div>
</BaseLayout>
<style>.atlas-page{background:var(--k-bg)}.atlas-top{padding:1.25rem 1.5rem .8rem}.atlas-top p{margin:.5rem 0 0;color:#278a73;font:800 .72rem Poppins,sans-serif;letter-spacing:.1em}.atlas-top h1{margin:.15rem 0;font:900 clamp(2rem,4vw,3.2rem)/1 Poppins,sans-serif}.atlas-top span{color:var(--k-text-muted)}.atlas-stage{height:min(76vh,860px);min-height:560px;border-block:1px solid var(--k-border);background:var(--k-bg-elevated)}iframe{width:100%;height:100%;border:0;display:block}.atlas-copy{display:grid;grid-template-columns:1fr auto;gap:2rem;padding-block:2rem}.atlas-copy h2{font:800 1.4rem Poppins,sans-serif}.atlas-copy p{max-width:760px;color:var(--k-text-muted)}.atlas-copy a{display:block;margin-top:.8rem;color:#278a73;font-weight:800}@media(max-width:700px){.atlas-stage{height:78vh;min-height:520px}.atlas-copy{grid-template-columns:1fr}.atlas-top{padding-inline:1rem}}</style>
