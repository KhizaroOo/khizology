---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { absoluteUrl } from '../../utils/seo';
const seoContext = { site: Astro.site!, base: import.meta.env.BASE_URL };
import { url, img } from '../../utils/url';
import { voiceForMonsterId } from '../../data/monsterVoices';
import { infoooCategories, infoooWorlds } from '../../data/infooo';

const worlds = infoooWorlds.filter(world => world.status === 'published' && world.visibility === 'public');

const infoooVoice = voiceForMonsterId('infooo');
---
<BaseLayout title="Infooo — Interactive Knowledge Worlds | Khizooology" description="See it. Touch it. Understand it. Explore interactive knowledge worlds by Khizooology." accentColor="#5CCFAF" accentColorLight="#A7F3D0" jsonLd={[{'@context':'https://schema.org','@type':'CollectionPage',name:'Infooo',url:absoluteUrl('/infooo', seoContext)},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:absoluteUrl('/', seoContext)},{'@type':'ListItem',position:2,name:'Infooo',item:absoluteUrl('/infooo', seoContext)}]}]}>
  <div class="infooo k-container">
    <section class="infooo-hero" aria-labelledby="infooo-title">
      <div class="hero-copy">
        <img class="mascot" src={img('/images/Monsters/infooo.png')} alt="Infooo" width="80" height="80" />
        <p class="eyebrow">INFOOO · INTERACTIVE KNOWLEDGE WORLDS</p>
        <h1 id="infooo-title">See it. Touch it.<br />Understand it.</h1>
        <p class="lead">{infoooVoice.microcopy.intro}</p>
        <p class="infooo-voice">{infoooVoice.microcopy.discovery}</p>
      </div>
      <p class="hero-stats"><strong>{worlds.length}</strong> Worlds <span>·</span> <strong>{infoooCategories.length}</strong> Categories</p>
    </section>
    <section class="worlds-section" aria-labelledby="worlds-title">
      <div class="worlds-heading"><h2 id="worlds-title">Explore Worlds</h2><p>{worlds.length} interactive {worlds.length === 1 ? 'world' : 'worlds'}</p></div>
      <div class="category-filters" role="group" aria-label="Filter worlds by category" hidden>
        <button type="button" class="k-button k-button--secondary" data-category="all" aria-pressed="true">All</button>
        {infoooCategories.map(category => <button type="button" class="k-button k-button--secondary" data-category={category.id} aria-pressed="false">{category.label}</button>)}
      </div>
      <div class="world-links">
        {worlds.map(world => <a class="world-card" href={url(`/infooo/${world.slug}`)} data-world-category={world.category}>
          <div class="world-preview">

            {world.preview ? <img src={img(world.preview.asset)} alt={world.preview.alt} width="600" height="360" loading="lazy" /> : <span class="preview-fallback" aria-hidden="true">{String(world.worldNumber).padStart(3, '0')}</span>}
          </div>
          <div class="world-content">
            <span class="world-category">WORLD {String(world.worldNumber).padStart(3, '0')} · {infoooCategories.find(category => category.id === world.category)!.label}</span>
            <h3>{world.title}</h3>
            <p class="world-description">{world.tagline || world.keyInsight || world.description}</p>
            <span class="world-cta">Explore World <span aria-hidden="true">→</span></span>
          </div>
        </a>)}
      </div>
      <p class="filter-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </section>
  </div>
</BaseLayout>
<script>
  const filters = document.querySelector<HTMLElement>('.category-filters');
  const cards = [...document.querySelectorAll<HTMLAnchorElement>('[data-world-category]')];
  const status = document.querySelector<HTMLElement>('.filter-status');
  if (filters && status) {
    filters.hidden = false;
    filters.addEventListener('click', event => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-category]');
      if (!button) return;
      const category = button.dataset.category;
      filters.querySelectorAll('button').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      cards.forEach(card => { card.hidden = category !== 'all' && card.dataset.worldCategory !== category; });
      const count = cards.filter(card => !card.hidden).length;
      status.textContent = count ? `${count} ${count === 1 ? 'world' : 'worlds'} shown.` : 'More worlds are coming to this category.';
    });
  }
</script>
<style>
.infooo{max-width:var(--k-container-wide);padding-block:2rem 3rem}.infooo-hero{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding-bottom:2rem}.hero-copy{display:grid;grid-template-columns:72px minmax(0,1fr);column-gap:1.25rem;align-items:center}.mascot{grid-column:1;grid-row:1/5;width:72px;height:72px;object-fit:contain}.hero-copy>:not(.mascot){grid-column:2}.eyebrow{font:800 .65rem Poppins,sans-serif;letter-spacing:.1em;margin:0 0 .5rem}h1{font:900 clamp(1.8rem,3vw,2.8rem)/1.1 Poppins,sans-serif;letter-spacing:-.04em;margin:0}.lead{margin:.75rem 0 0;color:var(--k-text-muted)}.infooo-voice{font-size:.85rem;color:var(--k-text-muted);margin:.3rem 0 0}.hero-stats{flex-shrink:0;font-size:.85rem;color:var(--k-text-muted)}.hero-stats strong{color:var(--k-text);font-size:1.3rem}.hero-stats span{margin:0 .5rem}.worlds-section{border-top:1px solid var(--k-border);padding-top:1.5rem}.worlds-heading{display:flex;align-items:baseline;justify-content:space-between;gap:1rem}h2{font:800 1.5rem Poppins,sans-serif;margin:0}.worlds-heading p{color:var(--k-text-muted);font-size:.85rem;margin:0}.category-filters{display:flex;flex-wrap:wrap;gap:.6rem;padding:.5rem 0;margin:1rem 0}.category-filters button{flex-shrink:0;min-height:44px}.category-filters[hidden],.world-card[hidden]{display:none}.world-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}.world-card{display:flex;flex-direction:column;min-width:0;border:1px solid var(--k-border);border-radius:.85rem;overflow:hidden;background:var(--k-bg-card);color:var(--k-text);text-decoration:none;transition:border-color .18s}.world-preview{height:145px;background:#eaf4ef;overflow:hidden}.world-preview img{display:block;width:100%;height:100%;object-fit:contain;padding:.4rem}.world-content{display:flex;flex-direction:column;padding:.85rem 1rem;gap:.35rem;flex:1}.world-category{font:700 .6rem Poppins,sans-serif;letter-spacing:.05em;color:var(--k-text-muted)}h3{font:800 1.05rem/1.3 Poppins,sans-serif;margin:0;min-height:2.6em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.world-description{font-size:.8rem;line-height:1.5;color:var(--k-text-muted);margin:0;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}.world-cta{font-size:.75rem;font-weight:800;margin-top:.25rem}.world-card:hover{border-color:var(--m-infooo)}.infooo a:focus-visible,.category-filters button:focus-visible{outline:3px solid var(--k-text);outline-offset:4px}.filter-status{font-size:.85rem;min-height:1.5em;color:var(--k-text-muted)}@media(max-width:1100px){.world-links{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-stats{display:none}}@media(max-width:600px){.infooo{padding-top:1.25rem}.world-links{grid-template-columns:1fr}.hero-copy{grid-template-columns:48px minmax(0,1fr);gap:.5rem .75rem}.mascot{width:48px;height:48px}.eyebrow{font-size:.55rem}.infooo-hero{padding-bottom:1.5rem}.category-filters{flex-wrap:nowrap;overflow:auto;padding-bottom:.75rem}.worlds-heading{align-items:start;flex-direction:column;gap:.3rem}}@media(prefers-reduced-motion:reduce){.world-card{transition:none}}
</style>
