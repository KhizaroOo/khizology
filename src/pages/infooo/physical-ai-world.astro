---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import PhysicalAIWorld from '../../components/infooo/physical/PhysicalAIWorld';
import {infoooWorlds,infoooIdentity} from '../../data/infooo';
import {absoluteUrl,breadcrumbSchema} from '../../utils/seo';
import {url} from '../../utils/url';
const world=infoooWorlds.find(w=>w.id==='world-005')!;
const context={site:Astro.site!,base:import.meta.env.BASE_URL};
const canonical=absoluteUrl(`/infooo/${world.slug}`,context);
const related=infoooWorlds.filter(w=>world.relatedWorlds?.includes(w.id)&&w.status==='published'&&w.visibility==='public');
---
<BaseLayout title="Physical AI World — Sense, Predict, Act | Khizooology" description={world.description} canonical={canonical} accentColor={infoooIdentity.color} accentColorLight={infoooIdentity.colorLight} ogImage={world.hero!.asset} ogImageAlt={world.preview!.alt} socialTitle={world.title} socialDescription={world.description} jsonLd={[
{'@context':'https://schema.org','@type':'WebApplication',name:world.title,description:world.description,url:canonical,applicationCategory:'EducationalApplication',operatingSystem:'Any',isAccessibleForFree:true},
breadcrumbSchema([{name:'Home',path:'/'},{name:'Infooo',path:'/infooo'},{name:world.title,path:`/infooo/${world.slug}`}],context)]}>
<div class="k-container physical-breadcrumb"><Breadcrumb crumbs={[{label:'Infooo',href:url('/infooo')},{label:world.title}]} accentColor={infoooIdentity.color}/></div>
<PhysicalAIWorld client:load world={world}/>
<section class="k-container physical-context" aria-label="About Physical AI World">
<h2>Intelligence is a loop with reality.</h2><p>Physical AI, also called embodied AI, connects perception to action in a physical environment. Sensors provide partial observations. Sensor fusion and memory support an estimated state. A world model can predict possible consequences; a planner proposes actions, a safety layer can veto them, and a controller uses feedback to guide actuators.</p>
<p>Move the warehouse obstacle, hide or move the crate, disable sensors and compare reality with the robot’s belief. Inspect possible futures, then test what happens when a human enters, memory goes stale or the floor breaks the motion prediction. Keyboard-accessible buttons provide every environment change.</p>
<p>Use Learn to compare modular and VLA-style architectures, edge and cloud computation, simulation, training and the sim-to-real gap. This educational simulation uses no AI service, camera access or robot connection.</p>
<p>{world.knowledge!.limitations}</p><nav aria-label="Related knowledge worlds">{related.map(w=><a href={url(`/infooo/${w.slug}`)}>{w.title} →</a>)}<a href={url('/infooo')}>Explore all Infooo worlds →</a></nav>
</section>
</BaseLayout>
<style>.physical-breadcrumb{padding-top:1.5rem}.physical-context{padding-bottom:3rem}.physical-context p{max-width:78ch;line-height:1.75;color:var(--k-text-muted)}.physical-context h2{font:800 1.5rem Poppins,sans-serif}.physical-context nav{display:flex;flex-wrap:wrap;gap:1.5rem}.physical-context a{color:var(--k-text);text-decoration:underline;text-underline-offset:4px}</style>
