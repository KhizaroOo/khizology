---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import NotoooSheet from '../components/notooo/NotoooSheet.astro';
import { notoooIdentity, publishedNotoooBooks } from '../data/notooo';
import { url } from '../utils/url';
import { breadcrumbSchema, pageId } from '../utils/seo';
const context = { site: Astro.site!, base: import.meta.env.BASE_URL };
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': pageId('/notooo', context), name: 'Notooo', description: 'One-page visual book syntheses curated by khizooo.' }, breadcrumbSchema([{ name: 'Notooo', path: '/notooo' }], context)];
---
<BaseLayout title="Notooo — One Book, One Page" description="One-page visual book syntheses curated by khizooo." accentColor="#E38D7C" accentColorLight="#FED7AA" jsonLd={jsonLd}><section class="k-section"><div class="k-container"><Breadcrumb crumbs={[{label:'Notooo'}]} accentColor="#E38D7C"/><p class="eyebrow">NOTOOO · {publishedNotoooBooks.length} PAGE</p><h1>{notoooIdentity.tagline}</h1><p class="lead">{notoooIdentity.supportingLine}</p><div class="grid">{publishedNotoooBooks.map(book=><a href={url(`/notooo/${book.slug}`)}><NotoooSheet book={book} compact /><div><b>{String(book.number).padStart(3, '0')} · {book.category}</b><h2>{book.title}</h2><span>{book.author}</span><strong>Open Notooo →</strong></div></a>)}</div></div></section></BaseLayout><style>.eyebrow,.grid b{color:#c36c5c;font:800 .72rem Poppins,sans-serif;letter-spacing:.1em}.lead{color:var(--k-text-muted)}h1{font:900 clamp(2rem,5vw,3.5rem) Poppins,sans-serif;margin:.4rem 0}.grid{display:grid;grid-template-columns:minmax(0,360px);gap:1rem;margin-top:2rem}.grid a{overflow:hidden;border:1px solid var(--k-border);border-radius:1rem;background:var(--k-bg-card);color:var(--k-text);text-decoration:none}.grid a>div{padding:1rem}.grid h2{margin:.25rem 0;font:800 1.2rem Poppins,sans-serif}.grid span{color:var(--k-text-muted)}.grid strong{display:block;margin-top:.7rem;color:#c36c5c}</style>
