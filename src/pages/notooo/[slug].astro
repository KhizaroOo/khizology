---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import NotoooSheet from '../../components/notooo/NotoooSheet.astro';
import { notoooIdentity, publishedNotoooBooks, relatedNotoooBooks, type NotoooBook } from '../../data/notooo';
import { url } from '../../utils/url';
import { SITE } from '../../data/site';
import { breadcrumbSchema, pageId, personReference } from '../../utils/seo';

export function getStaticPaths() {
  return publishedNotoooBooks.map((book) => ({ params: { slug: book.slug }, props: { book } }));
}

const { book } = Astro.props as { book: NotoooBook };
const context = { site: Astro.site!, base: import.meta.env.BASE_URL };
const number = String(book.number).padStart(3, '0');
const downloadFilename = `notooo-${number}-${book.slug}-khizooology.png`;
const relatedBooks = relatedNotoooBooks(book);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    '@id': pageId(`/notooo/${book.slug}`, context),
    description: book.shortDescription,
    name: `${book.title} in One Page`,
    author: personReference(context),
    about: {
      '@type': 'Book',
      name: book.title,
      author: { '@type': 'Person', name: book.author },
      ...(book.bookPublicationDate && { datePublished: book.bookPublicationDate }),
      ...(book.publisher && { publisher: { '@type': 'Organization', name: book.publisher } }),
    },
    datePublished: book.publishedAt,
    ...(book.updatedAt && { dateModified: book.updatedAt }),
  },
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Notooo', path: '/notooo' }, { name: book.title, path: `/notooo/${book.slug}` }], context),
];
---

<BaseLayout
  title={book.seoTitle || `${book.title} in One Page | Notooo`}
  description={book.shortDescription}
  ogImage="/images/site/khizooology-social.png"
  ogImageAlt={SITE.ogImageAlt}
  ogType="article"
  publishedAt={book.publishedAt}
  updatedAt={book.updatedAt}
  articleTags={book.tags}
  accentColor={notoooIdentity.color}
  accentColorLight={notoooIdentity.colorLight}
  jsonLd={jsonLd}
>
  <section class="k-section notooo-detail" style={`--notooo-color:${notoooIdentity.color};--notooo-color-light:${notoooIdentity.colorLight};`}>
    <div class="k-container detail">
      <Breadcrumb crumbs={[{ label: 'Notooo', href: url('/notooo') }, { label: book.title }]} accentColor={notoooIdentity.color} />

      <div class="artifact-frame" data-notooo-artifact-frame>
        <NotoooSheet book={book} headingLevel={1} />
        <button class="fullscreen-close" type="button" data-exit-fullscreen aria-label="Exit fullscreen knowledge page">Exit fullscreen</button>
      </div>

      <div class="actions" aria-label="Knowledge page actions">
        <button type="button" data-fullscreen>View Fullscreen</button>
        <button type="button" data-download data-filename={downloadFilename}>Download Page</button>
        <p class="export-status" data-export-status role="status" aria-live="polite"></p>
      </div>

      <div class="copy">
        <h2>Why this book matters</h2>
        <p>{book.whyItMatters}</p>
        <h2>About this Notooo</h2>
        <p>{book.aboutThisNotooo}</p>
        <p class="disclosure">{notoooIdentity.disclosure}<br />{notoooIdentity.notReplacementNotice}</p>
      </div>

      {relatedBooks.length > 0 && <aside class="related-notes" aria-labelledby="related-notes-title">
        <p class="related-label">CONTINUE</p>
        <h2 id="related-notes-title">Related Notooo notes</h2>
        <ul>
          {relatedBooks.map((related) => <li><a href={url(`/notooo/${related.slug}`)}>{related.title}<span>{related.author}</span></a></li>)}
        </ul>
      </aside>}
    </div>
  </section>
</BaseLayout>

<script>
  const frame = document.querySelector<HTMLElement>('[data-notooo-artifact-frame]');
  const sheet = document.querySelector<HTMLElement>('[data-notooo-sheet]');
  const fullscreenButton = document.querySelector<HTMLButtonElement>('[data-fullscreen]');
  const exitFullscreenButton = document.querySelector<HTMLButtonElement>('[data-exit-fullscreen]');
  const downloadButton = document.querySelector<HTMLButtonElement>('[data-download]');
  const exportStatus = document.querySelector<HTMLElement>('[data-export-status]');

  fullscreenButton?.addEventListener('click', async () => {
    try { await frame?.requestFullscreen(); } catch { exportStatus && (exportStatus.textContent = 'Fullscreen is unavailable in this browser.'); }
  });
  exitFullscreenButton?.addEventListener('click', () => document.exitFullscreen());

  downloadButton?.addEventListener('click', async () => {
    if (!sheet || !downloadButton) return;
    downloadButton.disabled = true;
    exportStatus && (exportStatus.textContent = 'Preparing PNG…');

    try {
      const { downloadNotoooPng } = await import('../../utils/notoooExport');
      await downloadNotoooPng(sheet, downloadButton.dataset.filename || 'notooo-page-khizooology.png');
      exportStatus && (exportStatus.textContent = 'PNG downloaded.');
    } catch {
      exportStatus && (exportStatus.textContent = 'Could not prepare the PNG. Please try again.');
    } finally {
      downloadButton.disabled = false;
    }
  });
</script>

<style>
  .notooo-detail { background: #fff; color: #171717; }
  .detail { max-width: 1240px; }
  .artifact-frame { position: relative; margin: auto; }
  .fullscreen-close { display: none; }
  .actions { display: flex; justify-content: center; align-items: center; gap: .5rem; flex-wrap: wrap; margin: 1rem auto .35rem; }
  .actions button { min-height: 42px; border: 1px solid #cfcfcf; border-radius: .35rem; background: #fff; color: #171717; padding: .5rem .8rem; font: 800 .75rem Poppins, sans-serif; cursor: pointer; transition: border-color .2s ease, color .2s ease; }
  .actions button:hover:not(:disabled) { border-color: var(--notooo-color); color: #9e5346; }
  .actions button:focus-visible, .fullscreen-close:focus-visible { outline: 3px solid var(--notooo-color-light); outline-offset: 3px; }
  .actions button:disabled { cursor: wait; opacity: .65; }
  .export-status { flex-basis: 100%; min-height: 1.25rem; margin: 0; color: var(--k-text-muted); text-align: center; font-size: .82rem; }
  .copy { max-width: 820px; margin: 2rem auto 0; color: #505050; line-height: 1.75; }
  .copy h2 { margin: 1.5rem 0 .35rem; color: #171717; font: 800 1.08rem Poppins, sans-serif; }
  .copy p { margin: 0; }
  .disclosure { margin-top: 1.35rem !important; border-top: 1px solid #dedede; padding-top: .9rem; font-size: .87rem; }
  .related-notes { max-width: 820px; margin: 2rem auto 0; border-top: 1px solid #dedede; padding-top: 1rem; }
  .related-label { margin: 0 0 .24rem; color: #6a625f; font: 800 .65rem Poppins, sans-serif; letter-spacing: .1em; }
  .related-notes h2 { margin: 0 0 .7rem; font: 800 1.08rem Poppins, sans-serif; }
  .related-notes ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: .6rem; margin: 0; padding: 0; list-style: none; }
  .related-notes a { display: block; border: 1px solid #dedede; border-radius: .5rem; padding: .75rem; color: #171717; font: 800 .86rem Poppins, sans-serif; text-decoration: none; }
  .related-notes a:hover { border-color: var(--notooo-color); } .related-notes a:focus-visible { outline: 3px solid var(--notooo-color-light); outline-offset: 2px; }
  .related-notes span { display: block; margin-top: .18rem; color: #5f5f5f; font: 400 .8rem/1.4 system-ui, sans-serif; }
  .artifact-frame:fullscreen { box-sizing: border-box; display: grid; min-height: 100vh; place-items: center; overflow: auto; padding: 2rem 4.5rem; background: #fff; }
  .artifact-frame:fullscreen .fullscreen-close { position: fixed; top: 1rem; right: 1rem; display: inline-flex; min-height: 40px; align-items: center; border: 1px solid #bdbdbd; border-radius: .35rem; background: #fff; color: #171717; padding: .45rem .7rem; font: 800 .72rem Poppins, sans-serif; cursor: pointer; }
  @media (max-width: 720px) { .notooo-detail { padding-block: 2rem; } .actions { justify-content: stretch; gap: .5rem; } .actions button { flex: 1 1 145px; } .artifact-frame:fullscreen { padding: 3.8rem .5rem 1rem; align-items: start; } }
</style>
