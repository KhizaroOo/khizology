---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import NotoooSheet from '../../components/notooo/NotoooSheet.astro';
import { notoooIdentity, publishedNotoooBooks, type NotoooBook } from '../../data/notooo';
import { url } from '../../utils/url';
import { breadcrumbSchema, pageId, personReference } from '../../utils/seo';

export function getStaticPaths() {
  return publishedNotoooBooks.map((book) => ({ params: { slug: book.slug }, props: { book } }));
}

const { book } = Astro.props as { book: NotoooBook };
const context = { site: Astro.site!, base: import.meta.env.BASE_URL };
const number = String(book.number).padStart(3, '0');
const downloadFilename = `notooo-${number}-${book.slug}-khizooology.png`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    '@id': pageId(`/notooo/${book.slug}`, context),
    name: `${book.title} in One Page`,
    author: personReference(context),
    about: {
      '@type': 'Book',
      name: book.title,
      author: { '@type': 'Person', name: book.author },
      datePublished: '2018-10-16',
      publisher: { '@type': 'Organization', name: 'Avery' },
    },
    datePublished: book.publishedAt,
  },
  breadcrumbSchema([{ name: 'Notooo', path: '/notooo' }, { name: book.title, path: `/notooo/${book.slug}` }], context),
];
---

<BaseLayout
  title={`${book.title} in One Page | Notooo`}
  description={book.shortDescription}
  ogImage="/images/site/khizooology-social.png"
  ogImageAlt={book.alt}
  ogType="article"
  publishedAt={book.publishedAt}
  articleTags={book.tags}
  accentColor={notoooIdentity.color}
  accentColorLight={notoooIdentity.colorLight}
  jsonLd={jsonLd}
>
  <section class="k-section notooo-detail" style={`--notooo-color:${notoooIdentity.color};--notooo-color-light:${notoooIdentity.colorLight};`}>
    <div class="k-container detail">
      <Breadcrumb crumbs={[{ label: 'Notooo', href: url('/notooo') }, { label: book.title }]} accentColor={notoooIdentity.color} />
      <header class="book-context">
        <p class="eyebrow">NOTOOO {number} · {book.category.toUpperCase()}</p>
        <h1>{book.title}</h1>
        <p class="book-meta">{book.author}<span aria-hidden="true">·</span>{book.publicationYear}<span aria-hidden="true">·</span>{book.category}</p>
      </header>

      <div class="artifact-frame" data-notooo-artifact-frame>
        <NotoooSheet book={book} />
        <button class="fullscreen-close" type="button" data-exit-fullscreen aria-label="Exit fullscreen knowledge page">Exit fullscreen</button>
      </div>

      <div class="actions" aria-label="Knowledge page actions">
        <button type="button" data-fullscreen>View Fullscreen</button>
        <button type="button" data-download data-filename={downloadFilename}>Download Page</button>
        <button type="button" data-print>Print Page</button>
        <p class="export-status" data-export-status role="status" aria-live="polite"></p>
      </div>

      <div class="copy">
        <h2>Why this book matters</h2>
        <p>{book.whyItMatters}</p>
        <h2>About this Notooo</h2>
        <p>This one-page synthesis focuses on the book’s most useful ideas: identity, systems, the habit loop, the Four Laws of Behavior Change, environment design, starting small, and returning quickly after a miss.</p>
        <p class="disclosure">{notoooIdentity.disclosure}<br />{notoooIdentity.notReplacementNotice}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const frame = document.querySelector<HTMLElement>('[data-notooo-artifact-frame]');
  const sheet = document.querySelector<HTMLElement>('[data-notooo-sheet]');
  const fullscreenButton = document.querySelector<HTMLButtonElement>('[data-fullscreen]');
  const exitFullscreenButton = document.querySelector<HTMLButtonElement>('[data-exit-fullscreen]');
  const downloadButton = document.querySelector<HTMLButtonElement>('[data-download]');
  const printButton = document.querySelector<HTMLButtonElement>('[data-print]');
  const exportStatus = document.querySelector<HTMLElement>('[data-export-status]');

  fullscreenButton?.addEventListener('click', async () => {
    try { await frame?.requestFullscreen(); } catch { exportStatus && (exportStatus.textContent = 'Fullscreen is unavailable in this browser.'); }
  });
  exitFullscreenButton?.addEventListener('click', () => document.exitFullscreen());
  printButton?.addEventListener('click', () => window.print());

  downloadButton?.addEventListener('click', async () => {
    if (!sheet || !downloadButton) return;
    downloadButton.disabled = true;
    exportStatus && (exportStatus.textContent = 'Preparing PNG…');

    try {
      const { downloadNotoooPng } = await import('../../utils/notoooExport');
      await downloadNotoooPng(sheet, downloadButton.dataset.filename || 'notooo-page-khizooology.png');
      exportStatus && (exportStatus.textContent = 'PNG downloaded.');
    } catch {
      exportStatus && (exportStatus.textContent = 'Could not prepare the PNG. Please try again.');
    } finally {
      downloadButton.disabled = false;
    }
  });
</script>

<style>
  .detail { max-width: 1260px; }
  .book-context { margin: .8rem auto 1.4rem; max-width: 1120px; }
  .eyebrow { color: var(--notooo-color); font: 900 .72rem Poppins, sans-serif; letter-spacing: .11em; }
  .book-context h1 { margin: .35rem 0; font: 900 clamp(2.3rem, 6vw, 4.6rem)/.95 Poppins, sans-serif; letter-spacing: -.04em; }
  .book-meta { display: flex; align-items: center; flex-wrap: wrap; gap: .45rem; margin: 0; color: var(--k-text-muted); font-weight: 700; }
  .book-meta span { color: var(--notooo-color); }
  .artifact-frame { position: relative; margin: auto; }
  .fullscreen-close { display: none; }
  .actions { display: flex; justify-content: center; align-items: center; gap: .65rem; flex-wrap: wrap; margin: 1.2rem auto .5rem; }
  .actions button { min-height: 46px; border: 1px solid var(--notooo-color); border-radius: 999px; background: var(--k-bg-card); color: var(--k-text); padding: .6rem 1rem; font: 800 .8rem Poppins, sans-serif; cursor: pointer; transition: transform .2s ease, background .2s ease, color .2s ease; }
  .actions button:hover:not(:disabled) { transform: translateY(-2px); background: var(--notooo-color); color: #fff; }
  .actions button:focus-visible, .fullscreen-close:focus-visible { outline: 3px solid var(--notooo-color-light); outline-offset: 3px; }
  .actions button:disabled { cursor: wait; opacity: .65; }
  .export-status { flex-basis: 100%; min-height: 1.25rem; margin: 0; color: var(--k-text-muted); text-align: center; font-size: .82rem; }
  .copy { max-width: 820px; margin: 2.4rem auto 0; color: var(--k-text-muted); line-height: 1.75; }
  .copy h2 { margin: 1.5rem 0 .35rem; color: var(--k-text); font: 800 1.18rem Poppins, sans-serif; }
  .copy p { margin: 0; }
  .disclosure { margin-top: 1.35rem !important; border-left: 3px solid var(--notooo-color); padding-left: .8rem; font-size: .87rem; }
  .artifact-frame:fullscreen { box-sizing: border-box; display: grid; min-height: 100vh; place-items: center; overflow: auto; padding: 2rem 4.5rem; background: #182127; }
  .artifact-frame:fullscreen .fullscreen-close { position: fixed; top: 1rem; right: 1rem; display: inline-flex; min-height: 44px; align-items: center; border: 1px solid var(--notooo-color); border-radius: 999px; background: #fff; color: #27303a; padding: .55rem .85rem; font: 800 .76rem Poppins, sans-serif; cursor: pointer; }
  @media (max-width: 720px) { .book-context { margin-top: .55rem; } .book-context h1 { font-size: clamp(2.2rem, 13vw, 3.3rem); } .actions { justify-content: stretch; gap: .5rem; } .actions button { flex: 1 1 145px; } .artifact-frame:fullscreen { padding: 3.8rem .5rem 1rem; align-items: start; } }
</style>

<style is:global>
  @media print {
    @page { size: A4 portrait; margin: 0; }
    html, body { width: 210mm; height: 297mm; margin: 0 !important; background: #fff !important; }
    body > header, body > footer, .k-breadcrumb, .book-context, .actions, .copy, #analytics-consent, .scroll-top-btn, #dev-toolbar-root { display: none !important; }
    main, .notooo-detail, .notooo-detail .detail, .notooo-detail .artifact-frame { width: auto !important; max-width: none !important; min-height: 0 !important; margin: 0 !important; padding: 0 !important; background: transparent !important; }
    .notooo-detail .fullscreen-close { display: none !important; }
    .notooo-detail [data-notooo-sheet] { display: grid !important; }
  }
</style>
