---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import NotoooSheet from '../../components/notooo/NotoooSheet.astro';
import { publishedNotoooBooks, type NotoooBook } from '../../data/notooo';
import { url } from '../../utils/url';
import { breadcrumbSchema, pageId, personReference } from '../../utils/seo';
export function getStaticPaths(){return publishedNotoooBooks.map(book=>({params:{slug:book.slug},props:{book}}));}
const {book}=Astro.props as {book:NotoooBook}; const context={site:Astro.site!,base:import.meta.env.BASE_URL};
const jsonLd=[{'@context':'https://schema.org','@type':'CreativeWork','@id':pageId(`/notooo/${book.slug}`,context),name:`${book.title} in One Page`,author:personReference(context),about:{'@type':'Book',name:book.title,author:{'@type':'Person',name:book.author},datePublished:'2018-10-16',publisher:{'@type':'Organization',name:'Avery'}},datePublished:book.publishedAt},breadcrumbSchema([{name:'Notooo',path:'/notooo'},{name:book.title,path:`/notooo/${book.slug}`}],context)];
---
<BaseLayout title="Atomic Habits in One Page | Notooo" description={book.shortDescription} ogImage="/images/site/khizooology-social.png" ogImageAlt={book.alt} ogType="article" publishedAt={book.publishedAt} articleTags={book.tags} accentColor="#E38D7C" accentColorLight="#FED7AA" jsonLd={jsonLd}><section class="k-section"><div class="k-container detail"><Breadcrumb crumbs={[{label:'Notooo',href:url('/notooo')},{label:book.title}]} accentColor="#E38D7C"/><p class="eyebrow">NOTOOO 001 · {book.category.toUpperCase()}</p><h1>{book.title}</h1><p class="author">{book.author} · {book.publicationYear} · Avery</p><NotoooSheet book={book}/><div class="actions"><button type="button" data-fullscreen>View fullscreen</button><button type="button" data-download>Download Page</button><button type="button" onclick="window.print()">Print Page</button></div><div class="copy"><h2>Why this book matters</h2><p>{book.whyItMatters}</p><h2>About this Notooo</h2><p>This one-page synthesis focuses on the book’s most useful ideas: identity, systems, the habit loop, the Four Laws of Behavior Change, environment design, starting small, and returning quickly after a miss.</p><p class="disclosure">A khizooo-curated one-page synthesis created with AI-assisted research. It captures useful ideas, not the complete book.<br/>Notooo is not a replacement for reading the original book.</p></div></div></section></BaseLayout><script>const sheet=document.querySelector('[data-notooo-sheet]');document.querySelector('[data-fullscreen]')?.addEventListener('click',()=>sheet?.requestFullscreen());document.querySelector('[data-download]')?.addEventListener('click',()=>window.print());</script><style>.detail{max-width:950px}.eyebrow{color:#c36c5c;font:800 .72rem Poppins,sans-serif;letter-spacing:.1em}.detail h1{font:900 clamp(2rem,5vw,3.5rem) Poppins,sans-serif;margin:.35rem 0}.author,.copy{color:var(--k-text-muted)}.actions{display:flex;justify-content:center;gap:.6rem;flex-wrap:wrap;margin:1rem}.actions button{min-height:44px;border:1px solid #e38d7c;border-radius:.5rem;background:var(--k-bg-card);padding:.55rem .8rem;font:800 .78rem Poppins,sans-serif;cursor:pointer}.copy{max-width:740px;margin:2rem auto;line-height:1.7}.copy h2{color:var(--k-text);font:800 1.15rem Poppins,sans-serif}.disclosure{font-size:.84rem;border-left:3px solid #e38d7c;padding-left:.75rem}@media print{header,footer,.actions,.copy,.k-breadcrumb{display:none!important}.detail{max-width:none;padding:0!important}}</style>
