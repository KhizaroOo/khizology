---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import FamilyCard from '../components/toolbox/FamilyCard.astro';
import ToolCard from '../components/toolbox/ToolCard.astro';
import { families } from '../data/families';
import { tools, getToolCountByFamily, allTags } from '../data/tools';
import { monsters } from '../data/monsters';
import { url } from '../utils/url';

const ACCENT = '#F7933C';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const activeCount = tools.filter((t) => t.status === 'active').length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'toolooo — Toolbox by khizooo',
  url: 'https://khizarooo.github.io/khizology/toolbox',
  description: 'Small browser-only tools that help you check, simulate, decide, plan and create. Turn invisible problems into visible ones.',
  applicationCategory: 'UtilityApplication',
  isAccessibleForFree: true,
  author: { '@type': 'Person', name: 'Khizar Imtiaz' },
};
---

<BaseLayout
  title="toolooo — Turn Invisible Problems Into Visible Ones"
  description="toolooo is a set of small browser-only tools organized around what they DO for you: check, simulate, decide, plan, and create. No signup, no backend, no bullshit."
  accentColor={ACCENT}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="tb-hero">
    <div class="k-container">
      <Breadcrumb crumbs={[{ label: 'toolooo', href: url('/toolbox') }]} accentColor={ACCENT} />
      <div class="tb-hero-inner">
        <div class="tb-hero-badge">
          <img src={`${base}/images/Monsters/toolooo.png`} alt="toolooo" width="40" height="40" class="tb-hero-monster" />
          <span class="k-section-label" style={`color: ${ACCENT}`}>toolooo · Toolbox</span>
        </div>
        <h1 class="tb-hero-title">
          Turn invisible problems<br />
          <span class="tb-hero-accent">into visible ones.</span>
        </h1>
        <p class="tb-hero-lead">
          Small browser tools that help you check, simulate, decide, plan and create.
          Useful, fast, beautiful — no signup, no backend, no bullshit.
        </p>
        <div class="tb-hero-stats">
          <div class="tb-stat"><span class="tb-stat-num">{tools.length}</span><span class="tb-stat-label">Tools Planned</span></div>
          <div class="tb-stat"><span class="tb-stat-num">{activeCount}</span><span class="tb-stat-label">Live Now</span></div>
          <div class="tb-stat"><span class="tb-stat-num">5</span><span class="tb-stat-label">Families</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Families -->
  <section class="k-section tb-families-section" id="families">
    <div class="k-container">
      <div class="tb-section-header">
        <span class="k-section-label" style={`color: ${ACCENT}`}>Five Ways In</span>
        <h2 class="tb-section-title">Every tool answers one of these questions</h2>
        <p class="tb-section-sub">Click a family to filter the tools below.</p>
      </div>
      <div class="tb-families-grid">
        {families.map((f) => (
          <FamilyCard family={f} count={getToolCountByFamily(f.id)} />
        ))}
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section class="k-section tb-tools-section" id="tools">
    <div class="k-container">
      <div class="tb-tools-header">
        <div>
          <span class="k-section-label" style={`color: ${ACCENT}`}>All Tools</span>
          <h2 class="tb-section-title">
            Showing <span id="tb-visible-count">{tools.length}</span> of {tools.length}
          </h2>
        </div>
        <button type="button" id="tb-clear-filters" class="tb-clear-btn" hidden>Clear filters ✕</button>
      </div>

      <div class="tb-tag-row">
        {allTags.map((tag) => (
          <button type="button" class="tb-tag-btn" data-tag-filter={tag}>{tag}</button>
        ))}
      </div>

      <div class="tb-tools-grid">
        {tools.map((tool) => (
          <ToolCard tool={tool} />
        ))}
      </div>
    </div>
  </section>

  <!-- Other monsters -->
  <section class="tb-other-section">
    <div class="k-container">
      <div class="tb-other-inner">
        <p class="tb-other-label">More khizology monsters →</p>
        <div class="tb-other-links">
          {monsters.filter(m => m.status === 'active' && m.id !== 'toolooo').map(m => (
            <a href={url(m.route)} class="tb-other-link" style={`--mc: ${m.color}`}>
              <img src={`${base}${m.image}`} alt={m.name} width="28" height="28" />
              <span>{m.module}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const familyButtons = document.querySelectorAll<HTMLElement>('[data-family-filter]');
  const tagButtons = document.querySelectorAll<HTMLElement>('[data-tag-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-tool-card]');
  const countEl = document.getElementById('tb-visible-count');
  const clearBtn = document.getElementById('tb-clear-filters');

  let activeFamily = 'all';
  let activeTag = 'all';

  function applyFilter() {
    let visible = 0;
    cards.forEach((card) => {
      const family = card.getAttribute('data-family');
      const tags = (card.getAttribute('data-tags') || '').split('|');
      const familyMatch = activeFamily === 'all' || family === activeFamily;
      const tagMatch = activeTag === 'all' || tags.includes(activeTag);
      const show = familyMatch && tagMatch;
      card.hidden = !show;
      if (show) visible++;
    });
    if (countEl) countEl.textContent = String(visible);
    if (clearBtn) clearBtn.hidden = activeFamily === 'all' && activeTag === 'all';
  }

  familyButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-family-filter') || 'all';
      activeFamily = activeFamily === id ? 'all' : id;
      familyButtons.forEach((b) => b.classList.toggle('is-active', b.getAttribute('data-family-filter') === activeFamily));
      applyFilter();
    });
  });

  tagButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-tag-filter') || 'all';
      activeTag = activeTag === tag ? 'all' : tag;
      tagButtons.forEach((b) => b.classList.toggle('is-active', b.getAttribute('data-tag-filter') === activeTag));
      applyFilter();
    });
  });

  clearBtn?.addEventListener('click', () => {
    activeFamily = 'all';
    activeTag = 'all';
    familyButtons.forEach((b) => b.classList.remove('is-active'));
    tagButtons.forEach((b) => b.classList.remove('is-active'));
    applyFilter();
  });
</script>

<style>
  /* Hero */
  .tb-hero { background: var(--k-bg); padding: 3rem 0 2.5rem; border-bottom: 1px solid var(--k-border); }
  .tb-hero-inner { margin-top: 1rem; max-width: 640px; }
  .tb-hero-badge { display: flex; align-items: center; gap: .625rem; margin-bottom: .5rem; }
  .tb-hero-monster { border-radius: .5rem; object-fit: contain; }
  .tb-hero-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 900; line-height: 1.1; color: var(--k-text); margin: .25rem 0 1rem;
  }
  .tb-hero-accent { color: #F7933C; }
  .tb-hero-lead {
    font-size: 1.05rem; color: var(--k-text-muted); line-height: 1.7;
    margin: 0 0 1.5rem;
  }
  .tb-hero-stats { display: flex; gap: 2rem; }
  .tb-stat { display: flex; flex-direction: column; gap: .125rem; }
  .tb-stat-num {
    font-family: 'Poppins', sans-serif; font-size: 1.5rem;
    font-weight: 900; color: #F7933C; line-height: 1;
  }
  .tb-stat-label {
    font-size: .72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .08em; color: var(--k-text-muted);
  }

  /* Section headers */
  .tb-section-header { margin-bottom: 1.75rem; }
  .tb-section-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.375rem, 3vw, 1.875rem); font-weight: 800;
    color: var(--k-text); margin: .25rem 0 .375rem;
  }
  .tb-section-sub { font-size: .875rem; color: var(--k-text-muted); margin: 0; }

  /* Families */
  .tb-families-section { background: var(--k-bg-card); border-top: 1px solid var(--k-border); }
  .tb-families-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.125rem;
  }

  /* Tools */
  .tb-tools-section { background: var(--k-bg); border-top: 1px solid var(--k-border); }
  .tb-tools-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    flex-wrap: wrap; gap: .75rem; margin-bottom: 1.25rem;
  }
  .tb-clear-btn {
    background: transparent; border: 1px solid var(--k-border);
    color: var(--k-text-muted); padding: .4rem .875rem; border-radius: .5rem;
    font-size: .78rem; font-weight: 700; cursor: pointer; font-family: 'Poppins', sans-serif;
  }
  .tb-clear-btn:hover { border-color: #F7933C; color: #F7933C; }

  .tb-tag-row { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.75rem; }
  .tb-tag-btn {
    background: var(--k-bg-card); border: 1px solid var(--k-border);
    color: var(--k-text-muted); padding: .3rem .75rem; border-radius: 999px;
    font-size: .72rem; font-weight: 700; cursor: pointer; font-family: 'Poppins', sans-serif;
    transition: border-color .2s, color .2s, background .2s;
  }
  .tb-tag-btn:hover { border-color: #F7933C; color: #F7933C; }
  .tb-tag-btn.is-active { background: #F7933C; border-color: #F7933C; color: #fff; }

  .tb-tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1.125rem;
  }

  /* Other monsters */
  .tb-other-section {
    background: var(--k-bg-card); border-top: 1px solid var(--k-border); padding: 2rem 0;
  }
  .tb-other-inner {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; justify-content: space-between;
  }
  .tb-other-label { font-size: .8rem; font-weight: 700; color: var(--k-text-muted); }
  .tb-other-links { display: flex; gap: .625rem; flex-wrap: wrap; }
  .tb-other-link {
    display: flex; flex-direction: column; align-items: center; gap: .25rem;
    padding: .625rem; background: var(--k-bg);
    border: 1px solid var(--k-border); border-radius: .75rem;
    text-decoration: none; color: var(--k-text-muted);
    font-size: .7rem; font-weight: 600; min-width: 64px;
    transition: border-color .2s, color .2s;
  }
  .tb-other-link:hover { border-color: var(--mc); color: var(--mc); }
</style>
