---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { absoluteUrl } from '../../utils/seo';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import ComingSoonCard from '../../components/ui/ComingSoonCard.astro';
import ToolHeader from '../../components/toolbox/ToolHeader.astro';
import ToolCard from '../../components/toolbox/ToolCard.astro';
import PrivacyNotice from '../../components/toolbox/PrivacyNotice.astro';
import ToolKnowledge from '../../components/toolbox/ToolKnowledge.astro';
import ToolTruth from '../../components/toolbox/ToolTruth.astro';
import ShareResultFoundation from '../../components/toolbox/ShareResultFoundation';
import ToolWorkspaceTracker from '../../components/toolbox/lv3/ToolWorkspaceTracker';
import ToolLv3Panel from '../../components/toolbox/lv3/ToolLv3Panel';
import ToolFavoriteButton from '../../components/toolbox/lv3/ToolFavoriteButton';
import { tools, getRelatedTools, getTryNextTools } from '../../data/tools';
import { getToolChain } from '../../data/toolChains';
import { getFamilyById } from '../../data/families';
import { getToolSeo } from '../../data/toolSeo';
import { getToolKnowledge } from '../../data/toolKnowledge';
import { getToolTruth } from '../../data/toolTruth';
import { monsters } from '../../data/monsters';
import { url } from '../../utils/url';
import { pageSchema } from '../../utils/schema';

import DateTimeContractDoctor from '../../components/toolbox/tools/DateTimeContractDoctor';
import ReplicaLagSimulator from '../../components/toolbox/tools/ReplicaLagSimulator';
import AsyncMessagingDecisionLab from '../../components/toolbox/tools/AsyncMessagingDecisionLab';
import ZeroDowntimeSchemaChangePlanner from '../../components/toolbox/tools/ZeroDowntimeSchemaChangePlanner';
import ApiChaosPayloadBuilder from '../../components/toolbox/tools/ApiChaosPayloadBuilder';
import BrowserSecurityPolicyDoctor from '../../components/toolbox/tools/BrowserSecurityPolicyDoctor';
import ApiErrorContractBuilder from '../../components/toolbox/tools/ApiErrorContractBuilder';
import PasskeyMigrationPlanner from '../../components/toolbox/tools/PasskeyMigrationPlanner';
import WorkflowAgentDecisionLab from '../../components/toolbox/tools/WorkflowAgentDecisionLab';
import CacheStampedeSimulator from '../../components/toolbox/tools/CacheStampedeSimulator';
import OpenTelemetryTraceDoctor from '../../components/toolbox/tools/OpenTelemetryTraceDoctor';
import McpToolContractBuilder from '../../components/toolbox/tools/McpToolContractBuilder';
import AgentPermissionPlanner from '../../components/toolbox/tools/AgentPermissionPlanner';
import RealTimeTransportDecisionLab from '../../components/toolbox/tools/RealTimeTransportDecisionLab';
import AgentCostLoopSimulator from '../../components/toolbox/tools/AgentCostLoopSimulator';
import McpSecurityDoctor from '../../components/toolbox/tools/McpSecurityDoctor';
import PromptInjectionScanner from '../../components/toolbox/tools/PromptInjectionScanner';
import ContextEngineeringSimulator from '../../components/toolbox/tools/ContextEngineeringSimulator';
import LocalCloudDecisionLab from '../../components/toolbox/tools/LocalCloudDecisionLab';
import AgentMemoryPlanner from '../../components/toolbox/tools/AgentMemoryPlanner';
import BrowserSbomGenerator from '../../components/toolbox/tools/BrowserSbomGenerator';
import CodingAgentInstructionsBuilder from '../../components/toolbox/tools/CodingAgentInstructionsBuilder';
import StructuredOutputJsonSchemaBuilder from '../../components/toolbox/tools/StructuredOutputJsonSchemaBuilder';
import BrowserAiCapabilityChecker from '../../components/toolbox/tools/BrowserAiCapabilityChecker';
import ContentCredentialsWorkflowDoctor from '../../components/toolbox/tools/ContentCredentialsWorkflowDoctor';
import AgentSkillBuilder from '../../components/toolbox/tools/AgentSkillBuilder';
import McpAppUiBuilder from '../../components/toolbox/tools/McpAppUiBuilder';
import X402AgentPaymentSimulator from '../../components/toolbox/tools/X402AgentPaymentSimulator';
import A2aAgentCardBuilder from '../../components/toolbox/tools/A2aAgentCardBuilder';
import SoftwareProvenanceWorkflowBuilder from '../../components/toolbox/tools/SoftwareProvenanceWorkflowBuilder';
import LlmModelRoutingSimulator from '../../components/toolbox/tools/LlmModelRoutingSimulator';
import WebMcpReadinessDoctor from '../../components/toolbox/tools/WebMcpReadinessDoctor';
import PromptCacheEfficiencySimulator from '../../components/toolbox/tools/PromptCacheEfficiencySimulator';
import ProtocolDecisionLab from '../../components/toolbox/tools/ProtocolDecisionLab';
import AiCrawlerPolicyBuilder from '../../components/toolbox/tools/AiCrawlerPolicyBuilder';
import RagChunkingSimulator from '../../components/toolbox/tools/RagChunkingSimulator';
import BrowserEventLoopSimulator from '../../components/toolbox/tools/BrowserEventLoopSimulator';
import ClientStateStorageDecisionLab from '../../components/toolbox/tools/ClientStateStorageDecisionLab';
import WebPerformanceBudgetPlanner from '../../components/toolbox/tools/WebPerformanceBudgetPlanner';
import LlmEvalCaseBuilder from '../../components/toolbox/tools/LlmEvalCaseBuilder';
import FrontendDataExposureDoctor from '../../components/toolbox/tools/FrontendDataExposureDoctor';
import NetworkFailureUxSimulator from '../../components/toolbox/tools/NetworkFailureUxSimulator';
import WebRenderingStrategyDecisionLab from '../../components/toolbox/tools/WebRenderingStrategyDecisionLab';
import AccessibilityRemediationPlanner from '../../components/toolbox/tools/AccessibilityRemediationPlanner';
import UiEdgeStateMatrixBuilder from '../../components/toolbox/tools/UiEdgeStateMatrixBuilder';
import DataContractDriftDoctor from '../../components/toolbox/tools/DataContractDriftDoctor';
import SloIncidentBurnSimulator from '../../components/toolbox/tools/SloIncidentBurnSimulator';
import LlmOutputAssuranceDecisionLab from '../../components/toolbox/tools/LlmOutputAssuranceDecisionLab';
import UxResearchStudyPlanner from '../../components/toolbox/tools/UxResearchStudyPlanner';
import CloudCostGuardrailBuilder from '../../components/toolbox/tools/CloudCostGuardrailBuilder';
import ApiPayloadDoctor from '../../components/toolbox/tools/ApiPayloadDoctor';
import RetryStormSimulator from '../../components/toolbox/tools/RetryStormSimulator';
import DatabaseDecisionLab from '../../components/toolbox/tools/DatabaseDecisionLab';
import StickyNoteFramePlanner from '../../components/toolbox/tools/StickyNoteFramePlanner';
import DrawingGridMaker from '../../components/toolbox/tools/DrawingGridMaker';
import JwtTimeMachine from '../../components/toolbox/tools/JwtTimeMachine';
import CorsDoctor from '../../components/toolbox/tools/CorsDoctor';
import PrintReadyDoctor from '../../components/toolbox/tools/PrintReadyDoctor';
import CacheValueSimulator from '../../components/toolbox/tools/CacheValueSimulator';
import CircuitBreakerPlayground from '../../components/toolbox/tools/CircuitBreakerPlayground';
import NPlusOneQueryVisualizer from '../../components/toolbox/tools/NPlusOneQueryVisualizer';
import RateLimitPlayground from '../../components/toolbox/tools/RateLimitPlayground';
import FanOutLatencySimulator from '../../components/toolbox/tools/FanOutLatencySimulator';
import BuildVsBuy from '../../components/toolbox/tools/BuildVsBuy';
import FrameFitFinder from '../../components/toolbox/tools/FrameFitFinder';
import BleedSafeAreaBuilder from '../../components/toolbox/tools/BleedSafeAreaBuilder';
import TechStackBattle from '../../components/toolbox/tools/TechStackBattle';
import DistributedSystemsTax from '../../components/toolbox/tools/DistributedSystemsTax';
import MonolithVsMicroservicesLab from '../../components/toolbox/tools/MonolithVsMicroservicesLab';
import RestVsGraphqlDecisionLab from '../../components/toolbox/tools/RestVsGraphqlDecisionLab';
import TimeoutChainPlanner from '../../components/toolbox/tools/TimeoutChainPlanner';
import QueueCapacityPlanner from '../../components/toolbox/tools/QueueCapacityPlanner';
import SLAChainVisualizer from '../../components/toolbox/tools/SlaChainVisualizer';
import ConnectionPoolSimulator from '../../components/toolbox/tools/ConnectionPoolSimulator';
import HttpCacheLab from '../../components/toolbox/tools/HttpCacheLab';
import ScopeCreepVisualizer from '../../components/toolbox/tools/ScopeCreepVisualizer';
import PaperNestingPlanner from '../../components/toolbox/tools/PaperNestingPlanner';
import ProjectQuoteRiskPlanner from '../../components/toolbox/tools/ProjectQuoteRiskPlanner';
import RoadmapCollisionDetector from '../../components/toolbox/tools/RoadmapCollisionDetector';
import CropGuardian from '../../components/toolbox/tools/CropGuardian';
import ValueStudyMaker from '../../components/toolbox/tools/ValueStudyMaker';
import PerspectiveGridMaker from '../../components/toolbox/tools/PerspectiveGridMaker';
import SchemaDriftDoctor from '../../components/toolbox/tools/SchemaDriftDoctor';
import EnvironmentDriftDetector from '../../components/toolbox/tools/EnvironmentDriftDetector';
import WebhookDeliverySimulator from '../../components/toolbox/tools/WebhookDeliverySimulator';
import CapacityCliffSimulator from '../../components/toolbox/tools/CapacityCliffSimulator';
import ApiPaginationPlanner from '../../components/toolbox/tools/ApiPaginationPlanner';
import ResponsiveContentFitLab from '../../components/toolbox/tools/ResponsiveContentFitLab';
import MultiFormatCampaignPlanner from '../../components/toolbox/tools/MultiFormatCampaignPlanner';
import AiProjectPricingLab from '../../components/toolbox/tools/AiProjectPricingLab';

export async function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const family = getFamilyById(tool.family)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const seoContext = { site: Astro.site!, base: import.meta.env.BASE_URL };
const seo = getToolSeo(tool, family);

const related = getRelatedTools(tool, 3);
const tryNext = getTryNextTools(tool, 2 + related.length).filter(candidate => !related.some(item => item.slug === candidate.slug)).slice(0, 2);
const knowledge = getToolKnowledge(tool);
const truth = getToolTruth(tool, seo);
const lv3Chains = (tool.lv3?.chainIds || []).map(getToolChain).filter((chain): chain is NonNullable<typeof chain> => Boolean(chain));

const jsonLd = pageSchema({
  type: 'WebPage',
  path: `/toolbox/${tool.slug}`,
  name: seo.title,
  description: seo.description,
  aboutCreator: true,
  extra: tool.status === 'active' ? { mainEntity: {
    '@type': 'WebApplication',
    '@id': `${absoluteUrl(`/toolbox/${tool.slug}`, seoContext)}#application`,
    name: tool.name,
    description: tool.shortDescription,
    url: absoluteUrl(`/toolbox/${tool.slug}`, seoContext),
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
  } } : undefined,
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Toolooo', path: '/toolbox' },
    { name: `${family.name} tools`, path: `/toolbox/family/${family.id}` },
    { name: tool.name, path: `/toolbox/${tool.slug}` },
  ],
}, seoContext);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  accentColor={family.color}
  jsonLd={jsonLd}
>
  <section class="tp-hero">
    <div class="k-container">
      <Breadcrumb
        crumbs={[
          { label: 'toolooo', href: url('/toolbox') },
          { label: family.name, href: url(`/toolbox/family/${family.id}`) },
          { label: tool.name },
        ]}
        accentColor={family.color}
      />
      <div class="tp-hero-inner">
        <ToolHeader tool={tool} />
      </div>
    </div>
  </section>

  <section class="k-section tp-main-section">
    <div class="k-container">
      <div class="tp-layout">
        <div class="tp-main" data-tool-slug={tool.slug} data-tool-family={tool.family} data-feature-level={tool.featureLevel}>
          <ToolWorkspaceTracker client:load toolId={tool.id} />
          {tool.privacySensitive && <PrivacyNotice />}

          {tool.status === 'active' ? (
            <>

              {tool.slug === 'date-time-contract-doctor' && <DateTimeContractDoctor client:load />}
              {tool.slug === 'replica-lag-simulator' && <ReplicaLagSimulator client:load />}
              {tool.slug === 'async-messaging-decision-lab' && <AsyncMessagingDecisionLab client:load />}
              {tool.slug === 'zero-downtime-schema-change-planner' && <ZeroDowntimeSchemaChangePlanner client:load />}
              {tool.slug === 'api-chaos-payload-builder' && <ApiChaosPayloadBuilder client:load />}
              {tool.slug === 'browser-security-policy-doctor' && <BrowserSecurityPolicyDoctor client:load />}
              {tool.slug === 'api-error-contract-builder' && <ApiErrorContractBuilder client:load />}
              {tool.slug === 'passkey-migration-planner' && <PasskeyMigrationPlanner client:load />}
              {tool.slug === 'workflow-agent-decision-lab' && <WorkflowAgentDecisionLab client:load />}
              {tool.slug === 'cache-stampede-simulator' && <CacheStampedeSimulator client:load />}
              {tool.slug === 'opentelemetry-trace-doctor' && <OpenTelemetryTraceDoctor client:load />}
              {tool.slug === 'mcp-tool-contract-builder' && <McpToolContractBuilder client:load />}
              {tool.slug === 'ai-agent-permission-planner' && <AgentPermissionPlanner client:load />}
              {tool.slug === 'real-time-transport-decision-lab' && <RealTimeTransportDecisionLab client:load />}
              {tool.slug === 'ai-agent-cost-loop-simulator' && <AgentCostLoopSimulator client:load />}
              {tool.slug === 'mcp-security-doctor' && <McpSecurityDoctor client:load />}
              {tool.slug === 'ai-prompt-injection-scanner' && <PromptInjectionScanner client:load />}
              {tool.slug === 'context-engineering-simulator' && <ContextEngineeringSimulator client:load />}
              {tool.slug === 'local-ai-vs-cloud-ai-decision-lab' && <LocalCloudDecisionLab client:load />}
              {tool.slug === 'agent-memory-architecture-planner' && <AgentMemoryPlanner client:load />}
              {tool.slug === 'browser-sbom-generator' && <BrowserSbomGenerator toolSlug={tool.slug} client:load />}
              {tool.slug === 'coding-agent-instructions-builder' && <CodingAgentInstructionsBuilder toolSlug={tool.slug} client:load />}
              {tool.slug === 'structured-output-json-schema-builder' && <StructuredOutputJsonSchemaBuilder toolSlug={tool.slug} client:load />}
              {tool.slug === 'browser-ai-capability-checker' && <BrowserAiCapabilityChecker toolSlug={tool.slug} client:load />}
              {tool.slug === 'content-credentials-workflow-doctor' && <ContentCredentialsWorkflowDoctor toolSlug={tool.slug} client:load />}
              {tool.slug === 'agent-skill-skill-md-builder' && <AgentSkillBuilder toolSlug={tool.slug} client:load />}
              {tool.slug === 'mcp-app-ui-builder' && <McpAppUiBuilder toolSlug={tool.slug} client:load />}
              {tool.slug === 'x402-agent-payment-simulator' && <X402AgentPaymentSimulator client:load />}
              {tool.slug === 'a2a-agent-card-builder' && <A2aAgentCardBuilder toolSlug={tool.slug} client:load />}
              {tool.slug === 'software-provenance-workflow-builder' && <SoftwareProvenanceWorkflowBuilder toolSlug={tool.slug} client:load />}
              {tool.slug === 'llm-model-routing-simulator' && <LlmModelRoutingSimulator client:load />}
              {tool.slug === 'webmcp-readiness-doctor' && <WebMcpReadinessDoctor client:load />}
              {tool.slug === 'prompt-cache-efficiency-simulator' && <PromptCacheEfficiencySimulator client:load />}
              {tool.slug === 'mcp-vs-a2a-vs-webmcp-decision-lab' && <ProtocolDecisionLab client:load />}
              {tool.slug === 'ai-crawler-policy-builder' && <AiCrawlerPolicyBuilder toolSlug={tool.slug} client:load />}
              {tool.slug === 'rag-chunking-simulator' && <RagChunkingSimulator client:load />}
              {tool.slug === 'browser-event-loop-simulator' && <BrowserEventLoopSimulator client:load />}
              {tool.slug === 'client-state-storage-decision-lab' && <ClientStateStorageDecisionLab client:load />}
              {tool.slug === 'web-performance-budget-planner' && <WebPerformanceBudgetPlanner client:load />}
              {tool.slug === 'llm-eval-case-builder' && <LlmEvalCaseBuilder client:load />}
              {tool.slug === 'frontend-data-exposure-doctor' && <FrontendDataExposureDoctor client:load />}
              {tool.slug === 'network-failure-ux-simulator' && <NetworkFailureUxSimulator client:load />}
              {tool.slug === 'web-rendering-strategy-decision-lab' && <WebRenderingStrategyDecisionLab client:load />}
              {tool.slug === 'accessibility-remediation-planner' && <AccessibilityRemediationPlanner client:load />}
              {tool.slug === 'ui-edge-state-matrix-builder' && <UiEdgeStateMatrixBuilder client:load />}
              {tool.slug === 'data-contract-drift-doctor' && <DataContractDriftDoctor client:load />}
              {tool.slug === 'slo-incident-burn-simulator' && <SloIncidentBurnSimulator client:load />}
              {tool.slug === 'llm-output-assurance-decision-lab' && <LlmOutputAssuranceDecisionLab client:load />}
              {tool.slug === 'ux-research-study-planner' && <UxResearchStudyPlanner client:load />}
              {tool.slug === 'cloud-cost-guardrail-builder' && <CloudCostGuardrailBuilder client:load />}
              {tool.slug === 'api-payload-doctor' && <ApiPayloadDoctor client:load />}
              {tool.slug === 'retry-storm-simulator' && <RetryStormSimulator client:load />}
              {tool.slug === 'database-decision-lab' && <DatabaseDecisionLab client:load />}
              {tool.slug === 'sticky-note-frame-planner' && <StickyNoteFramePlanner client:load />}
              {tool.slug === 'drawing-grid-maker' && <DrawingGridMaker client:load />}
              {tool.slug === 'jwt-time-machine' && <JwtTimeMachine client:load />}
              {tool.slug === 'cors-doctor' && <CorsDoctor client:load />}
              {tool.slug === 'print-ready-doctor' && <PrintReadyDoctor client:load />}
              {tool.slug === 'cache-value-simulator' && <CacheValueSimulator client:load />}
              {tool.slug === 'circuit-breaker-playground' && <CircuitBreakerPlayground client:load />}
              {tool.slug === 'n-plus-1-query-visualizer' && <NPlusOneQueryVisualizer client:load />}
              {tool.slug === 'rate-limit-playground' && <RateLimitPlayground client:load />}
              {tool.slug === 'fan-out-latency-simulator' && <FanOutLatencySimulator client:load />}
              {tool.slug === 'build-vs-buy' && <BuildVsBuy client:load />}
              {tool.slug === 'frame-fit-finder' && <FrameFitFinder client:load />}
              {tool.slug === 'bleed-safe-area-builder' && <BleedSafeAreaBuilder client:load />}
              {tool.slug === 'tech-stack-battle' && <TechStackBattle client:load />}
              {tool.slug === 'distributed-systems-tax' && <DistributedSystemsTax client:load />}
              {tool.slug === 'monolith-vs-microservices-lab' && <MonolithVsMicroservicesLab client:load />}
              {tool.slug === 'rest-vs-graphql-decision-lab' && <RestVsGraphqlDecisionLab client:load />}
              {tool.slug === 'timeout-chain-planner' && <TimeoutChainPlanner client:load />}
              {tool.slug === 'queue-capacity-planner' && <QueueCapacityPlanner client:load />}
              {tool.slug === 'sla-chain-visualizer' && <SLAChainVisualizer client:load />}
              {tool.slug === 'connection-pool-simulator' && <ConnectionPoolSimulator client:load />}
              {tool.slug === 'http-cache-lab' && <HttpCacheLab client:load />}
              {tool.slug === 'scope-creep-visualizer' && <ScopeCreepVisualizer client:load />}
              {tool.slug === 'paper-nesting-planner' && <PaperNestingPlanner client:load />}
              {tool.slug === 'project-quote-risk-planner' && <ProjectQuoteRiskPlanner client:load />}
              {tool.slug === 'roadmap-collision-detector' && <RoadmapCollisionDetector client:load />}
              {tool.slug === 'crop-guardian' && <CropGuardian client:load />}
              {tool.slug === 'value-study-maker' && <ValueStudyMaker client:load />}
              {tool.slug === 'perspective-grid-maker' && <PerspectiveGridMaker client:load />}
              {tool.slug === 'schema-drift-doctor' && <SchemaDriftDoctor client:load />}
              {tool.slug === 'environment-drift-detector' && <EnvironmentDriftDetector client:load />}
              {tool.slug === 'webhook-delivery-simulator' && <WebhookDeliverySimulator client:load />}
              {tool.slug === 'capacity-cliff-simulator' && <CapacityCliffSimulator client:load />}
              {tool.slug === 'api-pagination-planner' && <ApiPaginationPlanner client:load />}
              {tool.slug === 'responsive-content-fit-lab' && <ResponsiveContentFitLab client:load />}
              {tool.slug === 'multi-format-campaign-planner' && <MultiFormatCampaignPlanner client:load />}
              {tool.slug === 'ai-project-pricing-lab' && <AiProjectPricingLab client:load />}
            </>
          ) : (
            <ComingSoonCard
              title={`${tool.name} is ${tool.status === 'experimental' ? 'experimental' : 'coming soon'}`}
              description={tool.shortDescription}
              accentColor={family.color}
              icon={tool.icon}
            />
          )}

          {tool.status === 'active' && (
            <details class="tp-depth">
              <summary>What this tool does and why</summary>
              <ToolKnowledge knowledge={knowledge} accent={family.color} variant="intro" />
            </details>
          )}
          {tool.lv3 && (
            <details class="tp-depth">
              <summary>Save this tool and explore next steps</summary>
              <ToolLv3Panel client:load tool={tool} chains={lv3Chains} base={base} />
            </details>
          )}
          {tool.growthPriority && !tool.lv3 && <ToolFavoriteButton client:load toolId={tool.id} toolName={tool.name} />}

          {!tool.lv3 && <ToolKnowledge knowledge={knowledge} accent={family.color} variant="next" nextTools={tryNext} />}
          <ToolTruth truth={truth} />

          <div class="tp-about">
            <h2 class="tp-section-h2">Understand {tool.name}</h2>
            <div class="tp-guide-grid">
              <section>
                <h3>What this tool helps you understand</h3>
                <p>{seo.whatYouLearn}</p>
              </section>
              <section>
                <h3>When to use it</h3>
                <p>{knowledge.whenToUse}</p>
              </section>
              <section data-tool-example>
                <h3>Try a scenario</h3>
                <p>{knowledge.example}</p>
              </section>
              <section>
                <h3>How to read the result</h3>
                <p>{seo.interpretation}</p>
              </section>
              <section>
                <h3>Assumptions and limits</h3>
                <p>{seo.limitations}</p>
              </section>
            </div>
            <p class="tp-guide-links">
              Toolooo is part of <a href={url('/behind-the-vibes')}>Khizooology</a>, created by{' '}
              <a href={url('/my-portfolio')}>Khizar Imtiaz (khizooo)</a>.
            </p>
          </div>
        </div>

        <aside class="tp-sidebar">
          <div class="tp-sidebar-card">
            <h3 class="tp-sidebar-h3">Tool Info</h3>
            <div class="tp-info-rows">
              <div class="tp-info-row"><span class="tp-info-label">Family</span><a class="tp-info-link" href={url(`/toolbox/family/${family.id}`)}>{family.icon} {family.name}</a></div>
              <div class="tp-info-row"><span class="tp-info-label">Price</span><span class="tp-info-val" style="color:#22c55e;font-weight:700">Free</span></div>
              <div class="tp-info-row"><span class="tp-info-label">Login</span><span class="tp-info-val">Not required</span></div>
              <div class="tp-info-row">
                <span class="tp-info-label">Status</span>
                <span class="tp-info-val" style={`color: ${tool.status === 'active' ? '#22c55e' : 'var(--k-text-muted)'}; font-weight:700`}>
                  {tool.status === 'active' ? 'Live ✓' : tool.status === 'planned' ? 'Planned' : 'Experimental'}
                </span>
              </div>
            </div>
          </div>

          {related.length > 0 && (
            <div class="tp-sidebar-card">
              <h3 class="tp-sidebar-h3">Related tools</h3>
              <div class="tp-related-list">
                {related.map((rt) => (
                  <a href={url(`/toolbox/${rt.slug}`)} class="tp-related-item" data-related-content data-related-monster="toolooo" data-related-content-type="tool" data-related-slug={rt.slug}>
                    <span class="tp-related-icon">{rt.icon}</span>
                    <div>
                      <div class="tp-related-name">{rt.name}</div>
                      <div class="tp-related-desc">{rt.shortDescription.slice(0, 55)}…</div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          <ShareResultFoundation client:load monster="toolooo" contentType="tool" slug={tool.slug} title={tool.name} />

          <div class="tp-sidebar-card">
            <h3 class="tp-sidebar-h3">More Khizooology</h3>
            <div class="tp-monsters">
              {monsters.filter((m) => m.status === 'active' && m.id !== 'toolooo').map((m) => (
                <a href={url(m.route)} class="tp-monster-link" style={`--mc: ${m.color}`}>
                  <img src={`${base}${m.image}`} alt={m.name} width="22" height="22" />
                  <span>{m.module}</span>
                </a>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tp-hero { background: var(--k-bg); padding: 1.25rem 0; border-bottom: 1px solid var(--k-border); }
  .tp-hero-inner { margin-top: 1rem; }

  .tp-main-section { background: var(--k-bg); padding-top: 1.25rem; }
  .tp-depth { margin-top: 1.25rem; border: 1px solid var(--k-border); border-radius: .875rem; padding: .875rem 1rem; }
  .tp-depth > summary { cursor: pointer; font-weight: 700; color: var(--k-text); min-height: 28px; }
  .tp-layout { display: grid; grid-template-columns: 1fr; gap: 2rem; }
