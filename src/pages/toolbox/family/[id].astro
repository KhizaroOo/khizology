---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import ToolCard from '../../../components/toolbox/ToolCard.astro';
import { families } from '../../../data/families';
import { getToolsByFamily } from '../../../data/tools';
import { monsters } from '../../../data/monsters';
import { url } from '../../../utils/url';

export async function getStaticPaths() {
  return families.map((family) => ({
    params: { id: family.id },
    props: { family },
  }));
}

const { family } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const familyTools = getToolsByFamily(family.id);
const otherFamilies = families.filter((f) => f.id !== family.id);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${family.name} Tools — toolooo`,
  url: `https://khizarooo.github.io/khizology/toolbox/family/${family.id}`,
  description: family.description,
  isPartOf: {
    '@type': 'WebSite',
    name: 'khizology',
    url: 'https://khizarooo.github.io/khizology/',
  },
};
---

<BaseLayout
  title={`${family.name} Tools — toolooo by khizooo`}
  description={`${familyTools.length} browser-only tools that ${family.question.toLowerCase().replace(/\?$/, '')} — ${family.description}`}
  accentColor={family.color}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="fp-hero" style={`--fc: ${family.color}`}>
    <div class="k-container">
      <Breadcrumb
        crumbs={[
          { label: 'toolooo', href: url('/toolbox') },
          { label: family.name },
        ]}
        accentColor={family.color}
      />
      <div class="fp-hero-inner">
        <div class="fp-hero-icon-wrap">
          <span class="fp-hero-icon">{family.icon}</span>
        </div>
        <div class="fp-hero-text">
          <span class="k-section-label" style={`color: ${family.color}`}>toolooo · {family.name}</span>
          <h1 class="fp-hero-title">{family.name}</h1>
          <p class="fp-hero-question">"{family.question}"</p>
          <p class="fp-hero-desc">{family.description}</p>
          <div class="fp-hero-meta">
            <span>{familyTools.length} tool{familyTools.length === 1 ? '' : 's'}</span>
            <span>·</span>
            <span>All live</span>
            <span>·</span>
            <span>Free, browser-only</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools in this family -->
  <section class="k-section fp-tools-section">
    <div class="k-container">
      <div class="fp-tools-grid">
        {familyTools.map((tool) => (
          <ToolCard tool={tool} />
        ))}
      </div>
    </div>
  </section>

  <!-- Other families -->
  <section class="fp-other-section">
    <div class="k-container">
      <div class="fp-other-inner">
        <p class="fp-other-label">Other ways in</p>
        <div class="fp-other-links">
          {otherFamilies.map((f) => (
            <a href={url(`/toolbox/family/${f.id}`)} class="fp-other-link" style={`--oc: ${f.color}`}>
              <span class="fp-other-icon">{f.icon}</span>
              <span>{f.name}</span>
            </a>
          ))}
          <a href={url('/toolbox')} class="fp-other-link fp-other-all">
            <span class="fp-other-icon">🗂️</span>
            <span>All Tools</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Other monsters -->
  <section class="fp-monsters-section">
    <div class="k-container">
      <div class="fp-monsters-inner">
        <p class="fp-other-label">More khizology monsters →</p>
        <div class="fp-other-links">
          {monsters.filter((m) => m.status === 'active' && m.id !== 'toolooo').map((m) => (
            <a href={url(m.route)} class="fp-other-link" style={`--oc: ${m.color}`}>
              <img src={`${base}${m.image}`} alt={m.name} width="22" height="22" />
              <span>{m.module}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .fp-hero { background: var(--k-bg); padding: 2.5rem 0 2rem; border-bottom: 1px solid var(--k-border); }
  .fp-hero-inner { display: flex; gap: 1.25rem; align-items: flex-start; margin-top: 1rem; flex-wrap: wrap; }
  .fp-hero-icon-wrap {
    width: 72px; height: 72px; border-radius: 1.125rem;
    background: color-mix(in srgb, var(--fc) 15%, transparent);
    border: 2px solid color-mix(in srgb, var(--fc) 30%, transparent);
    display: flex; align-items: center; justify-content: center;
    font-size: 2.25rem; flex-shrink: 0;
  }
  .fp-hero-text { flex: 1; min-width: 260px; }
  .fp-hero-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 900; color: var(--k-text); line-height: 1.1;
    margin: 0.375rem 0 0.625rem;
  }
  .fp-hero-question {
    font-size: 1.05rem; font-style: italic; font-weight: 700;
    color: var(--fc); margin: 0 0 0.75rem;
  }
  .fp-hero-desc {
    font-size: 1rem; color: var(--k-text-muted); line-height: 1.7;
    max-width: 640px; margin: 0 0 0.875rem;
  }
  .fp-hero-meta { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--k-text-muted); flex-wrap: wrap; }

  /* Tools grid */
  .fp-tools-section { background: var(--k-bg); }
  .fp-tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1.125rem;
  }

  /* Other families / monsters strips */
  .fp-other-section, .fp-monsters-section {
    background: var(--k-bg-card); border-top: 1px solid var(--k-border); padding: 1.75rem 0;
  }
  .fp-monsters-section { background: var(--k-bg-elevated); }
  .fp-other-inner, .fp-monsters-inner {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; justify-content: space-between;
  }
  .fp-other-label { font-size: 0.8rem; font-weight: 700; color: var(--k-text-muted); margin: 0; }
  .fp-other-links { display: flex; gap: 0.625rem; flex-wrap: wrap; }
  .fp-other-link {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.875rem; background: var(--k-bg);
    border: 1px solid var(--k-border); border-radius: 0.75rem;
    text-decoration: none; color: var(--k-text-muted);
    font-size: 0.78rem; font-weight: 700; font-family: 'Poppins', sans-serif;
    transition: border-color 0.2s, color 0.2s;
  }
  .fp-other-link:hover { border-color: var(--oc, var(--fc)); color: var(--oc, var(--fc)); }
  .fp-other-link img { border-radius: 0.25rem; object-fit: contain; }
  .fp-other-icon { font-size: 1rem; }
  .fp-other-all { border-style: dashed; }
</style>
